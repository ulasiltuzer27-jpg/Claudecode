{
 "id": "case07",
 "order": 7,
 "premium": true,
 "pack": "case_pack_1",
 "icon": "diya-lamp",
 "title": {
  "tr": "Sahte Antika",
  "en": "The Fake Antique"
 },
 "intro": [
  {
   "icon": "diya-lamp",
   "text": {
    "tr": "Kapalı Çarşı'nın en eski antikacısı Nazım Usta, koleksiyonundaki eşsiz bronz kandilin sahtesiyle değiştirildiğini fark etti.",
    "en": "Nazım, the oldest antique dealer in the Grand Bazaar, has realized that the unique bronze lamp in his collection was swapped for a fake."
   }
  },
  {
   "icon": "balance-scale",
   "text": {
    "tr": "Gerçek kandil bu akşam bir açık artırmada satılacak. Satıştan önce sahtekârı bulmalısın.",
    "en": "The real lamp will be sold at an auction this evening. You have to find the forger before the sale."
   }
  }
 ],
 "suspects": [
  {
   "id": "rifat",
   "icon": "man-white-hair",
   "name": {
    "tr": "Rıfat",
    "en": "Rıfat"
   },
   "role": {
    "tr": "Rakip antikacı",
    "en": "Rival dealer"
   },
   "bio": {
    "tr": "Nazım Usta'yla kırk yıllık rakip. Kandile yıllardır göz koyduğu biliniyor.",
    "en": "Nazım's rival for forty years. Everyone knows he has coveted the lamp for years."
   }
  },
  {
   "id": "seda",
   "icon": "woman-scientist",
   "name": {
    "tr": "Seda",
    "en": "Seda"
   },
   "role": {
    "tr": "Restoratör",
    "en": "Restorer"
   },
   "bio": {
    "tr": "Çarşının en iyi restoratörü. Kandili geçen hafta temizlik için atölyesine götürdü.",
    "en": "The best restorer in the bazaar. She took the lamp to her workshop for cleaning last week."
   }
  },
  {
   "id": "ozan",
   "icon": "man-curly-hair",
   "name": {
    "tr": "Ozan",
    "en": "Ozan"
   },
   "role": {
    "tr": "Çırak",
    "en": "Apprentice"
   },
   "bio": {
    "tr": "Nazım Usta'nın genç çırağı. Dükkânın anahtarı onda da var.",
    "en": "Nazım's young apprentice. He has a key to the shop as well."
   }
  },
  {
   "id": "lale",
   "icon": "woman-in-tuxedo",
   "name": {
    "tr": "Lale",
    "en": "Lale"
   },
   "role": {
    "tr": "Müzayede sahibi",
    "en": "Auctioneer"
   },
   "bio": {
    "tr": "Bu akşamki açık artırmayı o yönetecek. Komisyonu satış fiyatına bağlı.",
    "en": "She runs tonight's auction. Her commission depends on the sale price."
   }
  }
 ],
 "clues": [
  {
   "id": "c1",
   "text": {
    "tr": "Sahte kandil yeni yapılmış ama eskitilmiş; üzerinde çayla yapılmış yapay bir patina var.",
    "en": "The fake lamp is newly made but aged on purpose, with an artificial patina made from tea."
   }
  },
  {
   "id": "c2",
   "text": {
    "tr": "Gerçek kandili en son, pazartesi temizlik için atölyesine götüren Seda gördü.",
    "en": "The last person to see the real lamp was Seda, who took it to her workshop for cleaning on Monday."
   }
  },
  {
   "id": "c3",
   "text": {
    "tr": "Rıfat'ın dükkânı bütün hafta kapalıydı; İzmir'deki bir fuarda olduğu biletlerle doğrulandı.",
    "en": "Rıfat's shop was closed all week; tickets confirm he was at a fair in İzmir."
   }
  },
  {
   "id": "c4",
   "text": {
    "tr": "Çırak Ozan'ın cebinden kandilin fotoğrafları çıktı.",
    "en": "Photos of the lamp were found in apprentice Ozan's pocket."
   }
  },
  {
   "id": "c5",
   "text": {
    "tr": "Ozan, fotoğrafları ustası katalog için istediği için çektiğini söylüyor; katalog taslağı bunu doğruluyor.",
    "en": "Ozan says he took the photos because his master wanted them for a catalogue; the draft catalogue confirms it."
   }
  },
  {
   "id": "c6",
   "text": {
    "tr": "Lale'nin kataloğunda kandil, \"sahibi değişti\" notuyla yer alıyor.",
    "en": "Lale's catalogue lists the lamp with the note \"ownership changed\"."
   }
  },
  {
   "id": "c7",
   "text": {
    "tr": "Lale, notu satıcının isteğiyle yazdığını söylüyor. Satıcı olarak sahte bir isim verilmiş.",
    "en": "Lale says she added the note at the seller's request. The seller gave a false name."
   }
  },
  {
   "id": "c8",
   "text": {
    "tr": "Sahte kandilin içindeki kalıp izleri, Seda'nın atölyesindeki silikon kalıpla birebir aynı.",
    "en": "The mould marks inside the fake lamp match the silicone mould in Seda's workshop exactly."
   }
  },
  {
   "id": "c9",
   "text": {
    "tr": "Sahte ismin yazıldığı satış formundaki el yazısı, Seda'nın restorasyon raporlarındaki yazıyla eşleşiyor.",
    "en": "The handwriting on the sales form with the false name matches the handwriting in Seda's restoration reports."
   }
  },
  {
   "id": "c10",
   "text": {
    "tr": "Seda'nın dolabında, eskitme için kullanılan çay kazanı ve gerçek kandilin kadife kutusu bulundu.",
    "en": "In Seda's cupboard were the tea pot used for ageing and the velvet box of the real lamp."
   }
  }
 ],
