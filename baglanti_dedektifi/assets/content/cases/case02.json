 "title": {
  "tr": "Liman Ekspresi",
  "en": "The Harbor Express"
 },
 "intro": [
  {
   "icon": "locomotive",
   "text": {
    "tr": "Gece yarısı kalkan Liman Ekspresi'nde bir kurye, mikrofilmin ikinci yarısını taşıyor.",
    "en": "On the midnight Harbor Express, a courier is carrying the second half of the microfilm."
   }
  },
  {
   "icon": "hot-beverage",
   "text": {
    "tr": "Kurye yemekli vagonda çayını içtikten sonra derin bir uykuya daldı. Uyandığında çantası boştu.",
    "en": "After drinking his tea in the dining car, the courier fell into a deep sleep. When he woke, his case was empty."
   }
  },
  {
   "icon": "ticket",
   "text": {
    "tr": "Tren bir sonraki istasyona kadar durmayacak. Hırsız hâlâ vagonların birinde.",
    "en": "The train will not stop until the next station. The thief is still somewhere on board."
   }
  }
 ],
 "suspects": [
  {
