   },
   "role": {
    "tr": "Kumarbaz",
    "en": "Gambler"
   },
   "bio": {
    "tr": "Bütün gece yemekli vagonda kâğıt oynadı. Borçları kabarık.",
    "en": "He played cards in the dining car all night. He is deep in debt."
   }
  }
 ],
 "clues": [
  {
   "id": "c1",
   "text": {
    "tr": "Kuryenin çayına güçlü bir uyku ilacı katılmış.",
    "en": "A strong sleeping drug was slipped into the courier's tea."
   }
  },
  {
   "id": "c2",
   "text": {
    "tr": "Çay 23.40'ta servis edildi; kurye 23.55'te uyuyordu.",
    "en": "The tea was served at 11:40 pm; by 11:55 the courier was asleep."
   }
  },
  {
   "id": "c3",
   "text": {
    "tr": "Defne'nin fotoğraflarının hepsi 23.30 ile 00.30 arasında arka vagonda çekilmiş; saat damgaları hiç kesilmiyor.",
    "en": "All of Defne's photos were taken in the rear car between 11:30 pm and 12:30 am; the timestamps never break."
   }
  },
  {
   "id": "c4",
   "text": {
    "tr": "Doktor Kemal'in ilaç çantasından bir şişe eksik.",
    "en": "A vial is missing from Doctor Kemal's medical bag."
   }
  },
  {
   "id": "c5",
   "text": {
    "tr": "Tolga'nın büyük bir kumar borcu var ve alacaklıları da bu trende.",
    "en": "Tolga owes a huge gambling debt, and his creditors are on this train."
   }
  },
  {
   "id": "c6",
   "text": {
    "tr": "Kondüktör Hasan'ın anahtarı 00.10'da kuryenin kompartımanını açmış.",
    "en": "Conductor Hasan's key opened the courier's compartment at 12:10 am."
   }
  },
  {
   "id": "c7",
   "text": {
    "tr": "Hasan, kuryeyi baygın bulup kapıyı açtığını ve hemen yardım çağırdığını söylüyor. Makinist bunu doğruluyor.",
    "en": "Hasan says he found the courier unconscious, opened the door and called for help at once. The engineer confirms it."
   }
  },
  {
   "id": "c8",
   "text": {
    "tr": "Tolga bütün gece kâğıt masasından kalkmadı; beş oyuncu buna tanık.",
    "en": "Tolga never left the card table all night; five players are witnesses."
   }
  },
  {
   "id": "c9",
   "text": {
    "tr": "Çay bardağının kenarında eldiven pudrası var: tıbbi eldivenlerde kullanılan türden.",
    "en": "There is glove powder on the rim of the tea glass: the kind used in medical gloves."
   }
  },
  {
   "id": "c10",
   "text": {
    "tr": "Kemal'in steteskop kutusunun astarı yeni dikilmiş ve içinde mikrofilm büyüklüğünde bir cep var.",
    "en": "The lining of Kemal's stethoscope case has been freshly stitched, leaving a microfilm-sized pocket."
   }
  }
 ],
