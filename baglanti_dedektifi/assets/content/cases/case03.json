{
 "id": "case03",
 "order": 3,
 "premium": false,
 "icon": "fog",
 "title": {
  "tr": "Sisli Fener",
  "en": "The Foggy Lighthouse"
 },
 "intro": [
  {
   "icon": "fog",
   "text": {
    "tr": "Kuzey burnundaki eski fener, sisli bir gecede söndü ve bir yük gemisi kayalıklara oturdu.",
    "en": "On a foggy night, the old lighthouse on the north cape went dark and a cargo ship ran aground on the rocks."
   }
  },
  {
   "icon": "ship",
   "text": {
    "tr": "Mürettebat kurtarıldı ama gemideki mühürlü sandık kayıp. Fener bekçisi de ortada yok.",
    "en": "The crew was rescued, but the ship's sealed crate is missing. So is the lighthouse keeper."
   }
  },
  {
   "icon": "world-map",
   "text": {
    "tr": "Haritadaki işaret burayı gösteriyordu. Gölge'nin bir sonraki hamlesi o sandıkta olabilir.",
    "en": "The mark on the map pointed here. The Shadow's next move may be inside that crate."
   }
  }
 ],
 "suspects": [
  {
   "id": "nevin",
   "icon": "woman-student",
   "name": {
    "tr": "Nevin",
    "en": "Nevin"
   },
   "role": {
    "tr": "Bekçinin yeğeni",
    "en": "The keeper's niece"
   },
   "bio": {
    "tr": "Amcasının kaybolduğunu ilk o bildirdi. Fenerin yedek anahtarı ondaydı.",
    "en": "She was the first to report her uncle missing. She held the spare lighthouse key."
   }
  },
  {
   "id": "cemal",
   "icon": "man-beard",
   "name": {
    "tr": "Cemal Reis",
    "en": "Cemal Reis"
   },
   "role": {
    "tr": "Balıkçı",
    "en": "Fisherman"
   },
   "bio": {
    "tr": "O gece denizdeydi. Teknesi kayalıklara en yakın tekneydi.",
    "en": "He was out at sea that night. His boat was the closest to the rocks."
   }
  },
  {
   "id": "orhan",
   "icon": "man-office-worker",
   "name": {
    "tr": "Orhan",
    "en": "Orhan"
   },
   "role": {
    "tr": "Liman başkanı",
    "en": "Harbor master"
   },
   "bio": {
    "tr": "Gemilerin rotasını o onaylar. Geçen ay lüks bir yalı satın aldı.",
    "en": "He approves every ship's course. Last month he bought a luxury seaside mansion."
   }
  },
  {
   "id": "zeynep",
   "icon": "woman-office-worker",
   "name": {
    "tr": "Zeynep",
    "en": "Zeynep"
   },
   "role": {
    "tr": "Sigorta müfettişi",
    "en": "Insurance inspector"
   },
   "bio": {
    "tr": "Kazayı incelemek için geldi. Herkese çok fazla soru soruyor.",
    "en": "She came to investigate the wreck and asks everyone far too many questions."
   }
  }
 ],
 "clues": [
  {
   "id": "c1",
   "text": {
    "tr": "Fenerin lambası bozulmamış; şalteri elle indirilmiş.",
    "en": "The lamp was not broken; its switch had been pulled by hand."
   }
  },
  {
   "id": "c2",
   "text": {
    "tr": "Fener bekçisi, liman binasının bodrumunda bağlı halde bulundu. Sis yüzünden kimseyi görmemiş.",
    "en": "The keeper was found tied up in the harbor office basement. In the fog, he saw no one."
   }
  },
  {
   "id": "c3",
   "text": {
    "tr": "Geminin rotası kazadan bir saat önce liman ofisinden değiştirilmiş.",
    "en": "The ship's course was changed from the harbor office one hour before the wreck."
   }
  },
  {
   "id": "c4",
   "text": {
    "tr": "Cemal Reis'in teknesi o gece mürettebatı kurtardı; telsiz kayıtları onu baştan sona kayalıklarda gösteriyor.",
    "en": "Captain Cemal's boat rescued the crew that night; radio logs place him at the rocks the whole time."
   }
  },
  {
   "id": "c5",
   "text": {
    "tr": "Nevin, fenerin yedek anahtarını iki hafta önce kaybettiğini bildirmiş.",
    "en": "Nevin reported losing the spare lighthouse key two weeks ago."
   }
  },
  {
   "id": "c6",
   "text": {
    "tr": "Müfettiş Zeynep şehre kazadan bir gün önce, yani kaza olmadan önce gelmiş!",
    "en": "Inspector Zeynep arrived in town the day before the wreck, before it had even happened!"
   }
  },
  {
   "id": "c7",
   "text": {
    "tr": "Zeynep'in şirketi onu, liman ofisinden gelen isimsiz bir ihbar üzerine erkenden göndermiş.",
    "en": "Zeynep's company sent her early after an anonymous tip from inside the harbor office."
   }
  },
  {
   "id": "c8",
   "text": {
    "tr": "Liman ofisinin kapı kaydı: o gece içeri giren tek kart Orhan'ınki.",
    "en": "The harbor office door log: the only card used that night was Orhan's."
   }
  },
  {
   "id": "c9",
   "text": {
    "tr": "Orhan'ın yalısının iskelesinde sandığın mühür mumundan parçalar bulundu.",
    "en": "Fragments of the crate's wax seal were found on the jetty of Orhan's mansion."
   }
  },
  {
   "id": "c10",
   "text": {
    "tr": "Kayıp yedek anahtar, Orhan'ın paltosunun iç cebinden çıktı.",
    "en": "The missing spare key turned up in the inside pocket of Orhan's coat."
   }
  }
 ],
