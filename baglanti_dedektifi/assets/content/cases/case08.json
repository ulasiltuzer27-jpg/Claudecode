 ],
 "ending": {
  "tr": "Can, babasının son filmini bir koleksiyoncuya satıp mirası hızlıca paraya çevirmek istemişti. Makara gala başlamadan makine dairesine döndü ve salon, Sadri Bey'in filmini ayakta alkışladı.",
  "en": "Can had planned to sell his father's last film to a collector and turn the inheritance into quick cash. The reel was back in the booth before the gala began, and the audience gave Sadri's film a standing ovation."
 },
 "teaser": {
  "tr": "Jenerikte, teşekkür listesinin en sonunda tanıdık bir isim geçiyor... Yeni Özel Dosyalar yolda.",
  "en": "At the very end of the credits, a familiar name appears in the thank-you list... New Special Files are on the way."
 }
}
