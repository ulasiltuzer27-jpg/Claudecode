{
 "id": "case08",
 "order": 8,
 "premium": true,
 "pack": "case_pack_1",
 "icon": "film-frames",
 "title": {
  "tr": "Kayıp Makara",
  "en": "The Lost Reel"
 },
 "intro": [
  {
   "icon": "film-frames",
   "text": {
    "tr": "Efsane yönetmen Sadri Bey'in son filminin tek kopyası, gala gösteriminden bir saat önce Liman Sineması'nın makine dairesinden kayboldu.",
    "en": "The only copy of legendary director Sadri's last film vanished from the Harbor Cinema's projection booth an hour before the gala screening."
   }
  },
  {
   "icon": "admission-tickets",
   "text": {
    "tr": "Salon dolu, biletler satıldı. Gösteriye kadar makarayı bulmalısın.",
    "en": "The house is full and the tickets are sold. You have to find the reel before the screening."
   }
  }
 ],
 "suspects": [
  {
   "id": "deniz",
   "icon": "man-technologist",
   "name": {
    "tr": "Deniz",
    "en": "Deniz"
   },
   "role": {
    "tr": "Makinist",
    "en": "Projectionist"
   },
   "bio": {
    "tr": "Makine dairesinin anahtarı onda. Filmi yıllardır o oynatıyor.",
    "en": "He holds the key to the projection booth and has screened films here for years."
   }
  },
  {
   "id": "pinar",
   "icon": "woman-curly-hair",
   "name": {
    "tr": "Pınar",
    "en": "Pınar"
   },
   "role": {
    "tr": "Başrol oyuncusu",
    "en": "Lead actress"
   },
   "bio": {
    "tr": "Filmin yıldızı. Filmde gençliğine dair utandığı bir sahne var.",
    "en": "The star of the film. There's a scene in it about her youth that she's ashamed of."
   }
  },
  {
   "id": "can",
   "icon": "man-blonde-hair",
   "name": {
    "tr": "Can",
    "en": "Can"
   },
   "role": {
    "tr": "Yönetmenin oğlu",
    "en": "The director's son"
   },
   "bio": {
    "tr": "Sinemanın yeni sahibi. Babasının mirasını yönetiyor.",
    "en": "The cinema's new owner. He manages his father's estate."
   }
  },
  {
   "id": "vedat",
   "icon": "man-bald",
   "name": {
    "tr": "Vedat",
    "en": "Vedat"
   },
   "role": {
    "tr": "Film eleştirmeni",
    "en": "Film critic"
   },
   "bio": {
    "tr": "Sadri Bey'in filmlerini yıllarca yerden yere vurdu. Bu geceki galaya yine de geldi.",
    "en": "He tore Sadri's films apart for years. He came to tonight's gala all the same."
   }
  }
 ],
 "clues": [
  {
   "id": "c1",
   "text": {
    "tr": "Kilitli makine dairesinin iki anahtarı var: biri makinistte, biri sinemanın sahibinde.",
    "en": "The locked projection booth has two keys: one with the projectionist, one with the cinema's owner."
   }
  },
  {
   "id": "c2",
   "text": {
    "tr": "Makinist Deniz gala öncesinde lobideydi; bilet görevlisi onun hiç ayrılmadığını söylüyor.",
    "en": "Projectionist Deniz was in the lobby before the gala; the usher says he never left."
   }
  },
  {
   "id": "c3",
   "text": {
    "tr": "Pınar filmin gösterilmesini istemiyordu; filmde gençlik hatalarını anlatan bir sahne var.",
    "en": "Pınar didn't want the film shown; it includes a scene about her youthful mistakes."
   }
  },
  {
   "id": "c4",
   "text": {
    "tr": "Pınar o saatte basın toplantısındaydı; otuz gazeteci tanık.",
    "en": "Pınar was at a press conference at that hour; thirty journalists are witnesses."
   }
  },
  {
   "id": "c5",
   "text": {
    "tr": "Eleştirmen Vedat'ın çantasında makara büyüklüğünde bir kutu bulundu.",
    "en": "A reel-sized tin was found in critic Vedat's bag."
   }
  },
  {
   "id": "c6",
   "text": {
    "tr": "Vedat'ın kutusundaki makara, kendi çektiği kısa filmin kopyası çıktı.",
    "en": "The reel in Vedat's tin turned out to be a copy of his own short film."
   }
  },
  {
   "id": "c7",
   "text": {
    "tr": "Sinemanın ikinci anahtarı aile kasasında duruyordu; kasa bu ay Can tarafından iki kez açılmış.",
    "en": "The cinema's second key was kept in the family safe; Can opened that safe twice this month."
   }
  },
  {
   "id": "c8",
   "text": {
    "tr": "Can'ın telefonunda bir koleksiyoncuyla yazışma var: \"Kopyası olmayan tek film. Fiyatı iki katı.\"",
    "en": "Can's phone holds messages with a collector: \"The only film with no copy. Twice the price.\""
   }
  },
  {
   "id": "c9",
   "text": {
    "tr": "Makine dairesinin tozlu zemininde, Can'ın ayakkabı tabanıyla aynı desende izler var.",
    "en": "There are prints on the dusty booth floor that match the sole pattern of Can's shoes."
   }
  },
  {
   "id": "c10",
   "text": {
    "tr": "Makara, Can'ın arabasının bagajında, yedek lastiğin içinde bulundu.",
    "en": "The reel was found in the boot of Can's car, hidden inside the spare tyre."
   }
  }
 ],
