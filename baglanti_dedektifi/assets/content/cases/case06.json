{
 "id": "case06",
 "order": 6,
 "premium": false,
 "icon": "bust-in-silhouette",
 "title": {
  "tr": "Gölge'nin Yüzü",
  "en": "The Shadow's Face"
 },
 "intro": [
  {
   "icon": "mantelpiece-clock",
   "text": {
    "tr": "Yılbaşı gecesi. Saat kulesi on ikiyi vurduğunda Liman Bankası'nın kasası açılacak. Gölge'yi yakalamak için son şans.",
    "en": "New Year's Eve. When the clock tower strikes twelve, the Harbor Bank vault will open. This is the last chance to catch the Shadow."
   }
  },
  {
   "icon": "bust-in-silhouette",
   "text": {
    "tr": "Bankanın yılbaşı balosunda dört davetli var. Hepsi kasanın planlarını görmüş. Biri Gölge.",
    "en": "There are four guests at the bank's New Year ball. All of them have seen the vault plans. One of them is the Shadow."
   }
  },
  {
   "icon": "gem-stone",
   "text": {
    "tr": "Bulanık fotoğraftaki tek ipucu, mavi yıldız biçiminde bir kol düğmesi. Bu işareti daha önce bir yerde gördün...",
    "en": "The only clue in the blurry photo is a cufflink shaped like a blue star. You've seen that mark somewhere before..."
   }
  }
 ],
 "suspects": [
  {
   "id": "selim",
