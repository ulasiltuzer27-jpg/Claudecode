   "name": {
    "tr": "Selim",
    "en": "Selim"
   },
   "role": {
    "tr": "Bankanın sanat danışmanı",
    "en": "The bank's art adviser"
   },
   "bio": {
    "tr": "Mavi Yıldız davasından sonra müzeden ayrıldı. Şimdi bankanın koleksiyonunu yönetiyor.",
    "en": "He left the museum after the Blue Star case. Now he manages the bank's art collection."
   }
  },
  {
   "id": "ferit",
   "icon": "man-white-hair",
   "name": {
    "tr": "Ferit",
    "en": "Ferit"
   },
   "role": {
    "tr": "Banka müdürü",
    "en": "Bank manager"
   },
   "bio": {
    "tr": "Kasanın planları onun imzasıyla çizildi. Bu yıl emekli olacak.",
    "en": "The vault plans were drawn up under his signature. He retires this year."
   }
  },
  {
   "id": "defne",
   "icon": "woman-office-worker",
   "name": {
    "tr": "Defne",
    "en": "Defne"
   },
   "role": {
    "tr": "Gazeteci",
    "en": "Journalist"
   },
   "bio": {
    "tr": "Liman Ekspresi'nden beri Gölge'nin peşinde. Bu gece haberini bitirmeye geldi.",
    "en": "She has chased the Shadow since the Harbor Express. Tonight she came to finish her story."
   }
  },
  {
   "id": "nermin",
   "icon": "woman-police-officer",
   "name": {
    "tr": "Nermin",
    "en": "Nermin"
   },
   "role": {
    "tr": "Komiser",
    "en": "Police chief"
   },
   "bio": {
    "tr": "Baloda güvenlikten sorumlu. Gölge'yi yakalayamadığı için basın onu eleştiriyor.",
    "en": "She's in charge of security at the ball. The press has slammed her for failing to catch the Shadow."
   }
  }
 ],
 "clues": [
  {
   "id": "c1",
   "text": {
    "tr": "Kasanın zaman kilidi kule saatinin mekanizmasına bağlı. Biri kule saatini üç dakika ileri almış.",
    "en": "The vault's time lock is linked to the clock tower's mechanism. Someone set the tower clock three minutes fast."
   }
  },
  {
   "id": "c2",
   "text": {
    "tr": "Kule saati yalnızca eski saatçi anahtarıyla kurulabiliyor. O anahtar yıllarca müzede sergilendi.",
    "en": "The tower clock can only be set with an old clockmaker's key. That key was on display in the museum for years."
   }
  },
  {
   "id": "c3",
   "text": {
    "tr": "Defne'nin taslak haberi: \"Gölge her davada sigortadan para kazandı.\"",
    "en": "Defne's draft story: \"The Shadow profited from insurance in every case.\""
   }
  },
  {
   "id": "c4",
   "text": {
    "tr": "Komiser Nermin balo boyunca telsizle ekibini yönetti; kayıtlar bir saniye bile kesilmiyor.",
    "en": "Chief Nermin directed her team by radio all night; the recordings never break for a second."
   }
  },
  {
   "id": "c5",
   "text": {
    "tr": "Banka müdürü Ferit kasanın planlarını eve götürmüş. Ama planlar ertesi sabah evinde, mühürlü zarfında dokunulmamış bulundu.",
    "en": "Bank manager Ferit took the vault plans home. But the next morning they were found there, untouched in their sealed envelope."
   }
  },
  {
   "id": "c6",
   "text": {
    "tr": "Mavi Yıldız'ın sigortasını iki katına çıkaran kişi, şimdi bankanın sigorta danışmanlığını da yapıyor.",
    "en": "The person who doubled the Blue Star's insurance now also advises the bank on insurance."
   }
  },
  {
   "id": "c7",
   "text": {
    "tr": "Opera, otel ve liman: üç kurum da sanat koleksiyonları için aynı danışmanla çalışmış.",
    "en": "The opera, the hotel and the harbor office all used the same adviser for their art collections."
   }
  },
  {
   "id": "c8",
   "text": {
    "tr": "Balo salonunun halısında mavi yıldız biçiminde bir kol düğmesi bulundu.",
    "en": "A cufflink shaped like a blue star was found on the ballroom carpet."
   }
  },
  {
   "id": "c9",
   "text": {
    "tr": "Selim'in smokininin sol kolunda kol düğmesi eksik.",
    "en": "The cufflink is missing from the left sleeve of Selim's tuxedo."
   }
  },
  {
   "id": "c10",
   "text": {
    "tr": "Selim'in ofis kasasından gümüş gözlü kartvizitlerle dolu bir deste ve müzenin kayıp saatçi anahtarı çıktı.",
    "en": "A stack of silver-eye calling cards and the museum's missing clockmaker's key were found in Selim's office safe."
   }
  }
 ],
