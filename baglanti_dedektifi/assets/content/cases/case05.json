{
 "id": "case05",
 "order": 5,
 "premium": false,
 "icon": "snow-capped-mountain",
 "title": {
  "tr": "Karlı Otel",
  "en": "The Snowbound Hotel"
 },
 "intro": [
  {
   "icon": "snow-capped-mountain",
   "text": {
    "tr": "Karlı Dağ Oteli'ne giden tek yol tipiyle kapandı. Gölge'ye karşı tanıklık edecek muhasebeci Emre burada saklanıyordu.",
    "en": "The blizzard has closed the only road to Snowpeak Hotel, where accountant Emre was hiding before testifying against the Shadow."
   }
  },
  {
   "icon": "bellhop-bell",
   "text": {
    "tr": "Sabah oda 7 boştu. Yatak dağınık, pencere içeriden kilitli ve karda tek bir ayak izi bile yok.",
    "en": "In the morning, room 7 was empty. The bed unmade, the window locked from inside, and not a single footprint in the snow."
   }
  },
  {
   "icon": "detective",
   "text": {
    "tr": "Otelden kimse çıkamaz. Emre hâlâ içeride bir yerde. Onu kim, nereye sakladı?",
    "en": "Nobody can leave the hotel. Emre is still inside somewhere. Who hid him, and where?"
   }
  }
 ],
 "suspects": [
  {
   "id": "hulya",
   "icon": "woman-blonde-hair",
   "name": {
    "tr": "Hülya",
    "en": "Hülya"
   },
   "role": {
    "tr": "Otel müdürü",
    "en": "Hotel manager"
   },
   "bio": {
    "tr": "Oteli yirmi yıldır işletiyor. Her odanın ana anahtarı onda.",
    "en": "She has run the hotel for twenty years and holds the master key to every room."
   }
  },
  {
   "id": "cem",
   "icon": "skier",
   "name": {
    "tr": "Cem",
    "en": "Cem"
   },
   "role": {
    "tr": "Kayak hocası",
    "en": "Ski instructor"
   },
   "bio": {
    "tr": "Dağı avucunun içi gibi bilir. Fırtınada bile dışarı çıkmaktan korkmaz.",
    "en": "He knows the mountain like the back of his hand and isn't afraid to go out, even in a storm."
   }
  },
  {
   "id": "sukru",
   "icon": "man-cook",
   "name": {
    "tr": "Şükrü",
    "en": "Şükrü"
   },
   "role": {
    "tr": "Aşçı",
    "en": "Cook"
   },
   "bio": {
    "tr": "Gece boyunca mutfaktaydı. Servis asansörünü yalnızca o kullanır.",
    "en": "He spent the night in the kitchen. He's the only one who uses the service lift."
   }
  },
  {
   "id": "melis",
   "icon": "woman-health-worker",
   "name": {
    "tr": "Melis",
    "en": "Melis"
   },
   "role": {
    "tr": "Otel hemşiresi",
    "en": "Hotel nurse"
   },
   "bio": {
    "tr": "Revirin anahtarı onda. Emre'yi dün akşam son gören kişi.",
    "en": "She holds the key to the infirmary and was the last to see Emre last night."
   }
  }
 ],
 "clues": [
  {
   "id": "c1",
   "text": {
    "tr": "Oda 7'nin kapısı içeriden değil, dışarıdan ana anahtarla kilitlenmiş.",
    "en": "Room 7 was locked from the outside with the master key, not from the inside."
   }
  },
  {
   "id": "c2",
   "text": {
    "tr": "Ana anahtar yalnızca müdürde ve gece resepsiyonunda bulunur.",
    "en": "The master key is kept only by the manager and at the night reception desk."
   }
  },
  {
   "id": "c3",
   "text": {
    "tr": "Kayak hocası Cem bütün gece barda gitar çaldı; on iki misafir tanık.",
    "en": "Ski instructor Cem played guitar in the bar all night; twelve guests are witnesses."
   }
  },
  {
   "id": "c4",
   "text": {
    "tr": "Çamaşır arabasının tekerlek izleri oda 7'den servis asansörüne gidiyor.",
    "en": "Laundry cart wheel tracks lead from room 7 to the service lift."
   }
  },
  {
   "id": "c5",
   "text": {
    "tr": "Hemşire Melis'in dolabından güçlü bir sakinleştirici eksik.",
    "en": "A strong sedative is missing from Nurse Melis's cabinet."
   }
  },
  {
   "id": "c6",
   "text": {
    "tr": "Melis, sakinleştiriciyi gece ateşlenen bir çocuğa verdiğini söylüyor; çocuğun annesi doğruluyor.",
    "en": "Melis says she gave the sedative to a child with a fever that night; the child's mother confirms it."
   }
  },
  {
   "id": "c7",
   "text": {
    "tr": "Aşçı Şükrü asansörü yalnızca mutfakta kullandığını söylüyor ama asansör gece bir kez bodruma inmiş.",
    "en": "Cook Şükrü says he only used the lift in the kitchen, yet the lift went down to the basement once that night."
   }
  },
  {
   "id": "c8",
   "text": {
    "tr": "Gece resepsiyon defterinde saat 02.00'den sonraki sayfa yırtılmış. O saatte resepsiyonda müdür Hülya duruyordu.",
    "en": "In the night reception log, the page after 2 am has been torn out. Manager Hülya was on the desk at that hour."
   }
  },
  {
   "id": "c9",
   "text": {
    "tr": "Bodrumdaki eski şarap mahzeninin kilidi yeni. Anahtarı Hülya'nın odasındaki saksının dibinden çıktı.",
    "en": "The lock on the old wine cellar in the basement is new. Its key turned up under a plant pot in Hülya's room."
   }
  },
  {
   "id": "c10",
   "text": {
    "tr": "Emre mahzende uyurken bulundu. Battaniyesine gümüş iplikle bir göz işlenmiş; iplik, müdürün odasındaki kasnaktakiyle aynı.",
    "en": "Emre was found asleep in the cellar. An eye has been embroidered on his blanket in silver thread, the same thread as on the hoop in the manager's room."
   }
  }
 ],
