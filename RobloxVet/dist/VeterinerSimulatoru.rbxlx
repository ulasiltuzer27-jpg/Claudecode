					<Properties>
						<string name="Name">tr</string>
						<ProtectedString name="Source">-- URETILEN DOSYA - ELLE DUZENLEMEYIN.
-- Kaynak: data/tr.json
-- Uretici: tools/jsontolua.py  (python3 build.py)
-- (VERI) Türkçe metin tablosu. Oyun içindeki HER yazı buradan geliyor; kodda tek bir sabit metin yok.
return {
	[&quot;code&quot;] = &quot;tr&quot;,
