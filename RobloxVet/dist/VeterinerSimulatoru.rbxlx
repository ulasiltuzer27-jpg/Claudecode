			<Item class="ModuleScript" referent="RBX11">
				<Properties>
					<string name="Name">assetIds</string>
					<ProtectedString name="Source">-- URETILEN DOSYA - ELLE DUZENLEMEYIN.
-- Kaynak: data/assetIds.json
-- Uretici: tools/jsontolua.py  (python3 build.py)
-- (VERI) Creator Store asset ID yuvalari. 0 = o yuva BOS, prosedurel (kod ile uretilen) model/ses kullanilir.
