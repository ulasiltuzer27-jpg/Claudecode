<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="Workspace" referent="RBX0">
		<Properties>
			<string name="Name">Workspace</string>
			<bool name="FilteringEnabled">true</bool>
		</Properties>
	</Item>
	<Item class="Lighting" referent="RBX1">
		<Properties>
			<string name="Name">Lighting</string>
			<token name="Technology">4</token>
		</Properties>
	</Item>
	<Item class="ReplicatedStorage" referent="RBX2">
		<Properties>
			<string name="Name">ReplicatedStorage</string>
		</Properties>
		<Item class="Folder" referent="RBX3">
			<Properties>
				<string name="Name">VetShared</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX4">
				<Properties>
					<string name="Name">Assets</string>
					<ProtectedString name="Source">--!strict
-- Assets.luau
-- ===========
-- Creator Store asset ID'lerinin TEK okuma noktasi.
--
-- Bu depo, Roblox'a ag erisimi OLMAYAN bir ortamda uretildi: hicbir
-- asset ID'nin gercekten var oldugu dogrulanamadi. Uydurma ID yazmak
-- oyunda gri/kirik model demek olurdu. Bu yuzden data/assetIds.json
-- bilerek BOS geliyor ve butun modeller kod ile uretiliyor.
--
-- Kullanici bir ID yapistirdiginda burasi onu dondurur, ilgili yapi
-- prosedurel modelin yerine mesh'i kullanir. Yuva 0 ise nil doner ve
-- prosedurel model kullanilir - yani tablo bos oldugunda hicbir sey
-- bozulmaz.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Data = ReplicatedStorage:WaitForChild(&quot;VetData&quot;)

local ids = require(Data.assetIds)

local Assets = {}

local function resolve(group: { [string]: number }?, name: string): string?
	if group == nil then
		return nil
	end
	local id = group[name]
	if id == nil or id == 0 then
		return nil
	end
	return &quot;rbxassetid://&quot; .. tostring(id)
end

--- Mesh yuvasi. nil -&gt; prosedurel model kullanilacak.
function Assets.mesh(name: string): string?
	return resolve(ids.meshes, name)
end

--- Ses yuvasi. nil -&gt; ses calinmayacak (sessizlik, hata degil).
function Assets.sound(name: string): string?
	return resolve(ids.sounds, name)
end

--- Gorsel yuvasi. nil -&gt; arayuz metin/sekil ile idare edecek.
function Assets.image(name: string): string?
	return resolve(ids.images, name)
end

--- Bir sesi verilen yere kurar. Yuva bossa nil doner; cagiran taraf
--- bunu kontrol etmek zorunda degil.
function Assets.playSound(name: string, parent: Instance, volume: number?): Sound?
	local assetId = Assets.sound(name)
	if assetId == nil then
		return nil
	end
	local sound = Instance.new(&quot;Sound&quot;)
	sound.SoundId = assetId
	sound.Volume = volume or 0.5
	sound.Parent = parent
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	return sound
end

--- Kac yuva dolu? SelfTest raporunda kullaniciya gosteriliyor.
function Assets.filledCount(): number
	local total = 0
	for _, group in { ids.meshes, ids.sounds, ids.images } do
		if group ~= nil then
			for _, id in group do
				if id ~= 0 then
					total += 1
				end
			end
		end
	end
	return total
end

return Assets
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX5">
				<Properties>
					<string name="Name">Build</string>
					<ProtectedString name="Source">--!strict
-- Build.luau
-- ==========
-- Part kurma yardimcilari. Klinik, esyalar ve hayvanlar CALISMA ANINDA
-- buradan geciyor.
--
-- Neden XML yerine kod?
-- ---------------------
-- .rbxlx'te `Material` gibi enum'lar sayisal token olarak yazilmak zorunda
-- (`&lt;token name=&quot;Material&quot;&gt;272&lt;/token&gt;`). Bu sayilari Studio olmadan
-- dogrulamak mumkun degil; yanlis token sessizce yanlis gorunum demek.
-- Burada ayni sey `Enum.Material.SmoothPlastic` diye yaziliyor: okunur,
-- diff'i anlamli, yanlissa Output'ta hata verir.

local Build = {}

--- [r,g,b] tablosunu Color3'e cevirir. Veri dosyalarindaki butun renkler
--- bu bicimde; tek cevrim noktasi burasi.
function Build.color(rgb: { number }): Color3
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

--- Bir rengi aydinlatir (0..1). Kenar/aksan parcalari icin.
function Build.lighten(color: Color3, amount: number): Color3
	return Color3.new(
		color.R + (1 - color.R) * amount,
		color.G + (1 - color.G) * amount,
		color.B + (1 - color.B) * amount
	)
end

--- Bir rengi koyulastirir (0..1).
function Build.darken(color: Color3, amount: number): Color3
	return Color3.new(color.R * (1 - amount), color.G * (1 - amount), color.B * (1 - amount))
end

export type PartSpec = {
	name: string?,
	size: Vector3,
	cf: CFrame?,
	color: Color3?,
	material: Enum.Material?,
	shape: Enum.PartType?,
	transparency: number?,
	reflectance: number?,
	anchored: boolean?,
	canCollide: boolean?,
	canQuery: boolean?,
	castShadow: boolean?,
	parent: Instance?,
}

--- Tek bir Part. Yuzeyler HER ZAMAN Smooth: Instance.new varsayilani
--- eski &quot;Studs&quot; yuzeyi verebiliyor ve model bir anda 2008 gorunumune
--- dusuyor.
function Build.part(spec: PartSpec): Part
	local part = Instance.new(&quot;Part&quot;)
	part.Name = spec.name or &quot;Part&quot;
	part.Size = spec.size
	part.CFrame = spec.cf or CFrame.new()
	part.Color = spec.color or Color3.fromRGB(235, 235, 235)
	part.Material = spec.material or Enum.Material.SmoothPlastic
	part.Shape = spec.shape or Enum.PartType.Block
	part.Transparency = spec.transparency or 0
	part.Reflectance = spec.reflectance or 0
	part.Anchored = if spec.anchored == nil then true else spec.anchored
	part.CanCollide = if spec.canCollide == nil then true else spec.canCollide
	part.CanQuery = if spec.canQuery == nil then true else spec.canQuery
	part.CastShadow = if spec.castShadow == nil then true else spec.castShadow
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.LeftSurface = Enum.SurfaceType.Smooth
	part.RightSurface = Enum.SurfaceType.Smooth
	part.FrontSurface = Enum.SurfaceType.Smooth
	part.BackSurface = Enum.SurfaceType.Smooth
	part.Parent = spec.parent
	return part
end

--- Silindir. DIKKAT: Roblox'ta silindirin ekseni X'tir; dikey bir direk
--- icin CFrame'i Z ekseninde 90 derece dondurmek gerekir. Bu tuzagi her
--- cagri yerinde tekrar hatirlamak yerine `Build.pillar` kullanilmali.
function Build.cylinder(spec: PartSpec): Part
	spec.shape = Enum.PartType.Cylinder
	return Build.part(spec)
end

--- Dikey silindir direk. `size` = Vector3.new(cap, yukseklik, cap).
function Build.pillar(spec: PartSpec): Part
	local height = spec.size.Y
	local diameter = spec.size.X
	local base = spec.cf or CFrame.new()
	spec.size = Vector3.new(height, diameter, diameter)
	spec.cf = base * CFrame.Angles(0, 0, math.rad(90))
	spec.shape = Enum.PartType.Cylinder
	return Build.part(spec)
end

--- Kure.
function Build.ball(spec: PartSpec): Part
	spec.shape = Enum.PartType.Ball
	return Build.part(spec)
end

--- Kama. Ayri bir sinif (WedgePart); Part.Shape ile yapilmiyor.
function Build.wedge(spec: PartSpec): WedgePart
	local part = Instance.new(&quot;WedgePart&quot;)
	part.Name = spec.name or &quot;Wedge&quot;
	part.Size = spec.size
	part.CFrame = spec.cf or CFrame.new()
	part.Color = spec.color or Color3.fromRGB(235, 235, 235)
	part.Material = spec.material or Enum.Material.SmoothPlastic
	part.Transparency = spec.transparency or 0
	part.Anchored = if spec.anchored == nil then true else spec.anchored
	part.CanCollide = if spec.canCollide == nil then true else spec.canCollide
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = spec.parent
	return part
end

--- Model kabugu.
function Build.model(name: string, parent: Instance?): Model
	local model = Instance.new(&quot;Model&quot;)
	model.Name = name
	model.Parent = parent
	return model
end

--- Bir modelin butun parcalarini kok parcaya kaynaklar ve kok disindaki
--- her seyi Anchored=false yapar. Hareketli modeller (hayvanlar) icin.
function Build.weldAll(model: Model, root: BasePart)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA(&quot;BasePart&quot;) and descendant ~= root then
			local weld = Instance.new(&quot;WeldConstraint&quot;)
			weld.Part0 = root
			weld.Part1 = descendant
			weld.Parent = root
			descendant.Anchored = false
			descendant.CanCollide = false
		end
	end
end

--- Bir yuzeye yazi. SurfaceGui + TextLabel; tabela ve monitor icin.
function Build.surfaceText(
	part: BasePart,
	face: Enum.NormalId,
	text: string,
	color: Color3,
	scaled: boolean?
): TextLabel
	local gui = Instance.new(&quot;SurfaceGui&quot;)
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.AlwaysOnTop = false
	gui.Parent = part

	local label = Instance.new(&quot;TextLabel&quot;)
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.Font = Enum.Font.GothamBold
	label.TextScaled = if scaled == nil then true else scaled
	label.TextWrapped = true
	label.Parent = gui
	return label
end

--- Tavan/oda isigi. Govde + PointLight.
function Build.ceilingLight(position: Vector3, parent: Instance, brightness: number?): Part
	local housing = Build.part({
		name = &quot;Lamba&quot;,
		size = Vector3.new(6, 0.35, 2.2),
		cf = CFrame.new(position),
		color = Color3.fromRGB(248, 250, 252),
		material = Enum.Material.Neon,
		canCollide = false,
		parent = parent,
	})
	local light = Instance.new(&quot;PointLight&quot;)
	light.Brightness = brightness or 1.6
	light.Range = 26
	light.Color = Color3.fromRGB(255, 248, 232)
	light.Shadows = true
	light.Parent = housing
	return housing
end

--- Yatay dikdortgen zemin/tavan levhasi. min/max [x,z] cinsinden.
function Build.slab(
	minXZ: { number },
	maxXZ: { number },
	y: number,
	thickness: number,
	color: Color3,
	material: Enum.Material,
	parent: Instance,
	name: string
): Part
	local width = maxXZ[1] - minXZ[1]
	local depth = maxXZ[2] - minXZ[2]
	local centerX = (minXZ[1] + maxXZ[1]) * 0.5
	local centerZ = (minXZ[2] + maxXZ[2]) * 0.5
	return Build.part({
		name = name,
		size = Vector3.new(width, thickness, depth),
		cf = CFrame.new(centerX, y, centerZ),
		color = color,
		material = material,
		parent = parent,
	})
end

return Build
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6">
				<Properties>
					<string name="Name">Loc</string>
					<ProtectedString name="Source">--!strict
-- Loc.luau
-- ========
-- Cevirinin TEK erisim noktasi.
--
-- Eksik anahtar GIZLENMEZ
-- -----------------------
-- Bir anahtar tabloda yoksa anahtarin KENDISI kose parantez icinde
-- gosterilir: `[hud.money]`. Sessizce bos string dondurmek, eksik
-- cevirinin ekranda hic fark edilmemesine yol acardi. Depo genelindeki
-- kural bu (bkz. C# tarafinda Localization/Loc.cs).

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Data = ReplicatedStorage:WaitForChild(&quot;VetData&quot;)

local table_tr = require(Data.locale.tr)

local Loc = {}

local strings: { [string]: string } = table_tr.strings

--- Anahtari cevirir. `{1}`, `{2}` ... yer tutucularini sirayla doldurur.
---
---     Loc.get(&quot;hud.money&quot;, 1250)      --&gt; &quot;PARA: 1250 TL&quot;
---     Loc.get(&quot;yok.olan.anahtar&quot;)     --&gt; &quot;[yok.olan.anahtar]&quot;
function Loc.get(key: string, ...: any): string
	local text = strings[key]
	if text == nil then
		return &quot;[&quot; .. key .. &quot;]&quot;
	end

	local count = select(&quot;#&quot;, ...)
	if count == 0 then
		return text
	end

	local args = table.pack(...)
	return (string.gsub(text, &quot;{(%d+)}&quot;, function(index: string): string
		local position = tonumber(index)
		if position == nil or position &lt; 1 or position &gt; args.n then
			-- Yer tutucu var ama karsiligi verilmemis: bunu da gizleme.
			return &quot;{&quot; .. index .. &quot;}&quot;
		end
		return tostring(args[position])
	end))
end

--- Anahtar var mi? Denetleyiciler ve self-test icin.
function Loc.has(key: string): boolean
	return strings[key] ~= nil
end

--- Tablodaki toplam satir sayisi. SelfTest raporunda kullaniliyor.
function Loc.count(): number
	local total = 0
	for _ in strings do
		total += 1
	end
	return total
end

return Loc
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX7">
				<Properties>
					<string name="Name">Net</string>
					<ProtectedString name="Source">--!strict
-- Net.luau
-- ========
-- Remote TANIMLARININ TEK NOKTASI.
--
-- Depo konvansiyonu: dis dunyaya acilan her yuzeyin tek bir tanim yeri
-- olur (C# tarafinda TransportFactory.cs ile ayni fikir). Burada da
-- remote adlari, yonleri ve argüman semalari tek tabloda; sunucu ve
-- istemci ayni tablodan okuyor. Bir remote'u yalnizca bir tarafta
-- tanimlamak ya da adini bir tarafta yanlis yazmak mumkun degil -
-- tools/verify_luau.py iki tarafi da bu tabloya karsi denetliyor.
--
-- RemoteFunction KULLANILMIYOR
-- ----------------------------
-- RemoteFunction sunucuyu istemcinin cevabini beklerken askida birakir;
-- kotu niyetli bir istemci cevabi hic dondurmeyerek sunucu thread'ini
-- kilitleyebilir. Her sey tek yonlu event; sunucu durumu StateUpdate ile
-- kendisi yayinliyor.

local RunService = game:GetService(&quot;RunService&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local Net = {}

-- Argüman semalari Validate.luau'daki tip adlariyla yaziliyor.
-- Bos liste = argümansiz.
Net.Schema = {
	-- ── Sunucu -&gt; Istemci ──────────────────────────────────────────────
	StateUpdate = { direction = &quot;toClient&quot;, args = { &quot;table&quot; } },
	ChartUpdate = { direction = &quot;toClient&quot;, args = { &quot;table&quot; } },
	Notify = { direction = &quot;toClient&quot;, args = { &quot;string&quot;, &quot;string&quot;, &quot;table&quot; } },
	ToolResult = { direction = &quot;toClient&quot;, args = { &quot;string&quot;, &quot;table&quot; } },
	SurgeryBegin = { direction = &quot;toClient&quot;, args = { &quot;table&quot; } },
	SurgeryEnd = { direction = &quot;toClient&quot;, args = { &quot;boolean&quot;, &quot;number&quot; } },

	-- ── Istemci -&gt; Sunucu ──────────────────────────────────────────────
	CallNext = { direction = &quot;toServer&quot;, args = {} },
	SelectTool = { direction = &quot;toServer&quot;, args = { &quot;string&quot; } },
	UseTool = { direction = &quot;toServer&quot;, args = { &quot;string&quot; } },
	SubmitDiagnosis = { direction = &quot;toServer&quot;, args = { &quot;string&quot; } },
	ApplyTreatment = { direction = &quot;toServer&quot;, args = { &quot;string&quot; } },
	SurgeryInput = { direction = &quot;toServer&quot;, args = { &quot;number&quot; } },
	Discharge = { direction = &quot;toServer&quot;, args = {} },
	BuyTool = { direction = &quot;toServer&quot;, args = { &quot;string&quot; } },
	BuyUpgrade = { direction = &quot;toServer&quot;, args = { &quot;string&quot; } },
}

-- Istemcinin saniyede kac kez gonderebilecegi. Dogrulama sunucuda
-- (Validate.luau); buradaki tablo yalnizca hiz limitini tanimliyor.
Net.RateLimit = {
	CallNext = 4,
	SelectTool = 12,
	UseTool = 6,
	SubmitDiagnosis = 4,
	ApplyTreatment = 6,
	SurgeryInput = 20,
	Discharge = 4,
	BuyTool = 4,
	BuyUpgrade = 4,
}

local folderName = &quot;VetRemotes&quot;
local cache: { [string]: RemoteEvent } = {}

--- SUNUCU: butun remote'lari olusturur. init.server.luau bir kez cagirir.
function Net.createAll()
	assert(RunService:IsServer(), &quot;Net.createAll yalnizca sunucuda cagrilabilir&quot;)

	local folder = ReplicatedStorage:FindFirstChild(folderName)
	if folder == nil then
		folder = Instance.new(&quot;Folder&quot;)
		folder.Name = folderName
		folder.Parent = ReplicatedStorage
	end

	for name in Net.Schema do
		if folder:FindFirstChild(name) == nil then
			local remote = Instance.new(&quot;RemoteEvent&quot;)
			remote.Name = name
			remote.Parent = folder
		end
	end
end

--- Adiyla remote getirir. Istemcide ilk cagride bekler.
function Net.get(name: string): RemoteEvent
	local cached = cache[name]
	if cached ~= nil then
		return cached
	end

	assert(Net.Schema[name] ~= nil, &quot;Net: tanimsiz remote: &quot; .. name)

	local folder = ReplicatedStorage:WaitForChild(folderName)
	local remote = folder:WaitForChild(name)
	assert(remote:IsA(&quot;RemoteEvent&quot;), &quot;Net: &quot; .. name .. &quot; RemoteEvent degil&quot;)

	cache[name] = remote
	return remote
end

--- SUNUCU: tek oyuncuya yollar.
function Net.toPlayer(name: string, player: Player, ...: any)
	assert(Net.Schema[name].direction == &quot;toClient&quot;, &quot;Net: &quot; .. name .. &quot; istemciye yollanamaz&quot;)
	Net.get(name):FireClient(player, ...)
end

--- ISTEMCI: sunucuya yollar.
function Net.toServer(name: string, ...: any)
	assert(Net.Schema[name].direction == &quot;toServer&quot;, &quot;Net: &quot; .. name .. &quot; sunucuya yollanamaz&quot;)
	Net.get(name):FireServer(...)
end

return Net
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX8">
				<Properties>
					<string name="Name">Validate</string>
					<ProtectedString name="Source">--!strict
-- Validate.luau
-- =============
-- Istemciden gelen HER argümanin dogrulandigi yer.
--
-- SUNUCU OTORITER
-- ---------------
-- Istemci yalnizca niyet bildirir (&quot;su aleti kullan&quot;); sonucu sunucu
-- hesaplar. Buradaki denetimler o niyetin bicimini dogruluyor: tip,
-- uzunluk, bilinen kimlik, hiz limiti. Bicimi gecen bir istek hala
-- oyun kurallarina takilabilir (parasi yetmiyor, alet acilmamis) -
-- o denetimler ilgili modullerde.

local Net = require(script.Parent.Net)

local Validate = {}

-- Kimlik dizeleri: yalnizca harf/rakam, makul uzunluk. Istemcinin
-- 100 KB'lik bir dize yollayip sunucuyu mesgul etmesini engeller.
local MAX_ID_LENGTH = 48

--- Kimlik dizesi mi?
function Validate.id(value: any): boolean
	if type(value) ~= &quot;string&quot; then
		return false
	end
	if #value == 0 or #value &gt; MAX_ID_LENGTH then
		return false
	end
	return string.match(value, &quot;^[%a][%w_]*$&quot;) ~= nil
end

--- Sonlu sayi mi? (NaN ve sonsuz elenir - ikisi de aritmetigi bozar.)
function Validate.number(value: any): boolean
	if type(value) ~= &quot;number&quot; then
		return false
	end
	return value == value and value ~= math.huge and value ~= -math.huge
end

--- Tam sayi ve araliginda mi?
function Validate.integerInRange(value: any, low: number, high: number): boolean
	if not Validate.number(value) then
		return false
	end
	if value % 1 ~= 0 then
		return false
	end
	return value &gt;= low and value &lt;= high
end

-- ── Hiz limiti ────────────────────────────────────────────────────────
-- Oyuncu basina, remote basina son cagrilarin zaman damgasi.
local buckets: { [Player]: { [string]: { count: number, windowStart: number } } } = {}

--- Oyuncu bu remote'u cagirabilir mi? Limiti asmissa false.
function Validate.rateOk(player: Player, remoteName: string): boolean
	local limit = Net.RateLimit[remoteName]
	if limit == nil then
		return true
	end

	local playerBucket = buckets[player]
	if playerBucket == nil then
		playerBucket = {}
		buckets[player] = playerBucket
	end

	local now = os.clock()
	local entry = playerBucket[remoteName]
	if entry == nil or now - entry.windowStart &gt;= 1 then
		playerBucket[remoteName] = { count = 1, windowStart = now }
		return true
	end

	if entry.count &gt;= limit then
		return false
	end
	entry.count += 1
	return true
end

--- Oyuncu ayrilinca kovasini temizler. Aksi halde tablo sizinti yapar.
function Validate.forget(player: Player)
	buckets[player] = nil
end

return Validate
</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX9">
			<Properties>
				<string name="Name">VetData</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX10">
				<Properties>
					<string name="Name">animals</string>
					<ProtectedString name="Source">-- URETILEN DOSYA - ELLE DUZENLEMEYIN.
-- Kaynak: data/animals.json
-- Uretici: tools/jsontolua.py  (python3 build.py)
-- (VERI) Hasta turleri. Oranlar stud cinsinden, renkler [r,g,b]. AnimalFactory bu tabloyu okuyup rigi kuruyor - yeni bir tur eklemek icin kod degistirmek gerekmiyor.
return {
	[&quot;animals&quot;] = {
		{
			[&quot;id&quot;] = &quot;dog&quot;,
			[&quot;nameKey&quot;] = &quot;animal.dog&quot;,
			[&quot;rig&quot;] = &quot;quadruped&quot;,
			[&quot;unlockLevel&quot;] = 1,
			[&quot;baseFee&quot;] = 140,
			[&quot;temperament&quot;] = 0.9,
			[&quot;walkSpeed&quot;] = 8,
			[&quot;palette&quot;] = {
				[&quot;body&quot;] = {
					186,
					140,
					88,
				},
				[&quot;belly&quot;] = {
					232,
					214,
