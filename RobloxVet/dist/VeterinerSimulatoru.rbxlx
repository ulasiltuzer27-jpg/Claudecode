			<Item class="LocalScript" referent="RBX40">
				<Properties>
					<string name="Name">VetClient</string>
					<ProtectedString name="Source">--!strict
-- init.client.luau
-- ================
-- Istemcinin TEK giris noktasi. Panelleri kurar, remote'lari dinler,
-- kisayollari baglar.
--
-- Istemci OYUN KURALI CALISTIRMAZ
-- -------------------------------
-- Burada hicbir para, seviye ya da teshis hesabi yok. Istemci
-- sunucudan gelen goruntuyu cizer ve niyet yollar. Bir panelin bir
-- dugmeyi &quot;kilitli&quot; gostermesi kolaylik; gercek denetim sunucuda.

local Players = game:GetService(&quot;Players&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Shared = ReplicatedStorage:WaitForChild(&quot;VetShared&quot;)
local Loc = require(Shared.Loc)
local Net = require(Shared.Net)

local Chart = require(script.Chart)
local DiagnosisPanel = require(script.DiagnosisPanel)
local Hud = require(script.Hud)
local Notify = require(script.Notify)
local ShopPanel = require(script.ShopPanel)
local SurgeryPanel = require(script.SurgeryPanel)
local Theme = require(script.Theme)
local ToolBar = require(script.ToolBar)
local TreatmentPanel = require(script.TreatmentPanel)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild(&quot;PlayerGui&quot;)

local screen = Instance.new(&quot;ScreenGui&quot;)
screen.Name = &quot;VeterinerArayuz&quot;
screen.ResetOnSpawn = false
screen.IgnoreGuiInset = true
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = playerGui

Hud.create(screen)
Chart.create(screen)
DiagnosisPanel.create(screen)
TreatmentPanel.create(screen)
ToolBar.create(screen)
ShopPanel.create(screen)
SurgeryPanel.create(screen)
Notify.create(screen)

-- Kisayol serisi ekranin altinda: oyuncunun tuslari tahmin etmesi
-- gerekmesin.
local hints = Theme.label({
	name = &quot;Kisayollar&quot;,
	text = Loc.get(&quot;hud.keys&quot;),
	size = UDim2.new(0, 520, 0, 18),
	position = UDim2.new(0.5, 0, 1, -88),
	anchor = Vector2.new(0.5, 1),
	textSize = 12,
	align = Enum.TextXAlignment.Center,
	color = Theme.color.textDim,
	parent = screen,
})
hints.TextStrokeTransparency = 0.6

local lastState: any = nil
local lastChart: any = nil

local function redraw()
	Hud.update(lastState)
	ToolBar.update(lastState)
	ShopPanel.update(lastState)
	Chart.update(lastChart)
	DiagnosisPanel.update(lastChart)
	TreatmentPanel.update(lastChart, lastState)
end

Net.get(&quot;StateUpdate&quot;).OnClientEvent:Connect(function(state: any)
	lastState = state
	redraw()
end)

Net.get(&quot;ChartUpdate&quot;).OnClientEvent:Connect(function(chart: any)
	lastChart = chart
	redraw()
end)

Net.get(&quot;Notify&quot;).OnClientEvent:Connect(function(kind: string, messageKey: string, args: { any })
	Notify.push(kind, messageKey, args)
end)

Net.get(&quot;ToolResult&quot;).OnClientEvent:Connect(function(toolId: string, payload: { any })
	-- Ameliyat adimlarinin notu ayni kanaldan geliyor: tek bir remote
	-- tanimi, iki kullanim. Ayirt edici, toolId'nin ozel degeri.
	if toolId == &quot;surgeryStep&quot; then
		SurgeryPanel.grade(tostring(payload[1]))
		return
	end

	if #payload == 0 then
		Notify.push(&quot;info&quot;, &quot;notify.nothingFound&quot;, { Loc.get(&quot;tool.&quot; .. toolId) })
		return
	end
	for _, nameKey in payload do
		Notify.push(&quot;good&quot;, &quot;notify.symptomFound&quot;, { nameKey })
	end
end)

Net.get(&quot;SurgeryBegin&quot;).OnClientEvent:Connect(function(schedule: any)
	SurgeryPanel.begin(schedule)
end)

Net.get(&quot;SurgeryEnd&quot;).OnClientEvent:Connect(function(_passed: boolean, _score: number)
	SurgeryPanel.finish()
end)

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.B then
		ShopPanel.toggle()
	elseif input.KeyCode == Enum.KeyCode.E then
		Net.toServer(&quot;CallNext&quot;)
	elseif input.KeyCode == Enum.KeyCode.T then
		Net.toServer(&quot;Discharge&quot;)
	end
end)

print(&quot;[Veteriner] istemci hazir.&quot;)
</ProtectedString>
				</Properties>
				<Item class="ModuleScript" referent="RBX41">
					<Properties>
						<string name="Name">Chart</string>
						<ProtectedString name="Source">--!strict
-- Chart.luau
-- ==========
-- Hasta karti: tur, saglik/stres, BULUNMUS semptomlar ve taburcu dugmesi.
--
-- Kartta hastaligin adi ancak dogru teshisten SONRA cikiyor - cunku
-- sunucu oncesinde onu hic yollamiyor (PatientFlow.chartSnapshot).

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Shared = ReplicatedStorage:WaitForChild(&quot;VetShared&quot;)
local Loc = require(Shared.Loc)
local Net = require(Shared.Net)

local Theme = require(script.Parent.Theme)

local Chart = {}

local widgets: any = nil

local SEVERITY_COLOR = {
	[1] = Theme.color.textDim,
	[2] = Theme.color.warn,
	[3] = Theme.color.bad,
}

function Chart.create(parent: ScreenGui)
	local panel = Theme.frame({
		name = &quot;HastaKarti&quot;,
		size = UDim2.fromOffset(330, 268),
		position = UDim2.new(1, -16, 0, 82),
		anchor = Vector2.new(1, 0),
		parent = parent,
	})
	Theme.stroke(panel)

	local title = Theme.label({
		name = &quot;Baslik&quot;,
		text = Loc.get(&quot;chart.empty&quot;),
		size = UDim2.new(1, -24, 0, 24),
		position = UDim2.fromOffset(12, 8),
		textSize = 18,
		bold = true,
		parent = panel,
	})

	local condition = Theme.label({
		name = &quot;Hastalik&quot;,
		text = &quot;&quot;,
		size = UDim2.new(1, -24, 0, 18),
		position = UDim2.fromOffset(12, 32),
		textSize = 13,
		color = Theme.color.good,
		parent = panel,
	})

	local healthLabel = Theme.label({
		name = &quot;SaglikYazi&quot;,
		text = &quot;&quot;,
		size = UDim2.new(1, -24, 0, 14),
		position = UDim2.fromOffset(12, 54),
		textSize = 11,
		color = Theme.color.textDim,
		parent = panel,
	})
	local healthBar = Theme.bar(panel, UDim2.new(1, -24, 0, 9), UDim2.fromOffset(12, 70), Theme.color.health)

	local stressLabel = Theme.label({
		name = &quot;StresYazi&quot;,
		text = &quot;&quot;,
		size = UDim2.new(1, -24, 0, 14),
		position = UDim2.fromOffset(12, 84),
		textSize = 11,
		color = Theme.color.textDim,
		parent = panel,
	})
	local stressBar = Theme.bar(panel, UDim2.new(1, -24, 0, 9), UDim2.fromOffset(12, 100), Theme.color.stress)

	Theme.label({
		name = &quot;SemptomBaslik&quot;,
		text = Loc.get(&quot;chart.symptoms&quot;),
		size = UDim2.new(1, -24, 0, 16),
		position = UDim2.fromOffset(12, 116),
		textSize = 12,
		bold = true,
		color = Theme.color.textDim,
		parent = panel,
	})

	local list = Theme.scroller(panel, UDim2.new(1, -24, 0, 88), UDim2.fromOffset(12, 134))
	Theme.list(list, 3)

	local discharge = Theme.button({
		name = &quot;Taburcu&quot;,
		text = Loc.get(&quot;chart.discharge&quot;),
		size = UDim2.new(1, -24, 0, 28),
		position = UDim2.new(0, 12, 1, -36),
		color = Theme.color.accentDark,
		parent = panel,
		onClick = function()
			Net.toServer(&quot;Discharge&quot;)
		end,
	})

	widgets = {
		panel = panel,
		title = title,
		condition = condition,
		healthLabel = healthLabel,
		healthBar = healthBar,
		stressLabel = stressLabel,
		stressBar = stressBar,
		list = list,
		discharge = discharge,
	}
end

function Chart.update(chart: any)
	if widgets == nil then
		return
	end

	if chart == nil or chart.present ~= true then
		widgets.title.Text = Loc.get(&quot;chart.empty&quot;)
		widgets.condition.Text = &quot;&quot;
		widgets.healthLabel.Text = &quot;&quot;
		widgets.stressLabel.Text = &quot;&quot;
		Theme.setBar(widgets.healthBar, 0)
		Theme.setBar(widgets.stressBar, 0)
		widgets.list:ClearAllChildren()
		Theme.list(widgets.list, 3)
		widgets.discharge.Visible = false
		return
	end

	widgets.title.Text = Loc.get(chart.nameKey)
	widgets.condition.Text = if chart.diagnosed and chart.conditionNameKey ~= nil
		then Loc.get(&quot;chart.diagnosed&quot;, Loc.get(chart.conditionNameKey))
		else Loc.get(&quot;chart.undiagnosed&quot;)
	widgets.condition.TextColor3 = if chart.diagnosed then Theme.color.good else Theme.color.warn

	widgets.healthLabel.Text = Loc.get(&quot;chart.health&quot;, chart.health)
	Theme.setBar(widgets.healthBar, chart.health / 100)
	widgets.stressLabel.Text = Loc.get(&quot;chart.stress&quot;, chart.stress)
	Theme.setBar(widgets.stressBar, chart.stress / 100)

	widgets.list:ClearAllChildren()
	Theme.list(widgets.list, 3)

	if #chart.revealed == 0 then
		Theme.label({
			text = Loc.get(&quot;chart.noSymptoms&quot;),
			size = UDim2.new(1, -8, 0, 18),
			textSize = 12,
			color = Theme.color.textDim,
			parent = widgets.list,
		})
	else
		for index, symptom in chart.revealed do
			Theme.label({
				text = &quot;• &quot; .. Loc.get(symptom.nameKey),
				size = UDim2.new(1, -8, 0, 18),
				textSize = 13,
				color = SEVERITY_COLOR[symptom.severity] or Theme.color.text,
				layoutOrder = index,
				parent = widgets.list,
			})
		end
	end

	widgets.discharge.Visible = chart.complete == true
end

return Chart
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX42">
					<Properties>
						<string name="Name">DiagnosisPanel</string>
						<ProtectedString name="Source">--!strict
-- DiagnosisPanel.luau
-- ===================
-- Teshis paneli: bu turde gorulebilecek hastaliklarin listesi. Oyuncu
-- birini secip gonderiyor, DOGRULUGUNU SUNUCU soyluyor.
--
-- Liste neden hep gorunuyor?
-- --------------------------
-- Oyuncuya &quot;hangi hastaliklar olabilir&quot; listesini vermek bulmacayi
-- kolaylastirmiyor; semptom-&gt;hastalik eslesmesini kurmak hala oyuncunun
-- isi. Listeyi gizlemek yalnizca oyuncuyu ezberlemeye zorlardi.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Shared = ReplicatedStorage:WaitForChild(&quot;VetShared&quot;)
local Loc = require(Shared.Loc)
local Net = require(Shared.Net)

local Theme = require(script.Parent.Theme)

local DiagnosisPanel = {}

local widgets: any = nil
local lastSignature = &quot;&quot;

function DiagnosisPanel.create(parent: ScreenGui)
	local panel = Theme.frame({
		name = &quot;TeshisPaneli&quot;,
		size = UDim2.fromOffset(330, 250),
		position = UDim2.new(1, -16, 0, 358),
		anchor = Vector2.new(1, 0),
		parent = parent,
		visible = false,
	})
	Theme.stroke(panel)

	Theme.label({
		text = Loc.get(&quot;diagnosis.title&quot;),
		size = UDim2.new(1, -24, 0, 22),
		position = UDim2.fromOffset(12, 8),
		textSize = 16,
		bold = true,
		parent = panel,
	})
	Theme.label({
		text = Loc.get(&quot;diagnosis.hint&quot;),
		size = UDim2.new(1, -24, 0, 26),
		position = UDim2.fromOffset(12, 28),
		textSize = 11,
		color = Theme.color.textDim,
		wrapped = true,
		parent = panel,
	})

	local list = Theme.scroller(panel, UDim2.new(1, -24, 1, -66), UDim2.fromOffset(12, 56))
	Theme.list(list, 4)

	widgets = { panel = panel, list = list }
end

function DiagnosisPanel.update(chart: any)
	if widgets == nil then
		return
	end

	local show = chart ~= nil and chart.present == true and chart.diagnosed ~= true
	widgets.panel.Visible = show
	if not show then
		lastSignature = &quot;&quot;
		return
	end

	-- Liste yalnizca degistiyse yeniden kuruluyor: her vitals tikinda
	-- dugmeleri silip yeniden yaratmak imleci dugmeden dusururdu.
	local signature = chart.animalId .. &quot;|&quot; .. tostring(#chart.candidates)
	if signature == lastSignature then
		return
	end
	lastSignature = signature

	widgets.list:ClearAllChildren()
	Theme.list(widgets.list, 4)

	for index, candidate in chart.candidates do
		local id = candidate.id
		Theme.button({
			name = id,
			text = Loc.get(candidate.nameKey),
			size = UDim2.new(1, -8, 0, 28),
			textSize = 13,
			layoutOrder = index,
			parent = widgets.list,
			onClick = function()
				Net.toServer(&quot;SubmitDiagnosis&quot;, id)
			end,
		})
	end
end

return DiagnosisPanel
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX43">
					<Properties>
						<string name="Name">Hud</string>
						<ProtectedString name="Source">--!strict
-- Hud.luau
-- ========
-- Sol ustte para/seviye/itibar, sag ustte kuyruk ve kisayol ipuclari.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Shared = ReplicatedStorage:WaitForChild(&quot;VetShared&quot;)
local Loc = require(Shared.Loc)

local Theme = require(script.Parent.Theme)

local Hud = {}

local widgets: any = nil

function Hud.create(parent: ScreenGui)
	local panel = Theme.frame({
		name = &quot;Hud&quot;,
		size = UDim2.fromOffset(256, 132),
		position = UDim2.fromOffset(16, 16),
		parent = parent,
	})
	Theme.stroke(panel)

	local money = Theme.label({
		name = &quot;Para&quot;,
		text = &quot;&quot;,
		size = UDim2.new(1, -24, 0, 26),
		position = UDim2.fromOffset(12, 8),
		textSize = 22,
		bold = true,
		color = Theme.color.money,
		parent = panel,
	})

	local title = Theme.label({
		name = &quot;Unvan&quot;,
		text = &quot;&quot;,
		size = UDim2.new(1, -24, 0, 18),
		position = UDim2.fromOffset(12, 38),
		textSize = 13,
		color = Theme.color.textDim,
		parent = panel,
	})

	local xpBar = Theme.bar(
		panel,
		UDim2.new(1, -24, 0, 10),
		UDim2.fromOffset(12, 60),
		Theme.color.xp
	)
	local xpText = Theme.label({
		name = &quot;Xp&quot;,
		text = &quot;&quot;,
		size = UDim2.new(1, -24, 0, 14),
		position = UDim2.fromOffset(12, 72),
		textSize = 11,
		color = Theme.color.textDim,
		parent = panel,
	})

	local repBar = Theme.bar(
		panel,
		UDim2.new(1, -24, 0, 10),
		UDim2.fromOffset(12, 92),
		Theme.color.accent
	)
	local repText = Theme.label({
		name = &quot;Itibar&quot;,
		text = &quot;&quot;,
		size = UDim2.new(1, -24, 0, 14),
		position = UDim2.fromOffset(12, 104),
		textSize = 11,
		color = Theme.color.textDim,
		parent = panel,
	})

	-- Kalici kayit kapaliysa bunu SOYLE. Sessizce bellekte oynatmak,
	-- oyuncunun ilerlemesini kaybettiginde sebebini bilememesi demek.
	local warning = Theme.label({
		name = &quot;Uyari&quot;,
		text = Loc.get(&quot;hud.transient&quot;),
		size = UDim2.new(1, -24, 0, 16),
		position = UDim2.fromOffset(12, 122),
		textSize = 11,
		bold = true,
		color = Theme.color.warn,
		parent = panel,
	})
	warning.Visible = false

	local queue = Theme.frame({
		name = &quot;Kuyruk&quot;,
		size = UDim2.fromOffset(210, 54),
		position = UDim2.new(1, -16, 0, 16),
		anchor = Vector2.new(1, 0),
		parent = parent,
	})
	Theme.stroke(queue)
	local queueText = Theme.label({
		name = &quot;Sayac&quot;,
		text = &quot;&quot;,
		size = UDim2.new(1, -24, 0, 22),
		position = UDim2.fromOffset(12, 8),
		textSize = 17,
		bold = true,
		parent = queue,
	})
	local hintText = Theme.label({
		name = &quot;Ipucu&quot;,
		text = Loc.get(&quot;hud.hints&quot;),
		size = UDim2.new(1, -24, 0, 16),
		position = UDim2.fromOffset(12, 32),
		textSize = 11,
		color = Theme.color.textDim,
		parent = queue,
	})

	widgets = {
		money = money,
		title = title,
		xpBar = xpBar,
		xpText = xpText,
		repBar = repBar,
		repText = repText,
		warning = warning,
		queueText = queueText,
		hintText = hintText,
	}
end

function Hud.update(state: any)
	if widgets == nil or state == nil or state.ready ~= true then
		return
	end

	widgets.money.Text = Loc.get(&quot;hud.money&quot;, state.money)
	widgets.title.Text = Loc.get(&quot;hud.level&quot;, state.level, Loc.get(state.titleKey))
	Theme.setBar(widgets.xpBar, state.progress)
	if state.level &gt;= state.maxLevel then
		widgets.xpText.Text = Loc.get(&quot;hud.xpMax&quot;, state.xp)
	else
		widgets.xpText.Text = Loc.get(&quot;hud.xp&quot;, state.xp)
	end

	Theme.setBar(widgets.repBar, state.reputation / 100)
	widgets.repText.Text = Loc.get(&quot;hud.reputation&quot;, math.floor(state.reputation + 0.5))

	widgets.warning.Visible = state.transient == true
	widgets.queueText.Text = Loc.get(&quot;hud.queue&quot;, state.queueWaiting, state.queueSlots)
end

return Hud
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX44">
					<Properties>
						<string name="Name">Notify</string>
						<ProtectedString name="Source">--!strict
-- Notify.luau
-- ===========
-- Ekranin ustunde yigilan kisa bildirimler.
--
-- Metin SUNUCUDAN GELMIYOR, anahtar geliyor: sunucu `notify.discharged`
-- gibi bir anahtar ve argumanlari yolluyor, ceviriyi istemci yapiyor.
-- Boylece dil degistirmek sunucuyu ilgilendirmiyor ve eksik anahtar
-- ekranda `[notify.discharged]` diye GORUNUYOR (Loc kurali).

local TweenService = game:GetService(&quot;TweenService&quot;)

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Shared = ReplicatedStorage:WaitForChild(&quot;VetShared&quot;)
local Loc = require(Shared.Loc)

local Theme = require(script.Parent.Theme)

local Notify = {}

local container: Frame? = nil
local MAX_VISIBLE = 5

function Notify.create(parent: ScreenGui)
	local frame = Theme.frame({
		name = &quot;Bildirimler&quot;,
		size = UDim2.new(0, 360, 0, 220),
		position = UDim2.new(0.5, 0, 0, 16),
		anchor = Vector2.new(0.5, 0),
		transparency = 1,
		radius = 0,
		parent = parent,
	})
	local layout = Theme.list(frame, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	container = frame
end

--- Bir bildirim gosterir. `args` icindeki `xxx.yyy` bicimindeki
--- dizeler de ceviri anahtari sayilip cevriliyor: sunucu tur/hastalik
--- adlarini anahtar olarak yolluyor.
function Notify.push(kind: string, messageKey: string, args: { any })
	if container == nil then
		return
	end

	local translated = {}
	for index, value in args do
		if type(value) == &quot;string&quot; and string.find(value, &quot;%.&quot;) ~= nil and Loc.has(value) then
			translated[index] = Loc.get(value)
		else
			translated[index] = value
		end
	end

	local text = Loc.get(messageKey, table.unpack(translated, 1, #args))

	local card = Theme.frame({
		name = &quot;Bildirim&quot;,
		size = UDim2.new(1, 0, 0, 34),
		color = Theme.color.panel,
		transparency = 0.1,
		radius = 8,
		parent = container,
	})
	Theme.stroke(card, Theme.kindColor(kind), 1.5)

	local accent = Theme.frame({
		name = &quot;Serit&quot;,
		size = UDim2.new(0, 4, 1, -10),
		position = UDim2.fromOffset(6, 5),
		color = Theme.kindColor(kind),
		transparency = 0,
		radius = 2,
		parent = card,
	})
	accent.ZIndex = 2

	Theme.label({
		text = text,
		size = UDim2.new(1, -24, 1, 0),
		position = UDim2.fromOffset(18, 0),
		textSize = 14,
		bold = true,
		color = Theme.color.text,
		parent = card,
	})

	-- Ekrani doldurmasin: en eskiyi at.
	local cards = {}
	for _, child in container:GetChildren() do
		if child:IsA(&quot;Frame&quot;) then
			table.insert(cards, child)
		end
	end
	if #cards &gt; MAX_VISIBLE then
		cards[1]:Destroy()
	end

	task.delay(4.5, function()
		if card.Parent == nil then
			return
		end
		local tween = TweenService:Create(card, TweenInfo.new(0.35), { BackgroundTransparency = 1 })
		tween:Play()
		tween.Completed:Once(function()
			card:Destroy()
		end)
	end)
end

return Notify
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX45">
					<Properties>
						<string name="Name">ShopPanel</string>
						<ProtectedString name="Source">--!strict
-- ShopPanel.luau
-- ==============
-- Magaza: aletler ve klinik yukseltmeleri. B tusu ile aciliyor.
--
-- Fiyat/seviye denetimi burada YAPILMIYOR, yalnizca gosteriliyor.
-- Satin almanin gecerliligine sunucu karar veriyor (Upgrades.luau);
-- buradaki &quot;kilitli&quot; gorunum bir kolaylik, bir guvenlik onlemi degil.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Shared = ReplicatedStorage:WaitForChild(&quot;VetShared&quot;)
local Loc = require(Shared.Loc)
local Net = require(Shared.Net)

local Theme = require(script.Parent.Theme)

local ShopPanel = {}

local widgets: any = nil
local open = false
local lastSignature = &quot;&quot;

local function entryCard(
	parent: Instance,
	order: number,
	nameKey: string,
	descKey: string?,
	price: number,
	owned: boolean,
	locked: boolean,
	unlockLevel: number,
	onBuy: () -&gt; ()
)
	local card = Theme.frame({
		name = nameKey,
		size = UDim2.new(1, -8, 0, if descKey ~= nil then 62 else 46),
		color = Theme.color.panelLight,
		transparency = 0.15,
		radius = 8,
		layoutOrder = order,
		parent = parent,
	})

	Theme.label({
		text = Loc.get(nameKey),
		size = UDim2.new(1, -110, 0, 20),
		position = UDim2.fromOffset(10, 6),
		textSize = 14,
		bold = true,
		color = if locked then Theme.color.textDim else Theme.color.text,
		parent = card,
	})

	if descKey ~= nil then
		Theme.label({
			text = Loc.get(descKey),
			size = UDim2.new(1, -110, 0, 30),
			position = UDim2.fromOffset(10, 26),
			textSize = 11,
			color = Theme.color.textDim,
			wrapped = true,
			parent = card,
		})
	end

	if owned then
		Theme.label({
			text = Loc.get(&quot;shop.owned&quot;),
			size = UDim2.fromOffset(92, 26),
			position = UDim2.new(1, -100, 0.5, 0),
			anchor = Vector2.new(0, 0.5),
			textSize = 13,
			bold = true,
			align = Enum.TextXAlignment.Center,
			color = Theme.color.good,
			parent = card,
		})
	elseif locked then
		Theme.label({
			text = Loc.get(&quot;shop.locked&quot;, unlockLevel),
			size = UDim2.fromOffset(92, 26),
			position = UDim2.new(1, -100, 0.5, 0),
			anchor = Vector2.new(0, 0.5),
			textSize = 12,
			bold = true,
			align = Enum.TextXAlignment.Center,
			color = Theme.color.textDim,
			parent = card,
		})
	else
		Theme.button({
			text = (&quot;%d TL&quot;):format(price),
			size = UDim2.fromOffset(92, 26),
			position = UDim2.new(1, -100, 0.5, 0),
			anchor = Vector2.new(0, 0.5),
			textSize = 13,
			color = Theme.color.accentDark,
			parent = card,
			onClick = onBuy,
		})
	end
end

function ShopPanel.create(parent: ScreenGui)
	local panel = Theme.frame({
		name = &quot;Magaza&quot;,
		size = UDim2.fromOffset(720, 440),
		position = UDim2.new(0.5, 0, 0.5, 0),
		anchor = Vector2.new(0.5, 0.5),
		transparency = 0.03,
		parent = parent,
		visible = false,
	})
	Theme.stroke(panel, Theme.color.accent, 2)

	Theme.label({
		text = Loc.get(&quot;shop.title&quot;),
		size = UDim2.new(1, -24, 0, 26),
		position = UDim2.fromOffset(16, 10),
		textSize = 20,
		bold = true,
		parent = panel,
	})
	Theme.button({
		name = &quot;Kapat&quot;,
		text = Loc.get(&quot;shop.close&quot;),
		size = UDim2.fromOffset(86, 26),
		position = UDim2.new(1, -102, 0, 10),
		color = Theme.color.panelLight,
		parent = panel,
		onClick = function()
			ShopPanel.setOpen(false)
		end,
	})

	Theme.label({
		text = Loc.get(&quot;shop.tools&quot;),
		size = UDim2.fromOffset(320, 20),
		position = UDim2.fromOffset(16, 44),
		textSize = 14,
		bold = true,
		color = Theme.color.accent,
		parent = panel,
	})
	Theme.label({
		text = Loc.get(&quot;shop.upgrades&quot;),
		size = UDim2.fromOffset(320, 20),
		position = UDim2.fromOffset(376, 44),
		textSize = 14,
		bold = true,
		color = Theme.color.accent,
		parent = panel,
	})

	local tools = Theme.scroller(panel, UDim2.fromOffset(340, 366), UDim2.fromOffset(16, 66))
	Theme.list(tools, 6)
	local upgrades = Theme.scroller(panel, UDim2.fromOffset(340, 366), UDim2.fromOffset(368, 66))
	Theme.list(upgrades, 6)

	widgets = { panel = panel, tools = tools, upgrades = upgrades }
end

function ShopPanel.setOpen(value: boolean)
	if widgets == nil then
		return
	end
	open = value
	widgets.panel.Visible = value
end

function ShopPanel.toggle()
	ShopPanel.setOpen(not open)
end

function ShopPanel.update(state: any)
	if widgets == nil or state == nil or state.ready ~= true or state.shop == nil then
		return
	end

	-- Liste yalnizca degistiyse yeniden kuruluyor: para her taburcuda
	-- degisiyor ve her seferinde dugmeleri yeniden yaratmak, oyuncunun
	-- tiklamaya calistigi dugmeyi altindan cekerdi.
	local signature = tostring(state.level) .. &quot;|&quot; .. tostring(state.money &gt;= 0)
	for _, tool in state.shop.tools do
		signature ..= tool.id .. (if tool.owned then &quot;1&quot; else &quot;0&quot;) .. (if tool.locked then &quot;L&quot; else &quot;-&quot;)
	end
	for _, upgrade in state.shop.upgrades do
		signature ..= upgrade.id .. (if upgrade.owned then &quot;1&quot; else &quot;0&quot;) .. (if upgrade.locked then &quot;L&quot; else &quot;-&quot;)
	end
	if signature == lastSignature then
		return
	end
	lastSignature = signature

	widgets.tools:ClearAllChildren()
	Theme.list(widgets.tools, 6)
	for index, tool in state.shop.tools do
		local id = tool.id
		entryCard(widgets.tools, index, tool.nameKey, nil, tool.price, tool.owned, tool.locked, tool.unlockLevel, function()
			Net.toServer(&quot;BuyTool&quot;, id)
		end)
	end

	widgets.upgrades:ClearAllChildren()
	Theme.list(widgets.upgrades, 6)
	for index, upgrade in state.shop.upgrades do
		local id = upgrade.id
		entryCard(
			widgets.upgrades,
			index,
			upgrade.nameKey,
			upgrade.descKey,
			upgrade.price,
			upgrade.owned,
			upgrade.locked,
			upgrade.unlockLevel,
			function()
				Net.toServer(&quot;BuyUpgrade&quot;, id)
			end
		)
	end
end

return ShopPanel
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX46">
					<Properties>
						<string name="Name">SurgeryPanel</string>
						<ProtectedString name="Source">--!strict
-- SurgeryPanel.luau
-- =================
-- Ameliyat mini-oyununun arayuzu. YALNIZCA CIZER: puanlama sunucuda.
--
-- Zamanlama
-- ---------
-- Sunucu adimlarin hedef zamanini SENKRON sunucu saatine gore yolluyor
-- (`workspace:GetServerTimeNow()`). Istemci ayni saati okudugu icin
-- isaretci sunucunun bekledigi anda tam ortadan geciyor; kendi
-- saatimizi kullansak gecikme kadar kayardi.

local RunService = game:GetService(&quot;RunService&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)
local Workspace = game:GetService(&quot;Workspace&quot;)

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Shared = ReplicatedStorage:WaitForChild(&quot;VetShared&quot;)
local Loc = require(Shared.Loc)
local Net = require(Shared.Net)

local Theme = require(script.Parent.Theme)

local SurgeryPanel = {}

local widgets: any = nil
local schedule: any = nil
local connection: RBXScriptConnection? = nil
local sentSteps: { [number]: boolean } = {}

local TRACK_WIDTH = 440

local function currentStep(now: number): number
	if schedule == nil then
		return 0
	end
	local raw = (now - schedule.startTime) / schedule.stepSeconds
	return math.clamp(math.floor(raw + 0.5), 1, schedule.steps)
end

local function stop()
	if connection ~= nil then
		connection:Disconnect()
		connection = nil
	end
	schedule = nil
	table.clear(sentSteps)
	if widgets ~= nil then
		widgets.panel.Visible = false
	end
end

local function press()
	if schedule == nil then
		return
	end
	local step = currentStep(Workspace:GetServerTimeNow())
	if step &lt; 1 or sentSteps[step] then
		return
	end
	sentSteps[step] = true
	Net.toServer(&quot;SurgeryInput&quot;, step)
end

function SurgeryPanel.create(parent: ScreenGui)
	local panel = Theme.frame({
		name = &quot;AmeliyatPaneli&quot;,
		size = UDim2.fromOffset(TRACK_WIDTH + 48, 168),
		position = UDim2.new(0.5, 0, 0.5, 0),
		anchor = Vector2.new(0.5, 0.5),
		transparency = 0.04,
		parent = parent,
		visible = false,
	})
	Theme.stroke(panel, Theme.color.accent, 2)

	Theme.label({
		text = Loc.get(&quot;surgery.title&quot;),
		size = UDim2.new(1, -24, 0, 24),
		position = UDim2.fromOffset(12, 10),
		textSize = 18,
		bold = true,
		align = Enum.TextXAlignment.Center,
		parent = panel,
	})
	local hint = Theme.label({
		name = &quot;Ipucu&quot;,
		text = Loc.get(&quot;surgery.hint&quot;),
		size = UDim2.new(1, -24, 0, 18),
		position = UDim2.fromOffset(12, 34),
		textSize = 12,
		color = Theme.color.textDim,
		align = Enum.TextXAlignment.Center,
		parent = panel,
	})

	local track = Theme.frame({
		name = &quot;Ray&quot;,
		size = UDim2.fromOffset(TRACK_WIDTH, 34),
		position = UDim2.new(0.5, 0, 0, 66),
		anchor = Vector2.new(0.5, 0),
		color = Theme.color.panelLight,
		transparency = 0,
		radius = 8,
		parent = panel,
	})

	local goodZone = Theme.frame({
		name = &quot;IyiBolge&quot;,
		size = UDim2.fromOffset(40, 34),
		position = UDim2.new(0.5, 0, 0, 0),
		anchor = Vector2.new(0.5, 0),
		color = Theme.color.accentDark,
		transparency = 0.25,
		radius = 6,
		parent = track,
	})
	local perfectZone = Theme.frame({
		name = &quot;TamBolge&quot;,
		size = UDim2.fromOffset(20, 34),
		position = UDim2.new(0.5, 0, 0, 0),
		anchor = Vector2.new(0.5, 0),
		color = Theme.color.good,
		transparency = 0.25,
		radius = 6,
		parent = track,
	})

	local marker = Theme.frame({
		name = &quot;Isaretci&quot;,
		size = UDim2.fromOffset(6, 44),
		position = UDim2.new(0, 0, 0.5, 0),
		anchor = Vector2.new(0.5, 0.5),
		color = Theme.color.text,
		transparency = 0,
		radius = 3,
		parent = track,
	})
	marker.ZIndex = 3

	local steps = Theme.label({
		name = &quot;Adim&quot;,
		text = &quot;&quot;,
		size = UDim2.new(1, -24, 0, 20),
		position = UDim2.fromOffset(12, 112),
		textSize = 14,
		bold = true,
		align = Enum.TextXAlignment.Center,
		parent = panel,
	})
	local grade = Theme.label({
		name = &quot;Not&quot;,
		text = &quot;&quot;,
		size = UDim2.new(1, -24, 0, 20),
		position = UDim2.fromOffset(12, 134),
		textSize = 14,
		bold = true,
		align = Enum.TextXAlignment.Center,
		parent = panel,
	})

	local button = Theme.button({
		name = &quot;Kes&quot;,
		text = &quot;&quot;,
		size = UDim2.fromScale(1, 1),
		color = Theme.color.panel,
		parent = panel,
		onClick = press,
	})
	button.BackgroundTransparency = 1
	button.ZIndex = 0

	widgets = {
		panel = panel,
		track = track,
		marker = marker,
		goodZone = goodZone,
		perfectZone = perfectZone,
		steps = steps,
		grade = grade,
		hint = hint,
	}

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or schedule == nil then
			return
		end
		if input.KeyCode == Enum.KeyCode.Space or input.UserInputType == Enum.UserInputType.MouseButton1 then
			press()
		end
	end)
end

--- Sunucu ameliyati baslatti.
function SurgeryPanel.begin(incoming: any)
	if widgets == nil then
		return
	end
	schedule = incoming
	table.clear(sentSteps)

	widgets.panel.Visible = true
	widgets.grade.Text = &quot;&quot;
	widgets.goodZone.Size = UDim2.fromOffset(
		math.max(8, TRACK_WIDTH * (incoming.goodWindow * 2 / incoming.stepSeconds)),
		34
	)
	widgets.perfectZone.Size = UDim2.fromOffset(
		math.max(6, TRACK_WIDTH * (incoming.perfectWindow * 2 / incoming.stepSeconds)),
		34
	)

	if connection ~= nil then
		connection:Disconnect()
	end
	connection = RunService.RenderStepped:Connect(function()
		if schedule == nil then
			return
		end
		local now = Workspace:GetServerTimeNow()
		local step = currentStep(now)
		local target = schedule.startTime + step * schedule.stepSeconds
		local ratio = math.clamp(0.5 + (now - target) / schedule.stepSeconds, 0, 1)

		widgets.marker.Position = UDim2.new(ratio, 0, 0.5, 0)
		widgets.steps.Text = Loc.get(&quot;surgery.step&quot;, step, schedule.steps)
	end)
end

--- Sunucu bir tiklamayi notlandirdi.
function SurgeryPanel.grade(grade: string)
	if widgets == nil then
		return
	end
	if grade == &quot;perfect&quot; then
		widgets.grade.Text = Loc.get(&quot;surgery.perfect&quot;)
		widgets.grade.TextColor3 = Theme.color.good
	elseif grade == &quot;good&quot; then
		widgets.grade.Text = Loc.get(&quot;surgery.good&quot;)
		widgets.grade.TextColor3 = Theme.color.accent
	else
		widgets.grade.Text = Loc.get(&quot;surgery.miss&quot;)
		widgets.grade.TextColor3 = Theme.color.bad
	end
end

function SurgeryPanel.finish()
	stop()
end

return SurgeryPanel
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX47">
					<Properties>
						<string name="Name">Theme</string>
						<ProtectedString name="Source">--!strict
-- Theme.luau
-- ==========
-- Arayuzun ortak gorunumu ve kucuk yapi yardimcilari.
--
-- Tek yerde toplanmasinin sebebi: paneller ayri ayri kurulursa her
-- birinde farkli bir gri, farkli bir kose yaricapi olusuyor ve arayuz
-- derme catma gorunuyor. Renk ve olcu kararlari burada, bir kez.

local Theme = {}

Theme.color = {
	panel = Color3.fromRGB(24, 28, 38),
	panelLight = Color3.fromRGB(34, 40, 52),
	panelHover = Color3.fromRGB(44, 52, 66),
	stroke = Color3.fromRGB(62, 72, 90),
	text = Color3.fromRGB(236, 242, 248),
	textDim = Color3.fromRGB(158, 170, 188),
	accent = Color3.fromRGB(72, 176, 176),
	accentDark = Color3.fromRGB(44, 124, 128),
	good = Color3.fromRGB(96, 196, 120),
	warn = Color3.fromRGB(232, 176, 72),
	bad = Color3.fromRGB(228, 96, 92),
	money = Color3.fromRGB(240, 206, 96),
	health = Color3.fromRGB(96, 196, 120),
	stress = Color3.fromRGB(226, 148, 76),
	xp = Color3.fromRGB(110, 168, 240),
}

Theme.font = Enum.Font.GothamMedium
Theme.fontBold = Enum.Font.GothamBold

function Theme.corner(parent: Instance, radius: number): UICorner
	local corner = Instance.new(&quot;UICorner&quot;)
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
	return corner
end

function Theme.stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	local stroke = Instance.new(&quot;UIStroke&quot;)
	stroke.Color = color or Theme.color.stroke
	stroke.Thickness = thickness or 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = parent
	return stroke
end

function Theme.padding(parent: Instance, amount: number): UIPadding
	local padding = Instance.new(&quot;UIPadding&quot;)
	padding.PaddingTop = UDim.new(0, amount)
	padding.PaddingBottom = UDim.new(0, amount)
	padding.PaddingLeft = UDim.new(0, amount)
	padding.PaddingRight = UDim.new(0, amount)
	padding.Parent = parent
	return padding
end

function Theme.list(parent: Instance, spacing: number, direction: Enum.FillDirection?): UIListLayout
	local layout = Instance.new(&quot;UIListLayout&quot;)
	layout.Padding = UDim.new(0, spacing)
	layout.FillDirection = direction or Enum.FillDirection.Vertical
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = parent
	return layout
end

export type FrameSpec = {
	name: string?,
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?,
	transparency: number?,
	radius: number?,
	parent: Instance?,
	layoutOrder: number?,
	visible: boolean?,
}

function Theme.frame(spec: FrameSpec): Frame
	local frame = Instance.new(&quot;Frame&quot;)
	frame.Name = spec.name or &quot;Frame&quot;
	frame.Size = spec.size
	frame.Position = spec.position or UDim2.fromOffset(0, 0)
	frame.AnchorPoint = spec.anchor or Vector2.new(0, 0)
	frame.BackgroundColor3 = spec.color or Theme.color.panel
	frame.BackgroundTransparency = spec.transparency or 0.08
	frame.BorderSizePixel = 0
	frame.LayoutOrder = spec.layoutOrder or 0
	frame.Visible = if spec.visible == nil then true else spec.visible
	frame.Parent = spec.parent
	if (spec.radius or 10) &gt; 0 then
		Theme.corner(frame, spec.radius or 10)
	end
	return frame
end

export type LabelSpec = {
	name: string?,
	text: string,
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?,
	textSize: number?,
	bold: boolean?,
	align: Enum.TextXAlignment?,
	parent: Instance?,
	layoutOrder: number?,
	wrapped: boolean?,
}

function Theme.label(spec: LabelSpec): TextLabel
	local label = Instance.new(&quot;TextLabel&quot;)
	label.Name = spec.name or &quot;Label&quot;
	label.Text = spec.text
	label.Size = spec.size
	label.Position = spec.position or UDim2.fromOffset(0, 0)
	label.AnchorPoint = spec.anchor or Vector2.new(0, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = spec.color or Theme.color.text
	label.TextSize = spec.textSize or 14
	label.Font = if spec.bold then Theme.fontBold else Theme.font
	label.TextXAlignment = spec.align or Enum.TextXAlignment.Left
	label.TextWrapped = spec.wrapped == true
	label.LayoutOrder = spec.layoutOrder or 0
	label.Parent = spec.parent
	return label
end

export type ButtonSpec = {
	name: string?,
	text: string,
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?,
	textColor: Color3?,
	textSize: number?,
	parent: Instance?,
	layoutOrder: number?,
	onClick: (() -&gt; ())?,
}

function Theme.button(spec: ButtonSpec): TextButton
	local button = Instance.new(&quot;TextButton&quot;)
	button.Name = spec.name or &quot;Button&quot;
	button.Text = spec.text
	button.Size = spec.size
	button.Position = spec.position or UDim2.fromOffset(0, 0)
	button.AnchorPoint = spec.anchor or Vector2.new(0, 0)
	button.BackgroundColor3 = spec.color or Theme.color.panelLight
	button.BackgroundTransparency = 0
	button.BorderSizePixel = 0
	button.TextColor3 = spec.textColor or Theme.color.text
	button.TextSize = spec.textSize or 14
	button.Font = Theme.fontBold
	button.AutoButtonColor = false
	button.LayoutOrder = spec.layoutOrder or 0
	button.Parent = spec.parent
	Theme.corner(button, 8)

	local base = button.BackgroundColor3
	button.MouseEnter:Connect(function()
		button.BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.14)
	end)
	button.MouseLeave:Connect(function()
		button.BackgroundColor3 = base
	end)
	if spec.onClick ~= nil then
		button.Activated:Connect(spec.onClick)
	end
	return button
end

export type Bar = { track: Frame, fill: Frame }

--- Ilerleme/saglik cubugu. `set(ratio)` ile guncelleniyor.
function Theme.bar(parent: Instance, size: UDim2, position: UDim2, color: Color3): Bar
	local track = Theme.frame({
		name = &quot;Track&quot;,
		size = size,
		position = position,
		color = Theme.color.panelLight,
		transparency = 0,
		radius = 6,
		parent = parent,
	})
	local fill = Theme.frame({
		name = &quot;Fill&quot;,
		size = UDim2.fromScale(0, 1),
		color = color,
		transparency = 0,
		radius = 6,
		parent = track,
	})
	return { track = track, fill = fill }
end

function Theme.setBar(bar: Bar, ratio: number)
	bar.fill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
end

--- Kaydirilabilir liste. Panellerin hepsi ayni davranssin diye.
function Theme.scroller(parent: Instance, size: UDim2, position: UDim2): ScrollingFrame
	local scroller = Instance.new(&quot;ScrollingFrame&quot;)
	scroller.Size = size
	scroller.Position = position
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.ScrollBarThickness = 4
	scroller.ScrollBarImageColor3 = Theme.color.stroke
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroller.CanvasSize = UDim2.fromOffset(0, 0)
	scroller.Parent = parent
	return scroller
end

--- Bildirim/durum rengi.
function Theme.kindColor(kind: string): Color3
	if kind == &quot;good&quot; then
		return Theme.color.good
	elseif kind == &quot;bad&quot; then
		return Theme.color.bad
	elseif kind == &quot;warn&quot; then
		return Theme.color.warn
	end
	return Theme.color.accent
end

return Theme
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX48">
					<Properties>
						<string name="Name">ToolBar</string>
						<ProtectedString name="Source">--!strict
-- ToolBar.luau
-- ============
-- Ekranin altindaki alet cubugu. Tiklamak ya da 1-6 tuslari aleti
-- DOGRUDAN kullanir; ayrica bir &quot;sec sonra uygula&quot; adimi yok, cunku
-- muayenede her tiklama bir islem.

local UserInputService = game:GetService(&quot;UserInputService&quot;)

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Shared = ReplicatedStorage:WaitForChild(&quot;VetShared&quot;)
local Loc = require(Shared.Loc)
local Net = require(Shared.Net)

local Theme = require(script.Parent.Theme)

local ToolBar = {}

local container: Frame? = nil
local buttons: { TextButton } = {}
local toolIds: { string } = {}
local selected = 1

local KEYS = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6,
}

local function highlight()
	for index, button in buttons do
		local active = index == selected
		button.BackgroundColor3 = if active then Theme.color.accentDark else Theme.color.panelLight
		button.TextColor3 = if active then Theme.color.text else Theme.color.textDim
	end
end

local function use(index: number)
	local toolId = toolIds[index]
	if toolId == nil then
		return
	end
	selected = index
	highlight()
	Net.toServer(&quot;SelectTool&quot;, toolId)
	Net.toServer(&quot;UseTool&quot;, toolId)
end

function ToolBar.create(parent: ScreenGui)
	local frame = Theme.frame({
		name = &quot;AletCubugu&quot;,
		size = UDim2.fromOffset(560, 66),
		position = UDim2.new(0.5, 0, 1, -16),
		anchor = Vector2.new(0.5, 1),
		parent = parent,
	})
	Theme.stroke(frame)
	Theme.padding(frame, 8)
	local layout = Theme.list(frame, 8, Enum.FillDirection.Horizontal)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	container = frame

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		local index = KEYS[input.KeyCode]
		if index ~= nil then
			use(index)
		end
	end)
end

--- Alet listesini sunucudan gelen duruma gore yeniden kurar.
function ToolBar.update(state: any)
	if container == nil or state == nil or state.ready ~= true then
		return
	end

	local same = #state.tools == #toolIds
	if same then
		for index, tool in state.tools do
			if toolIds[index] ~= tool.id then
				same = false
				break
			end
		end
	end
	if same then
		return -- degismedi; her karede arayuzu yeniden kurmanin anlami yok
	end

	for _, button in buttons do
		button:Destroy()
	end
	buttons = {}
	toolIds = {}

	for index, tool in state.tools do
		table.insert(toolIds, tool.id)
		local button = Theme.button({
			name = tool.id,
			text = (&quot;%d  %s&quot;):format(index, Loc.get(tool.nameKey)),
			size = UDim2.fromOffset(84, 50),
			layoutOrder = index,
			parent = container,
			onClick = function()
				use(index)
			end,
		})
		button.TextWrapped = true
		button.TextSize = 12
		table.insert(buttons, button)
	end

	selected = math.clamp(selected, 1, math.max(#buttons, 1))
	highlight()
end

return ToolBar
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX49">
					<Properties>
						<string name="Name">TreatmentPanel</string>
						<ProtectedString name="Source">--!strict
-- TreatmentPanel.luau
-- ===================
-- Tedavi paneli. Teshis konduktan SONRA aciliyor.
--
-- Gereken tedaviler ustte isaretli listede; alttaki dugmeler oyuncunun
-- acabildigi butun tedaviler. Yanlis tedavi uygulamak serbest (ve
-- cezali): listeyi yalnizca dogru tedavilerle doldurmak bulmacayi
-- ortadan kaldirirdi.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Shared = ReplicatedStorage:WaitForChild(&quot;VetShared&quot;)
local Loc = require(Shared.Loc)
local Net = require(Shared.Net)

local Theme = require(script.Parent.Theme)

local TreatmentPanel = {}

local widgets: any = nil
local builtSignature = &quot;&quot;

function TreatmentPanel.create(parent: ScreenGui)
	local panel = Theme.frame({
		name = &quot;TedaviPaneli&quot;,
		size = UDim2.fromOffset(330, 250),
		position = UDim2.new(1, -16, 0, 358),
		anchor = Vector2.new(1, 0),
		parent = parent,
		visible = false,
	})
	Theme.stroke(panel)

	Theme.label({
		text = Loc.get(&quot;treatment.title&quot;),
		size = UDim2.new(1, -24, 0, 22),
		position = UDim2.fromOffset(12, 8),
		textSize = 16,
		bold = true,
		parent = panel,
	})

	local required = Theme.frame({
		name = &quot;Gereken&quot;,
		size = UDim2.new(1, -24, 0, 62),
		position = UDim2.fromOffset(12, 32),
		color = Theme.color.panelLight,
		transparency = 0.2,
		radius = 8,
		parent = panel,
	})
	Theme.padding(required, 6)
	Theme.list(required, 2)

	local buttons = Theme.scroller(panel, UDim2.new(1, -24, 1, -106), UDim2.fromOffset(12, 100))
	local grid = Instance.new(&quot;UIGridLayout&quot;)
	grid.CellSize = UDim2.fromOffset(96, 32)
	grid.CellPadding = UDim2.fromOffset(6, 6)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = buttons

	widgets = { panel = panel, required = required, buttons = buttons }
end

function TreatmentPanel.update(chart: any, state: any)
	if widgets == nil then
		return
	end

	local show = chart ~= nil and chart.present == true and chart.diagnosed == true
	widgets.panel.Visible = show
	if not show then
		builtSignature = &quot;&quot;
		return
	end

	-- Gereken tedaviler: her guncellemede yenileniyor (isaretler degisiyor).
	widgets.required:ClearAllChildren()
	Theme.padding(widgets.required, 6)
	Theme.list(widgets.required, 2)
	for index, item in chart.required do
		Theme.label({
			text = (if item.applied then &quot;✓ &quot; else &quot;○ &quot;) .. Loc.get(item.nameKey),
			size = UDim2.new(1, 0, 0, 16),
			textSize = 12,
			bold = item.applied,
			color = if item.applied then Theme.color.good else Theme.color.textDim,
			layoutOrder = index,
			parent = widgets.required,
		})
	end

	-- Dugmeler yalnizca acilan tedavi kumesi degistiginde kuruluyor.
	if state == nil or state.ready ~= true then
		return
	end
	local signature = &quot;&quot;
	for _, treatment in state.treatments do
		signature ..= treatment.id .. &quot;:&quot; .. tostring(treatment.cost) .. &quot;;&quot;
	end
	if signature == builtSignature then
		return
	end
	builtSignature = signature

	widgets.buttons:ClearAllChildren()
	local grid = Instance.new(&quot;UIGridLayout&quot;)
	grid.CellSize = UDim2.fromOffset(96, 32)
	grid.CellPadding = UDim2.fromOffset(6, 6)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = widgets.buttons

	for index, treatment in state.treatments do
		local id = treatment.id
		local button = Theme.button({
			name = id,
			text = (&quot;%s\n%d TL&quot;):format(Loc.get(treatment.nameKey), treatment.cost),
			size = UDim2.fromOffset(96, 32),
			textSize = 11,
			layoutOrder = index,
			parent = widgets.buttons,
			onClick = function()
				Net.toServer(&quot;ApplyTreatment&quot;, id)
			end,
		})
		button.TextWrapped = true
	end
end

return TreatmentPanel
</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="StarterGui" referent="RBX50">
		<Properties>
			<string name="Name">StarterGui</string>
			<bool name="ResetPlayerGuiOnSpawn">false</bool>
		</Properties>
	</Item>
	<Item class="Players" referent="RBX51">
		<Properties>
			<string name="Name">Players</string>
			<bool name="CharacterAutoLoads">false</bool>
		</Properties>
	</Item>
