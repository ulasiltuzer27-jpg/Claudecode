				<Item class="ModuleScript" referent="RBX25">
					<Properties>
						<string name="Name">Diagnosis</string>
						<ProtectedString name="Source">--!strict
-- Diagnosis.luau
-- ==============
-- Alet -&gt; semptom -&gt; hastalik cikarimi. SUNUCU OTORITER.
--
-- Hastaligin kimligi ISTEMCIYE HIC GITMIYOR
-- -----------------------------------------
-- Istemciye yalnizca BULUNMUS semptomlar yollaniyor. Hastaligi istemciye
-- yollayip &quot;gostermezsin&quot; demek, oynanisi bir bellek okumasiyla
-- cozulebilir hale getirirdi. Tahmin sunucuda karsilastiriliyor.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Data = ReplicatedStorage:WaitForChild(&quot;VetData&quot;)

local conditionData = require(Data.conditions)
local symptomData = require(Data.symptoms)

local Diagnosis = {}

local conditionById: { [string]: any } = {}
for _, condition in conditionData.conditions do
	conditionById[condition.id] = condition
end

local symptomById: { [string]: any } = {}
for _, symptom in symptomData.symptoms do
	symptomById[symptom.id] = symptom
end

-- Alet -&gt; o aletin actigi semptomlar. Veri tablosundan bir kez kuruluyor.
local symptomsByTool: { [string]: { string } } = {}
for _, symptom in symptomData.symptoms do
	local list = symptomsByTool[symptom.revealedBy]
	if list == nil then
		list = {}
		symptomsByTool[symptom.revealedBy] = list
	end
	table.insert(list, symptom.id)
end

function Diagnosis.condition(id: string): any?
	return conditionById[id]
end

function Diagnosis.symptom(id: string): any?
	return symptomById[id]
end

function Diagnosis.allConditions(): { any }
	return conditionData.conditions
end

function Diagnosis.allSymptoms(): { any }
	return symptomData.symptoms
end

--- Bir turun, verilen seviyede yakalanabilecegi hastaliklar.
function Diagnosis.conditionsFor(animalId: string, level: number): { any }
	local result = {}
	for _, condition in conditionData.conditions do
		if condition.unlockLevel &gt; level then
			continue
		end
		for _, species in condition.species do
			if species == animalId then
				table.insert(result, condition)
				break
			end
		end
	end
	return result
end

--- Aletin bu hastada ACABILECEGI semptomlar (henuz bulunmamis olanlar).
--- Alet hastaligin hicbir semptomunu acmiyorsa bos liste doner - bu bir
--- hata degil, &quot;bu alette bir sey cikmadi&quot; sonucu.
function Diagnosis.revealWith(revealed: { [string]: boolean }, conditionId: string, toolId: string): { string }
	local condition = conditionById[conditionId]
	if condition == nil then
		return {}
	end

	local toolSymptoms = symptomsByTool[toolId]
	if toolSymptoms == nil then
		return {}
	end

	local found = {}
	for _, symptomId in condition.symptoms do
		if revealed[symptomId] == true then
			continue
		end
		for _, candidate in toolSymptoms do
			if candidate == symptomId then
				table.insert(found, symptomId)
				break
			end
		end
	end
	return found
end

--- Bu hastaligin butun semptomlari bulundu mu? Tahmin dugmesini acmak
--- icin degil (oyuncu erken tahmin edebilir), arayuzde ipucu gostermek icin.
function Diagnosis.allRevealed(revealed: { [string]: boolean }, conditionId: string): boolean
	local condition = conditionById[conditionId]
	if condition == nil then
		return false
	end
	for _, symptomId in condition.symptoms do
		if revealed[symptomId] ~= true then
			return false
		end
	end
	return true
end

--- Tahmin dogru mu?
function Diagnosis.check(conditionId: string, guessId: string): boolean
	return conditionId == guessId
end

--- Semptomu hangi alet aciyor? Arayuz &quot;hangi aleti almaliyim&quot; ipucu icin.
function Diagnosis.toolFor(symptomId: string): string?
	local symptom = symptomById[symptomId]
	return if symptom ~= nil then symptom.revealedBy else nil
end

return Diagnosis
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX26">
					<Properties>
						<string name="Name">Economy</string>
						<ProtectedString name="Source">--!strict
-- Economy.luau
-- ============
-- Ucret, XP, seviye ve itibar hesaplari. SAF FONKSIYONLAR: girdi profil
-- ve veri tablolari, cikti sayi. Yan etkisi yok.
--
-- Neden saf?
-- ----------
-- Studio'ya erisimimiz yok, dengeyi oynayarak ayarlayamiyoruz. Butun
-- hesap saf fonksiyonlarda oldugu icin tools/simulate_economy.py ayni
-- formulleri Python'da yeniden kurup ilerleme egrisini BASSIZ
-- dogrulayabiliyor. Hesap modullere dagilmis olsaydi bu mumkun olmazdi.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Data = ReplicatedStorage:WaitForChild(&quot;VetData&quot;)

local economy = require(Data.economy)

local Economy = {}

Economy.MAX_LEVEL = #economy.levels

--- Bir seviyeye ulasmak icin gereken toplam XP.
function Economy.xpForLevel(level: number): number
	local clamped = math.clamp(level, 1, Economy.MAX_LEVEL)
	return economy.levels[clamped].xp
end

--- Verilen XP hangi seviyeye denk gelir?
function Economy.levelForXp(xp: number): number
	local level = 1
	for _, row in economy.levels do
		if xp &gt;= row.xp then
			level = row.level
		else
			break
		end
	end
	return level
end

function Economy.titleKeyForLevel(level: number): string
	local clamped = math.clamp(level, 1, Economy.MAX_LEVEL)
	return economy.levels[clamped].titleKey
end

--- Sonraki seviyeye ilerleme (0..1). Son seviyede 1.
function Economy.levelProgress(xp: number): number
	local level = Economy.levelForXp(xp)
	if level &gt;= Economy.MAX_LEVEL then
		return 1
	end
	local current = Economy.xpForLevel(level)
	local upper = Economy.xpForLevel(level + 1)
	if upper &lt;= current then
		return 1
	end
	return math.clamp((xp - current) / (upper - current), 0, 1)
end

--- Itibarin ucrete etkisi: reputationFeeFloor ile reputationFeeCeil
--- arasinda dogrusal.
function Economy.reputationMultiplier(reputation: number): number
	local span = economy.reputation.max - economy.reputation.min
	local ratio = if span &lt;= 0 then 0 else (reputation - economy.reputation.min) / span
	ratio = math.clamp(ratio, 0, 1)
	local floor = economy.fee.reputationFeeFloor
	local ceil = economy.fee.reputationFeeCeil
	return floor + (ceil - floor) * ratio
end

export type FeeInput = {
	baseFee: number,
	feeMultiplier: number,
	reputation: number,
	health: number,
	feeBonus: number,
}

--- Taburcu ucreti. Hayvanin sagligi ucretin healthShare kadarlik
--- kismini belirliyor: yarim iyilestirilmis hayvan tam para etmiyor.
function Economy.fee(input: FeeInput): number
	local healthRatio = math.clamp(input.health / 100, 0, 1)
	local healthFactor = (1 - economy.fee.healthShare) + economy.fee.healthShare * healthRatio
	local raw = input.baseFee
		* input.feeMultiplier
		* Economy.reputationMultiplier(input.reputation)
		* input.feeBonus
		* healthFactor
	return math.max(economy.fee.minimumFee, math.floor(raw + 0.5))
end

function Economy.clampReputation(value: number): number
	return math.clamp(value, economy.reputation.min, economy.reputation.max)
end

--- Hasta gelme araligi. En iyi itibar ve klinik yukseltmeleri kisaltir.
function Economy.arrivalSeconds(bestReputation: number, arrivalScale: number): number
	local span = economy.reputation.max - economy.reputation.min
	local ratio = if span &lt;= 0 then 0 else (bestReputation - economy.reputation.min) / span
	ratio = math.clamp(ratio, 0, 1)
	local seconds = economy.arrival.baseSeconds * (1 - economy.arrival.reputationSpeedup * ratio) * arrivalScale
	return math.max(economy.arrival.minSeconds, seconds)
end

--- Ham veri tablosuna erisim (SelfTest ve digerleri icin tek nokta).
function Economy.table(): any
	return economy
end

return Economy
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX27">
					<Properties>
						<string name="Name">PatientFlow</string>
						<ProtectedString name="Source">--!strict
-- PatientFlow.luau
-- ================
-- Hastanin butun yasam dongusu: gelis, kuyruk, masaya alinma, teshis,
-- tedavi, taburcu. SUNUCU OTORITER - istemci yalnizca niyet bildirir.
--
-- Hastaligin kimligi sunucuda kalir
-- ---------------------------------
-- `patient.conditionId` istemciye ANCAK dogru teshisten sonra gidiyor.
-- Oncesinde istemci yalnizca BULUNMUS semptomlari goruyor.
--
-- Kuyruk paylasilir, odul taburcu edene
-- -------------------------------------
-- Klinik tek; kuyruk butun oyuncularin ortak kuyrugu. Bir hastayi
-- masaya alan oyuncu onun &quot;sahibi&quot; olur ve odulu o alir. Boylece cok
-- oyunculu oturumda iki veteriner ayni hastayi cekistirmez.

local Players = game:GetService(&quot;Players&quot;)

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Shared = ReplicatedStorage:WaitForChild(&quot;VetShared&quot;)
local Data = ReplicatedStorage:WaitForChild(&quot;VetData&quot;)

local Net = require(Shared.Net)

local AnimalAnimator = require(script.Parent.Parent.world.AnimalAnimator)
local AnimalFactory = require(script.Parent.Parent.world.AnimalFactory)
local Clinic = require(script.Parent.Parent.world.Clinic)
local Diagnosis = require(script.Parent.Diagnosis)
local Economy = require(script.Parent.Economy)
local Profile = require(script.Parent.Profile)
local Surgery = require(script.Parent.Surgery)
local Treatment = require(script.Parent.Treatment)
local Upgrades = require(script.Parent.Upgrades)

local economy = require(Data.economy)

local PatientFlow = {}

-- Oyuncunun bir istasyonda islem yapabilmesi icin gereken yakinlik.
-- Sunucuda denetleniyor: istemcinin &quot;yanindayim&quot; demesine guvenilmiyor.
local STATION_RADIUS = 16
local VITALS_TICK = 0.25

export type Patient = {
	id: number,
	animalId: string,
	conditionId: string,
	rig: AnimalFactory.Rig,
	health: number,
	stress: number,
	revealed: { [string]: boolean },
	toolsUsed: { [string]: boolean },
	diagnosed: boolean,
	treatmentsDone: { [string]: boolean },
	owner: Player?,
	stationId: string?,
	state: string,
	arrivedAt: number,
	busyUntil: number,
	queueSlot: number?,
}

local clinic: Clinic.Built? = nil
local patientsFolder: Folder? = nil

local patients: { [number]: Patient } = {}
local activeOf: { [Player]: number } = {}
local occupiedStation: { [string]: number } = {}
local usedQueueSlots: { [number]: boolean } = {}

local nextPatientId = 1
local started = false

-- ── Yardimcilar ───────────────────────────────────────────────────────

local function notify(player: Player, kind: string, messageKey: string, args: { any }?)
	Net.toPlayer(&quot;Notify&quot;, player, kind, messageKey, args or {})
end

local function notifyAll(kind: string, messageKey: string, args: { any }?)
	for _, player in Players:GetPlayers() do
		notify(player, kind, messageKey, args)
	end
end

local function bestReputation(): number
	local best = economy.reputation.min
	for _, player in Players:GetPlayers() do
		local entry = Profile.get(player)
		if entry ~= nil then
			best = math.max(best, entry.data.reputation)
		end
	end
	return best
end

local function highestLevel(): number
	local best = 1
	for _, player in Players:GetPlayers() do
		local entry = Profile.get(player)
		if entry ~= nil then
			best = math.max(best, entry.data.level)
		end
	end
	return best
end

local function queueSlotCount(): number
	local clinicEffects = Upgrades.clinicEffects(Players:GetPlayers())
	local total = economy.arrival.queueSlots + clinicEffects.queueSlots
	local available = if clinic ~= nil then #clinic.queuePoints else 0
	return math.min(total, available)
end

local function waitingCount(): number
	local total = 0
	for _, patient in patients do
		if patient.state == &quot;waiting&quot; or patient.state == &quot;arriving&quot; then
			total += 1
		end
	end
	return total
end

local function freeQueueSlot(): number?
	local limit = queueSlotCount()
	for slot = 1, limit do
		if usedQueueSlots[slot] ~= true then
			return slot
		end
	end
	return nil
end

--- Oyuncu bu istasyona yeterince yakin mi? Karakteri yoksa hayir.
local function nearStation(player: Player, stationId: string): boolean
	if clinic == nil then
		return false
	end
	local station = clinic.stations[stationId]
	if station == nil then
		return false
	end
	local character = player.Character
	if character == nil then
		return false
	end
	local root = character:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if root == nil or not root:IsA(&quot;BasePart&quot;) then
		return false
	end
	local flat = Vector3.new(root.Position.X, 0, root.Position.Z)
	local target = Vector3.new(station.cframe.Position.X, 0, station.cframe.Position.Z)
	return (flat - target).Magnitude &lt;= STATION_RADIUS
end

--- Oyuncuya en yakin istasyon. Hicbiri menzilde degilse nil.
local function nearestStation(player: Player): string?
	if clinic == nil then
		return nil
	end
	local best: string? = nil
	local bestDistance = math.huge
	local character = player.Character
	if character == nil then
		return nil
	end
	local root = character:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if root == nil or not root:IsA(&quot;BasePart&quot;) then
		return nil
	end

	for id, station in clinic.stations do
		local flat = Vector3.new(root.Position.X, 0, root.Position.Z)
		local target = Vector3.new(station.cframe.Position.X, 0, station.cframe.Position.Z)
		local distance = (flat - target).Magnitude
		if distance &lt;= STATION_RADIUS and distance &lt; bestDistance then
			best = id
			bestDistance = distance
		end
	end
	return best
end

local function patientOf(player: Player): Patient?
	local id = activeOf[player]
	if id == nil then
		return nil
	end
	return patients[id]
end

-- ── Istemciye yollanan goruntuler ─────────────────────────────────────

local function chartSnapshot(patient: Patient?, viewer: Player): any
	if patient == nil then
		return { present = false }
	end

	local revealed = {}
	for symptomId in patient.revealed do
		local symptom = Diagnosis.symptom(symptomId)
		table.insert(revealed, {
			id = symptomId,
			nameKey = if symptom ~= nil then symptom.nameKey else symptomId,
			severity = if symptom ~= nil then symptom.severity else 1,
		})
	end

	local animal = AnimalFactory.spec(patient.animalId)
	local entry = Profile.get(viewer)
	local level = if entry ~= nil then entry.data.level else 1

	-- Teshis adaylari: bu turun, bu seviyede gorulebilecek hastaliklari.
	local candidates = {}
	for _, condition in Diagnosis.conditionsFor(patient.animalId, level) do
		table.insert(candidates, { id = condition.id, nameKey = condition.nameKey })
	end

	local required = {}
	local done = {}
	if patient.diagnosed then
		for _, treatmentId in Treatment.requiredFor(patient.conditionId) do
			local treatment = Treatment.get(treatmentId)
			table.insert(required, {
				id = treatmentId,
				nameKey = if treatment ~= nil then treatment.nameKey else treatmentId,
				kind = if treatment ~= nil then treatment.kind else &quot;&quot;,
				applied = patient.treatmentsDone[treatmentId] == true,
			})
		end
	end
	for treatmentId in patient.treatmentsDone do
		table.insert(done, treatmentId)
	end

	local condition = if patient.diagnosed then Diagnosis.condition(patient.conditionId) else nil

	return {
		present = true,
		id = patient.id,
		animalId = patient.animalId,
		nameKey = if animal ~= nil then animal.nameKey else patient.animalId,
		health = math.floor(patient.health + 0.5),
		stress = math.floor(patient.stress + 0.5),
		revealed = revealed,
		candidates = candidates,
		diagnosed = patient.diagnosed,
		-- Hastaligin adi ANCAK dogru teshisten sonra gidiyor.
		conditionNameKey = if condition ~= nil then condition.nameKey else nil,
		required = required,
		done = done,
		stationId = patient.stationId,
		complete = patient.diagnosed and Treatment.isComplete(patient.treatmentsDone, patient.conditionId),
		dischargeHealth = economy.patient.dischargeHealth,
	}
end

local function pushChart(player: Player)
	Net.toPlayer(&quot;ChartUpdate&quot;, player, chartSnapshot(patientOf(player), player))
end

local function stateSnapshot(player: Player): any
	local entry = Profile.get(player)
	if entry == nil then
		return { ready = false }
	end
	local data = entry.data

	local tools = {}
	for _, tool in Upgrades.allTools() do
		if data.tools[tool.id] == true and data.level &gt;= tool.unlockLevel then
			table.insert(tools, { id = tool.id, nameKey = tool.nameKey, order = tool.order, useSeconds = tool.useSeconds })
		end
	end
	table.sort(tools, function(a, b)
		return a.order &lt; b.order
	end)

	local effects = Upgrades.effectsOf(data)
	local treatments = {}
	for _, treatment in Treatment.all() do
		if data.level &gt;= treatment.unlockLevel then
			table.insert(treatments, {
				id = treatment.id,
				nameKey = treatment.nameKey,
				kind = treatment.kind,
				order = treatment.order,
				cost = Treatment.cost(treatment.id, effects.supplyDiscount),
			})
		end
	end
	table.sort(treatments, function(a, b)
		return a.order &lt; b.order
	end)

	return {
		ready = true,
		money = data.money,
		xp = data.xp,
		level = data.level,
		maxLevel = Economy.MAX_LEVEL,
		titleKey = Economy.titleKeyForLevel(data.level),
		progress = Economy.levelProgress(data.xp),
		reputation = data.reputation,
		transient = entry.transient,
		stats = data.stats,
		tools = tools,
		treatments = treatments,
		queueWaiting = waitingCount(),
		queueSlots = queueSlotCount(),
		shop = Upgrades.shopSnapshot(data),
	}
end

local function pushState(player: Player)
	Net.toPlayer(&quot;StateUpdate&quot;, player, stateSnapshot(player))
end

function PatientFlow.pushState(player: Player)
	pushState(player)
	pushChart(player)
end

local function pushStateAll()
	for _, player in Players:GetPlayers() do
		pushState(player)
	end
end

-- ── Hasta uretimi ─────────────────────────────────────────────────────

--- Seviyeye uygun (tur, hastalik) cifti secer. Hicbir cift yoksa nil.
local function pickCase(level: number): (string?, string?)
	local candidates = {}
	for _, animalId in AnimalFactory.allIds() do
		local animal = AnimalFactory.spec(animalId)
		if animal == nil or animal.unlockLevel &gt; level then
			continue
		end
		for _, condition in Diagnosis.conditionsFor(animalId, level) do
			table.insert(candidates, { animalId, condition.id })
		end
	end
	if #candidates == 0 then
		return nil, nil
	end
	local pick = candidates[math.random(1, #candidates)]
	return pick[1], pick[2]
end

local function updateNameplate(patient: Patient)
	local frame = patient.rig.nameplate:FindFirstChild(&quot;Frame&quot;)
	if frame == nil then
		return
	end
	local health = frame:FindFirstChild(&quot;Saglik&quot;)
	local stress = frame:FindFirstChild(&quot;Stres&quot;)
	if health ~= nil then
		local fill = health:FindFirstChild(&quot;Dolgu&quot;)
		if fill ~= nil and fill:IsA(&quot;Frame&quot;) then
			fill.Size = UDim2.fromScale(math.clamp(patient.health / 100, 0, 1), 1)
		end
	end
	if stress ~= nil then
		local fill = stress:FindFirstChild(&quot;Dolgu&quot;)
		if fill ~= nil and fill:IsA(&quot;Frame&quot;) then
			fill.Size = UDim2.fromScale(math.clamp(patient.stress / 100, 0, 1), 1)
		end
	end
end

local function spawnPatient()
	if clinic == nil or patientsFolder == nil then
		return
	end

	local slot = freeQueueSlot()
	if slot == nil then
		return -- bekleme yeri dolu
	end

	local animalId, conditionId = pickCase(highestLevel())
	if animalId == nil or conditionId == nil then
		warn(&quot;[PatientFlow] bu seviyede uygun hasta bulunamadi - veri tablolarini kontrol edin&quot;)
		return
	end

	local spawnAt = CFrame.new(clinic.entranceOutside + Vector3.new(math.random(-6, 6), 0, -14))
	local rig = AnimalFactory.create(animalId, spawnAt, patientsFolder)
	if rig == nil then
		return
	end

	local id = nextPatientId
	nextPatientId += 1

	local patient: Patient = {
		id = id,
		animalId = animalId,
		conditionId = conditionId,
		rig = rig,
		health = math.random(economy.patient.startHealthMin, economy.patient.startHealthMax),
		stress = math.random(economy.patient.startStressMin, economy.patient.startStressMax),
		revealed = {},
		toolsUsed = {},
		diagnosed = false,
		treatmentsDone = {},
		owner = nil,
		stationId = nil,
		state = &quot;arriving&quot;,
		arrivedAt = os.clock(),
		busyUntil = 0,
		queueSlot = slot,
	}
	patients[id] = patient
	usedQueueSlots[slot] = true

	AnimalAnimator.register(rig)
	AnimalAnimator.setStress(rig, patient.stress)

	-- Topallayan hastalik gozle belli olsun: oyuncu daha aleti eline
	-- almadan &quot;bacakta bir sey var&quot; diyebilmeli.
	local condition = Diagnosis.condition(conditionId)
	if condition ~= nil then
		for _, symptomId in condition.symptoms do
			if symptomId == &quot;limp&quot; then
				AnimalAnimator.setLimp(rig, math.random(1, 4), 0.8)
				break
			end
		end
	end

	local queuePoint = clinic.queuePoints[slot]
	AnimalAnimator.walkPath(rig, {
		clinic.entranceOutside,
		clinic.entranceInside,
		queuePoint.Position,
	}, function()
		if patients[id] ~= nil and patients[id].state == &quot;arriving&quot; then
			patients[id].state = &quot;waiting&quot;
		end
	end)

	updateNameplate(patient)
	notifyAll(&quot;info&quot;, &quot;notify.patientArrived&quot;, { animalId })
	pushStateAll()
end

local function releasePatient(patient: Patient)
	if patient.queueSlot ~= nil then
		usedQueueSlots[patient.queueSlot] = nil
	end
	if patient.stationId ~= nil then
		occupiedStation[patient.stationId] = nil
	end
	local owner = patient.owner
	if owner ~= nil and activeOf[owner] == patient.id then
		activeOf[owner] = nil
		Surgery.cancel(owner)
	end
	patients[patient.id] = nil

	AnimalAnimator.unregister(patient.rig)
	patient.rig.model:Destroy()
end

--- Hasta klinigi terk eder (taburcu ya da bekleyip kacti).
local function sendAway(patient: Patient, walkOut: boolean)
	if clinic == nil then
		releasePatient(patient)
		return
	end

	patient.state = &quot;leaving&quot;
	if patient.queueSlot ~= nil then
		usedQueueSlots[patient.queueSlot] = nil
		patient.queueSlot = nil
	end
	if patient.stationId ~= nil then
		occupiedStation[patient.stationId] = nil
		patient.stationId = nil
	end
	local owner = patient.owner
	if owner ~= nil and activeOf[owner] == patient.id then
		activeOf[owner] = nil
		Surgery.cancel(owner)
	end

	if not walkOut then
		releasePatient(patient)
		return
	end

	AnimalAnimator.setLimp(patient.rig, 0, 0)
	AnimalAnimator.walkPath(patient.rig, {
		clinic.entranceInside,
		clinic.entranceOutside,
		clinic.entranceOutside + Vector3.new(0, 0, -30),
	}, function()
		local current = patients[patient.id]
		if current ~= nil then
			releasePatient(current)
		end
	end)
end

-- ── Oyuncu eylemleri ──────────────────────────────────────────────────

--- Siradaki hastayi masaya alir; oyuncunun elinde hasta varsa onu
--- yakindaki baska istasyona tasir.
function PatientFlow.callNext(player: Player)
	if clinic == nil then
		return
	end

	local stationId = nearestStation(player)
	if stationId == nil then
		notify(player, &quot;warn&quot;, &quot;notify.notAtStation&quot;)
		return
	end

	local existing = patientOf(player)
	if existing ~= nil then
		-- Zaten bir hastasi var: onu buraya tasi.
		if existing.stationId == stationId then
			notify(player, &quot;info&quot;, &quot;notify.alreadyHere&quot;)
			return
		end
		if occupiedStation[stationId] ~= nil then
			notify(player, &quot;warn&quot;, &quot;notify.stationBusy&quot;)
			return
		end
		if existing.stationId ~= nil then
			occupiedStation[existing.stationId] = nil
		end
		occupiedStation[stationId] = existing.id
		existing.stationId = stationId
		local station = clinic.stations[stationId]
		AnimalAnimator.placeAt(existing.rig, station.cframe * CFrame.new(0, 3.6, 0))
		notify(player, &quot;info&quot;, &quot;notify.patientMoved&quot;)
		pushChart(player)
		return
	end

	if occupiedStation[stationId] ~= nil then
		notify(player, &quot;warn&quot;, &quot;notify.stationBusy&quot;)
		return
	end

	-- Kuyrukta en uzun bekleyen, sahipsiz hastayi al.
	local chosen: Patient? = nil
	for _, patient in patients do
		if patient.owner == nil and (patient.state == &quot;waiting&quot; or patient.state == &quot;arriving&quot;) then
			if chosen == nil or patient.arrivedAt &lt; chosen.arrivedAt then
				chosen = patient
			end
		end
	end

	if chosen == nil then
		notify(player, &quot;info&quot;, &quot;notify.queueEmpty&quot;)
		return
	end

	chosen.owner = player
	chosen.state = &quot;station&quot;
	chosen.stationId = stationId
	if chosen.queueSlot ~= nil then
		usedQueueSlots[chosen.queueSlot] = nil
		chosen.queueSlot = nil
	end
	occupiedStation[stationId] = chosen.id
	activeOf[player] = chosen.id

	local station = clinic.stations[stationId]
	AnimalAnimator.placeAt(chosen.rig, station.cframe * CFrame.new(0, 3.6, 0))

	notify(player, &quot;good&quot;, &quot;notify.patientTaken&quot;)
	pushState(player)
	pushChart(player)
	pushStateAll()
end

function PatientFlow.useTool(player: Player, toolId: string)
	local entry = Profile.get(player)
	if entry == nil then
		return
	end
	local patient = patientOf(player)
	if patient == nil then
		notify(player, &quot;warn&quot;, &quot;notify.noPatient&quot;)
		return
	end
	if patient.stationId == nil or not nearStation(player, patient.stationId) then
		notify(player, &quot;warn&quot;, &quot;notify.tooFar&quot;)
		return
	end
	if not Upgrades.hasTool(entry.data, toolId) then
		notify(player, &quot;warn&quot;, &quot;notify.toolLocked&quot;)
		return
	end
	if os.clock() &lt; patient.busyUntil then
		return -- islem suruyor
	end

	local tool = Upgrades.tool(toolId)
	if tool == nil then
		return
	end
	patient.busyUntil = os.clock() + tool.useSeconds

	local found = Diagnosis.revealWith(patient.revealed, patient.conditionId, toolId)
	for _, symptomId in found do
		patient.revealed[symptomId] = true
	end
	patient.toolsUsed[toolId] = true

	-- Her alet kullanimi hayvani biraz gerer: butun aletleri sirayla
	-- denemek bedava degil.
	patient.stress = math.clamp(patient.stress + economy.toolStress, 0, 100)
	AnimalAnimator.setStress(patient.rig, patient.stress)

	local names = {}
	for _, symptomId in found do
		local symptom = Diagnosis.symptom(symptomId)
		table.insert(names, if symptom ~= nil then symptom.nameKey else symptomId)
	end

	Net.toPlayer(&quot;ToolResult&quot;, player, toolId, names)
	pushChart(player)
end

function PatientFlow.submitDiagnosis(player: Player, conditionId: string)
	local entry = Profile.get(player)
	if entry == nil then
		return
	end
	local patient = patientOf(player)
	if patient == nil then
		notify(player, &quot;warn&quot;, &quot;notify.noPatient&quot;)
		return
	end
	if patient.diagnosed then
		notify(player, &quot;info&quot;, &quot;notify.alreadyDiagnosed&quot;)
		return
	end
	if patient.stationId == nil or not nearStation(player, patient.stationId) then
		notify(player, &quot;warn&quot;, &quot;notify.tooFar&quot;)
		return
	end
	if Diagnosis.condition(conditionId) == nil then
		return
	end

	local data = entry.data
	local effects = Upgrades.effectsOf(data)

	if Diagnosis.check(patient.conditionId, conditionId) then
		patient.diagnosed = true
		data.reputation = Economy.clampReputation(
			data.reputation + economy.reputation.correctDiagnosis * effects.repGain
		)
		data.stats.correct += 1
		local condition = Diagnosis.condition(conditionId)
		notify(player, &quot;good&quot;, &quot;notify.diagnosisCorrect&quot;, { condition.nameKey })
	else
		data.reputation = Economy.clampReputation(data.reputation + economy.reputation.wrongDiagnosis)
		data.stats.wrong += 1
		patient.stress = math.clamp(patient.stress + economy.wrongDiagnosisStress, 0, 100)
		AnimalAnimator.setStress(patient.rig, patient.stress)
		notify(player, &quot;bad&quot;, &quot;notify.diagnosisWrong&quot;)
	end

	Profile.markDirty(player)
	pushState(player)
	pushChart(player)
end

local function finishTreatment(player: Player, patient: Patient, treatmentId: string, outcome: Treatment.Outcome)
	patient.health = math.clamp(patient.health + outcome.healthDelta, 0, 100)
	patient.stress = math.clamp(patient.stress + outcome.stressDelta, 0, 100)
	AnimalAnimator.setStress(patient.rig, patient.stress)

	if outcome.correct then
		patient.treatmentsDone[treatmentId] = true
		-- Kirik iyilesince topallama biter: gorunur geri bildirim.
		if treatmentId == &quot;surgery&quot; or treatmentId == &quot;bandage&quot; then
			AnimalAnimator.setLimp(patient.rig, 0, 0)
		end
	end

	updateNameplate(patient)
	pushChart(player)
	pushState(player)
end

function PatientFlow.applyTreatment(player: Player, treatmentId: string)
	local entry = Profile.get(player)
	if entry == nil then
		return
	end
	local patient = patientOf(player)
	if patient == nil then
		notify(player, &quot;warn&quot;, &quot;notify.noPatient&quot;)
		return
	end
	if patient.stationId == nil or not nearStation(player, patient.stationId) then
		notify(player, &quot;warn&quot;, &quot;notify.tooFar&quot;)
		return
	end
	if not patient.diagnosed then
		notify(player, &quot;warn&quot;, &quot;notify.diagnoseFirst&quot;)
		return
	end
	if os.clock() &lt; patient.busyUntil then
		return
	end

	local treatment = Treatment.get(treatmentId)
	if treatment == nil then
		return
	end

	local data = entry.data
	if data.level &lt; treatment.unlockLevel then
		notify(player, &quot;warn&quot;, &quot;notify.treatmentLocked&quot;)
		return
	end
	if patient.treatmentsDone[treatmentId] == true then
		notify(player, &quot;info&quot;, &quot;notify.treatmentDone&quot;)
		return
	end

	local effects = Upgrades.effectsOf(data)
	local cost = Treatment.cost(treatmentId, effects.supplyDiscount)
	if data.money &lt; cost then
		notify(player, &quot;warn&quot;, &quot;notify.noMoneyForSupply&quot;, { cost })
		return
	end

	-- Ameliyat, ameliyat masasinda yapilir. Mekani oynanisin parcasi
	-- yapan tek kural bu.
	if treatment.minigame == &quot;surgery&quot; and patient.stationId ~= &quot;surgery&quot; then
		notify(player, &quot;warn&quot;, &quot;notify.needSurgeryRoom&quot;)
		return
	end

	data.money -= cost
	Profile.markDirty(player)

	if treatment.minigame == &quot;surgery&quot; then
		if Surgery.active(player) ~= nil then
			return
		end
		local patientId = patient.id
		local schedule = Surgery.begin(player, patientId, effects.surgeryTolerance, function(passed, score)
			local current = patients[patientId]
			Net.toPlayer(&quot;SurgeryEnd&quot;, player, passed, score)
			if current == nil then
				return
			end
			if passed then
				finishTreatment(player, current, treatmentId, {
					ok = true,
					reasonKey = &quot;treat.done&quot;,
					correct = true,
					healthDelta = treatment.healthDelta * (0.6 + 0.4 * score),
					stressDelta = treatment.stressDelta,
				})
				notify(player, &quot;good&quot;, &quot;notify.surgerySuccess&quot;, { math.floor(score * 100 + 0.5) })
			else
				finishTreatment(player, current, treatmentId, {
					ok = true,
					reasonKey = &quot;treat.wrong&quot;,
					correct = false,
					healthDelta = economy.wrongTreatmentHealth,
					stressDelta = treatment.stressDelta,
				})
				notify(player, &quot;bad&quot;, &quot;notify.surgeryFailed&quot;, { math.floor(score * 100 + 0.5) })
			end
		end)
		Net.toPlayer(&quot;SurgeryBegin&quot;, player, schedule)
		pushState(player)
		return
	end

	local seconds = Treatment.seconds(treatmentId, effects.treatSpeed)
	patient.busyUntil = os.clock() + seconds

	local outcome = Treatment.evaluate(patient.conditionId, treatmentId, patient.stress, effects)
	if not outcome.ok then
		patient.stress = math.clamp(patient.stress + outcome.stressDelta, 0, 100)
		AnimalAnimator.setStress(patient.rig, patient.stress)
		notify(player, &quot;bad&quot;, outcome.reasonKey)
		pushChart(player)
		return
	end

	local patientId = patient.id
	task.delay(seconds, function()
		local current = patients[patientId]
		if current == nil or current.owner ~= player then
			return
		end
		finishTreatment(player, current, treatmentId, outcome)
		if outcome.correct then
			notify(player, &quot;good&quot;, &quot;notify.treatmentApplied&quot;, { treatment.nameKey })
		else
			notify(player, &quot;bad&quot;, &quot;notify.treatmentWrong&quot;)
		end
	end)
end

function PatientFlow.surgeryInput(player: Player, step: number)
	local result = Surgery.input(player, step)
	if result.accepted then
		Net.toPlayer(&quot;ToolResult&quot;, player, &quot;surgeryStep&quot;, { result.grade })
	end
end

function PatientFlow.discharge(player: Player)
	local entry = Profile.get(player)
	if entry == nil then
		return
	end
	local patient = patientOf(player)
	if patient == nil then
		notify(player, &quot;warn&quot;, &quot;notify.noPatient&quot;)
		return
	end
	if not patient.diagnosed then
		notify(player, &quot;warn&quot;, &quot;notify.diagnoseFirst&quot;)
		return
	end
	if not Treatment.isComplete(patient.treatmentsDone, patient.conditionId) then
		notify(player, &quot;warn&quot;, &quot;notify.treatmentsIncomplete&quot;)
		return
	end

	local data = entry.data
	local effects = Upgrades.effectsOf(data)
	local animal = AnimalFactory.spec(patient.animalId)
	local condition = Diagnosis.condition(patient.conditionId)
	if animal == nil or condition == nil then
		return
	end

	local fee = Economy.fee({
		baseFee = animal.baseFee,
		feeMultiplier = condition.feeMultiplier,
		reputation = data.reputation,
		health = patient.health,
		feeBonus = effects.feeBonus,
	})

	data.money += fee
	data.xp += condition.xp
	data.stats.patients += 1
	data.stats.earned += fee

	if patient.health &gt;= economy.patient.healthyDischargeThreshold then
		data.reputation = Economy.clampReputation(
			data.reputation + economy.reputation.healthyDischarge * effects.repGain
		)
	elseif patient.stress &gt;= 70 then
		data.reputation = Economy.clampReputation(data.reputation + economy.reputation.stressedDischarge)
	end

	local previousLevel = data.level
	data.level = Economy.levelForXp(data.xp)
	if data.level &gt; previousLevel then
		local granted = Upgrades.grantFreeTools(data)
		notify(player, &quot;good&quot;, &quot;notify.levelUp&quot;, { data.level, Economy.titleKeyForLevel(data.level) })
		for _, toolId in granted do
			local tool = Upgrades.tool(toolId)
			notify(player, &quot;good&quot;, &quot;notify.toolUnlocked&quot;, { if tool ~= nil then tool.nameKey else toolId })
		end
	end

	notify(player, &quot;good&quot;, &quot;notify.discharged&quot;, { fee, condition.xp })
	Profile.markDirty(player)

	sendAway(patient, true)
	pushState(player)
	pushChart(player)
	pushStateAll()
end

--- Oyuncu ayrildi: hastasini kuyruga geri koymak yerine birakiyoruz ki
--- baska bir veteriner alabilsin.
function PatientFlow.playerLeft(player: Player)
	Surgery.cancel(player)
	local patient = patientOf(player)
	activeOf[player] = nil
	if patient == nil then
		return
	end
	patient.owner = nil
	-- Masada kalsin; siradaki oyuncu &quot;Sirayi cagir&quot; ile devralabilir.
	patient.state = &quot;waiting&quot;
end

-- ── Dongu ─────────────────────────────────────────────────────────────

local function tickVitals(dt: number)
	local config = economy.patient
	for _, patient in patients do
		if patient.state == &quot;leaving&quot; then
			continue
		end

		-- Tedavi edilmeyen hasta yavas yavas kotuluyor.
		if not Treatment.isComplete(patient.treatmentsDone, patient.conditionId) then
			patient.health = math.clamp(patient.health - config.healthDrainPerSecond * dt, 0, 100)
		end

		-- Stres kendiliginden yavas yavas duser.
		if patient.stress &gt; 0 then
			patient.stress = math.clamp(patient.stress - config.stressDecayPerSecond * dt, 0, 100)
			AnimalAnimator.setStress(patient.rig, patient.stress)
		end

		AnimalAnimator.setState(patient.rig, if patient.stress &gt;= 70 then &quot;distress&quot; else &quot;idle&quot;)
		updateNameplate(patient)

		-- Bekleyip bekleyip kacan hasta: butun klinigin itibari duser.
		if patient.owner == nil and patient.state == &quot;waiting&quot; then
			if os.clock() - patient.arrivedAt &gt; economy.arrival.patienceSeconds then
				local animal = AnimalFactory.spec(patient.animalId)
				notifyAll(&quot;bad&quot;, &quot;notify.patientLeft&quot;, { if animal ~= nil then animal.nameKey else patient.animalId })
				for _, player in Players:GetPlayers() do
					local entry = Profile.get(player)
					if entry ~= nil then
						entry.data.reputation = Economy.clampReputation(
							entry.data.reputation + economy.reputation.timeout
						)
						Profile.markDirty(player)
					end
				end
				sendAway(patient, true)
				pushStateAll()
			end
		end
	end
end

--- Klinigi bagla ve dongulari baslat.
function PatientFlow.start(built: Clinic.Built)
	if started then
		return
	end
	started = true
	clinic = built

	local folder = Instance.new(&quot;Folder&quot;)
	folder.Name = &quot;Hastalar&quot;
	folder.Parent = workspace
	patientsFolder = folder

	-- Hasta gelisi
	task.spawn(function()
		-- Ilk hasta hemen gelmesin: oyuncu once etrafa bakabilsin.
		task.wait(6)
		while true do
			if #Players:GetPlayers() &gt; 0 then
				spawnPatient()
			end
			local clinicEffects = Upgrades.clinicEffects(Players:GetPlayers())
			task.wait(Economy.arrivalSeconds(bestReputation(), clinicEffects.arrivalScale))
		end
	end)

	-- Yasamsal belirtiler
	task.spawn(function()
		while true do
			task.wait(VITALS_TICK)
			tickVitals(VITALS_TICK)
		end
	end)

	-- Arayuzun kuyruk sayaci canli kalsin.
	task.spawn(function()
		while true do
			task.wait(2)
			for _, player in Players:GetPlayers() do
				pushChart(player)
			end
		end
	end)
end

--- Kac hasta canli? SelfTest ve tanilama icin.
function PatientFlow.patientCount(): number
	local total = 0
	for _ in patients do
		total += 1
	end
	return total
end

return PatientFlow
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX28">
					<Properties>
						<string name="Name">Profile</string>
						<ProtectedString name="Source">--!strict
-- Profile.luau
-- ============
-- Oyuncu ilerlemesinin kalici kaydi. SUNUCU OTORITER.
--
-- Tek yazici oturum kilidi
-- ------------------------
-- Ayni profil iki sunucuda ayni anda acilirsa biri digerinin yazdigini
-- ezer ve oyuncu ilerlemesini kaybeder. Bunu onlemek icin her kayitta
-- bir kilit tutuluyor: kilidi tutan is (JobId) ve son dokunma zamani.
-- Baska bir sunucu kilidi ancak BAYATLAMISSA (sunucu cokmus, kilit
-- birakilmamis) devralir.
--
-- Studio'da DataStore kapaliysa
-- -----------------------------
-- &quot;Studio Access to API Services&quot; kapaliyken DataStore cagrilari hata
-- verir. Bu durumda profil BELLEKTE tutuluyor ve `transient` isaretiyle
-- donuyor; istemci HUD'da Turkce bir uyari gosteriyor. Sessizce veri
-- kaybetmek yerine oyuncuya durumu soylemek gerekiyor.

local DataStoreService = game:GetService(&quot;DataStoreService&quot;)
local Players = game:GetService(&quot;Players&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Data = ReplicatedStorage:WaitForChild(&quot;VetData&quot;)

local economy = require(Data.economy)
local toolData = require(Data.tools)

local Profile = {}

local SCHEMA_VERSION = 1
local STORE_NAME = &quot;VetProfile_v1&quot;
local KEY_PREFIX = &quot;player_&quot;
local LOCK_STALE_SECONDS = 1800
local LOCK_REFRESH_SECONDS = 60
local AUTOSAVE_SECONDS = 90
local MAX_ATTEMPTS = 4

export type Data = {
	version: number,
	money: number,
	xp: number,
	level: number,
	reputation: number,
	tools: { [string]: boolean },
	upgrades: { [string]: boolean },
	stats: { patients: number, correct: number, wrong: number, earned: number },
}

export type Entry = {
	data: Data,
	transient: boolean,
	lastSave: number,
	dirty: boolean,
}

local store: DataStore? = nil
local loaded: { [Player]: Entry } = {}

--- Baslangicta sahip olunan aletler VERIDEN cikariliyor: fiyati 0 ve
--- 1. seviyede acilan her alet bastan var. Kodda liste tutmak, veri
--- dosyasi degisince sessizce tutarsiz kalirdi.
local function starterTools(): { [string]: boolean }
	local tools = {}
	for _, tool in toolData.tools do
		if tool.price == 0 and tool.unlockLevel &lt;= 1 then
			tools[tool.id] = true
		end
	end
	return tools
end

local function defaultData(): Data
	return {
		version = SCHEMA_VERSION,
		money = economy.startingMoney,
		xp = 0,
		level = 1,
		reputation = economy.startingReputation,
		tools = starterTools(),
		upgrades = {},
		stats = { patients = 0, correct = 0, wrong = 0, earned = 0 },
	}
end

--- Diskten gelen tabloyu guncel semaya tasir. Eksik alanlar
--- varsayilanla dolduruluyor; bilinmeyen surum reddedilmiyor, cunku
--- oyuncunun ilerlemesini silmektense eksigini tamamlamak dogru.
local function migrate(raw: any): Data
	local fresh = defaultData()
	if type(raw) ~= &quot;table&quot; then
		return fresh
	end

	local result = fresh
	result.money = if type(raw.money) == &quot;number&quot; then raw.money else fresh.money
	result.xp = if type(raw.xp) == &quot;number&quot; then raw.xp else fresh.xp
	result.level = if type(raw.level) == &quot;number&quot; then raw.level else fresh.level
	result.reputation = if type(raw.reputation) == &quot;number&quot; then raw.reputation else fresh.reputation

	if type(raw.tools) == &quot;table&quot; then
		for id, owned in raw.tools do
			if owned == true then
				result.tools[id] = true
			end
		end
	end
	if type(raw.upgrades) == &quot;table&quot; then
		for id, owned in raw.upgrades do
			if owned == true then
				result.upgrades[id] = true
			end
		end
	end
	if type(raw.stats) == &quot;table&quot; then
		for key, value in raw.stats do
			if type(value) == &quot;number&quot; and result.stats[key] ~= nil then
				result.stats[key] = value
			end
		end
	end

	result.version = SCHEMA_VERSION
	return result
end

local function keyOf(player: Player): string
	return KEY_PREFIX .. tostring(player.UserId)
end

local function getStore(): DataStore?
	if store ~= nil then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
		return store
	end
	return nil
end

--- UpdateAsync'i birkac kez dener. Roblox DataStore'lari gecici olarak
--- hata verebiliyor; ilk hatada pes etmek oyuncunun kaydini dusurur.
local function tryUpdate(key: string, transform: (any) -&gt; any?): (boolean, any)
	local dataStore = getStore()
	if dataStore == nil then
		return false, nil
	end

	local lastError: any = nil
	for attempt = 1, MAX_ATTEMPTS do
		local ok, result = pcall(function()
			return dataStore:UpdateAsync(key, transform)
		end)
		if ok then
			return true, result
		end
		lastError = result
		task.wait(2 ^ (attempt - 1))
	end
	warn((&quot;[Profile] '%s' yazilamadi: %s&quot;):format(key, tostring(lastError)))
	return false, nil
end

--- Profili yukler ve oturum kilidini alir.
function Profile.load(player: Player): Entry
	local existing = loaded[player]
	if existing ~= nil then
		return existing
	end

	local jobId = if RunService:IsStudio() then &quot;studio&quot; else game.JobId
	local now = os.time()

	local ok, stored = tryUpdate(keyOf(player), function(raw: any): any?
		if type(raw) == &quot;table&quot; and type(raw.lock) == &quot;table&quot; then
			local lock = raw.lock
			local fresh = (now - (tonumber(lock.at) or 0)) &lt; LOCK_STALE_SECONDS
			if fresh and lock.jobId ~= jobId then
				-- Baska bir sunucu bu profili acik tutuyor; yazmayi iptal et.
				return nil
			end
		end
		local payload = if type(raw) == &quot;table&quot; then raw else {}
		payload.lock = { jobId = jobId, at = now }
		return payload
	end)

	local entry: Entry
	if ok and type(stored) == &quot;table&quot; then
		entry = {
			data = migrate(stored.data),
			transient = false,
			lastSave = os.clock(),
			dirty = false,
		}
	else
		-- Kilit alinamadi ya da DataStore kapali: bellekte devam.
		entry = {
			data = defaultData(),
			transient = true,
			lastSave = os.clock(),
			dirty = false,
		}
		warn((&quot;[Profile] %s icin kalici kayit acilamadi - bellekte devam ediliyor&quot;):format(player.Name))
	end

	loaded[player] = entry
	return entry
end

function Profile.get(player: Player): Entry?
	return loaded[player]
end

--- Bir sonraki otomatik kayitta yazilmak uzere isaretler.
function Profile.markDirty(player: Player)
	local entry = loaded[player]
	if entry ~= nil then
		entry.dirty = true
	end
end

--- Diske yazar. `release` true ise oturum kilidini de birakir.
function Profile.save(player: Player, release: boolean): boolean
	local entry = loaded[player]
	if entry == nil or entry.transient then
		return false
	end

	local jobId = if RunService:IsStudio() then &quot;studio&quot; else game.JobId
	local snapshot = entry.data

	local ok = tryUpdate(keyOf(player), function(raw: any): any?
		local payload = if type(raw) == &quot;table&quot; then raw else {}
		local lock = payload.lock
		if type(lock) == &quot;table&quot; and lock.jobId ~= jobId then
			local fresh = (os.time() - (tonumber(lock.at) or 0)) &lt; LOCK_STALE_SECONDS
			if fresh then
				-- Kilidi baskasi devralmis: uzerine yazma.
				return nil
			end
		end
		payload.data = snapshot
		payload.lock = if release then nil else { jobId = jobId, at = os.time() }
		return payload
	end)

	if ok then
		entry.lastSave = os.clock()
		entry.dirty = false
	end
	return ok
end

function Profile.release(player: Player)
	if loaded[player] ~= nil then
		Profile.save(player, true)
		loaded[player] = nil
	end
end

--- Otomatik kayit ve kilit tazeleme dongusu. init.server.luau baslatiyor.
function Profile.startAutosave()
	task.spawn(function()
		while true do
			task.wait(LOCK_REFRESH_SECONDS)
			for player, entry in loaded do
				if player.Parent == nil then
					continue
				end
				local age = os.clock() - entry.lastSave
				if entry.dirty or age &gt;= AUTOSAVE_SECONDS then
					Profile.save(player, false)
				end
			end
		end
	end)

	-- Sunucu kapanirken herkesin kaydini yaz. BindToClose'un butcesi
	-- kisitli (30 sn), bu yuzden paralel calistiriliyor.
	game:BindToClose(function()
		local threads = 0
		for player in loaded do
			threads += 1
			task.spawn(function()
				Profile.release(player)
				threads -= 1
			end)
		end
		local deadline = os.clock() + 20
		while threads &gt; 0 and os.clock() &lt; deadline do
			task.wait(0.2)
		end
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		Profile.release(player)
	end)
end

--- Varsayilan profil (SelfTest ve simulasyon icin disa aciliyor).
function Profile.defaultData(): Data
	return defaultData()
end

return Profile
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX29">
					<Properties>
						<string name="Name">Surgery</string>
						<ProtectedString name="Source">--!strict
-- Surgery.luau
-- ============
-- Ameliyat mini-oyunu. ADIM PROGRAMI SUNUCUDA URETILIYOR, TIKLAMALAR
-- SUNUCUDA DOGRULANIYOR. Istemci yalnizca cizer.
--
-- Saat senkronu
-- -------------
-- Zamanlama `workspace:GetServerTimeNow()` uzerinden yuruyor: bu saat
-- istemci ve sunucuda SENKRON. Istemci kendi saatini kullansa gecikme
-- kadar kayardi. Yine de tiklamanin sunucuya ulasmasi zaman aliyor;
-- pencereler (perfectWindow 0.18 sn, goodWindow 0.34 sn) bunu
-- karsilayacak kadar genis tutuldu. Pencereyi gecikme kadar ONCEYE
-- kaydirmak istemcinin bildirdigi bir sayiya guvenmek olurdu - bu
-- yuzden yapilmiyor, comert davranmak tercih edildi.

local Workspace = game:GetService(&quot;Workspace&quot;)

local Treatment = require(script.Parent.Treatment)

local Surgery = {}

export type Session = {
	player: Player,
	patientId: number,
	startTime: number,
	stepSeconds: number,
	stepCount: number,
	resolved: { [number]: string },
	score: number,
	threshold: number,
	done: boolean,
}

local sessions: { [Player]: Session } = {}

--- Bu oyuncunun acik bir ameliyati var mi?
function Surgery.active(player: Player): Session?
	local session = sessions[player]
	if session ~= nil and not session.done then
		return session
	end
	return nil
end

--- Adim `index` icin hedef zaman (senkron sunucu saati).
local function targetTime(session: Session, index: number): number
	return session.startTime + index * session.stepSeconds
end

--- Ameliyati baslatir. Istemciye yollanacak program tablosunu doner.
--- `onFinish(passed, score)` butun adimlar bitince cagrilir.
function Surgery.begin(
	player: Player,
	patientId: number,
	surgeryTolerance: number,
	onFinish: (passed: boolean, score: number) -&gt; ()
): any
	local config = Treatment.surgeryConfig

	local session: Session = {
		player = player,
		patientId = patientId,
		startTime = Workspace:GetServerTimeNow() + 1.5, -- istemcinin arayuzu kurmasi icin pay
		stepSeconds = config.stepSeconds,
		stepCount = config.steps,
		resolved = {},
		score = 0,
		threshold = math.max(0.2, config.minScoreToPass - surgeryTolerance),
		done = false,
	}
	sessions[player] = session

	task.spawn(function()
		for index = 1, session.stepCount do
			local deadline = targetTime(session, index) + config.goodWindow
			while Workspace:GetServerTimeNow() &lt; deadline do
				if session.done or sessions[player] ~= session then
					return
				end
				task.wait(0.05)
			end
			if session.resolved[index] == nil then
				-- Hic tiklanmadi: kacirildi.
				session.resolved[index] = &quot;miss&quot;
				session.score -= config.missPenalty
			end
		end

		if session.done or sessions[player] ~= session then
			return
		end
		session.done = true
		local finalScore = math.clamp(session.score, 0, 1)
		sessions[player] = nil
		onFinish(finalScore &gt;= session.threshold, finalScore)
	end)

	return {
		steps = session.stepCount,
		startTime = session.startTime,
		stepSeconds = session.stepSeconds,
		perfectWindow = config.perfectWindow,
		goodWindow = config.goodWindow,
	}
end

export type InputResult = { accepted: boolean, grade: string, step: number }

--- Istemciden gelen tiklama. Ayni adim iki kez puanlanmaz.
function Surgery.input(player: Player, index: number): InputResult
	local session = Surgery.active(player)
	if session == nil then
		return { accepted = false, grade = &quot;none&quot;, step = 0 }
	end
	if index &lt; 1 or index &gt; session.stepCount or index % 1 ~= 0 then
		return { accepted = false, grade = &quot;none&quot;, step = 0 }
	end
	if session.resolved[index] ~= nil then
		return { accepted = false, grade = &quot;none&quot;, step = index }
	end

	local config = Treatment.surgeryConfig
	local error = math.abs(Workspace:GetServerTimeNow() - targetTime(session, index))

	local grade: string
	if error &lt;= config.perfectWindow then
		grade = &quot;perfect&quot;
		session.score += (1 / session.stepCount) + config.perfectBonus / session.stepCount
	elseif error &lt;= config.goodWindow then
		grade = &quot;good&quot;
		session.score += 0.7 / session.stepCount
	else
		grade = &quot;miss&quot;
		session.score -= config.missPenalty
	end

	session.resolved[index] = grade
	return { accepted = true, grade = grade, step = index }
end

--- Ameliyati iptal eder (oyuncu ayrildi, hasta kayboldu).
function Surgery.cancel(player: Player)
	local session = sessions[player]
	if session ~= nil then
		session.done = true
		sessions[player] = nil
	end
end

return Surgery
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX30">
					<Properties>
						<string name="Name">Treatment</string>
						<ProtectedString name="Source">--!strict
-- Treatment.luau
-- ==============
-- Tedavi uygulama. SUNUCU OTORITER.
--
-- Yanlis tedavi cezasiz degil
-- ---------------------------
-- Hastaligin gerektirmedigi bir tedavi uygulamak hayvani gerer ve
-- sagligini dusurur. Yoksa oyuncu butun tedavileri sirayla uygulayip
-- bulmacayi atlayabilirdi.
--
-- Stres esigi
-- -----------
-- Stres `resistStress`'e ulastiysa hayvan DIRENIR: tedavi uygulanmaz,
-- sarf malzemesi yine gider. Oyuncunun yikama/besleme ile arada
-- hayvani sakinlestirmesi gerekiyor - oynanisin ikinci katmani bu.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Data = ReplicatedStorage:WaitForChild(&quot;VetData&quot;)

local Diagnosis = require(script.Parent.Diagnosis)
local Economy = require(script.Parent.Economy)

local treatmentData = require(Data.treatments)

local Treatment = {}

local byId: { [string]: any } = {}
for _, treatment in treatmentData.treatments do
	byId[treatment.id] = treatment
end

Treatment.surgeryConfig = treatmentData.surgery

function Treatment.get(id: string): any?
	return byId[id]
end

function Treatment.all(): { any }
	return treatmentData.treatments
end

--- Hastaligin gerektirdigi tedaviler.
function Treatment.requiredFor(conditionId: string): { string }
	local condition = Diagnosis.condition(conditionId)
	if condition == nil then
		return {}
	end
	return condition.treatments
end

--- Tedavi bu hastalik icin dogru mu?
function Treatment.isRequired(conditionId: string, treatmentId: string): boolean
	for _, id in Treatment.requiredFor(conditionId) do
		if id == treatmentId then
			return true
		end
	end
	return false
end

--- Gereken butun tedaviler uygulandi mi?
function Treatment.isComplete(done: { [string]: boolean }, conditionId: string): boolean
	local required = Treatment.requiredFor(conditionId)
	if #required == 0 then
		return false
	end
	for _, id in required do
		if done[id] ~= true then
			return false
		end
	end
	return true
end

--- Sarf malzemesi bedeli (eczane yukseltmesi indirim yapiyor).
function Treatment.cost(treatmentId: string, supplyDiscount: number): number
	local treatment = byId[treatmentId]
	if treatment == nil then
		return 0
	end
	return math.max(0, math.floor(treatment.supplyCost * supplyDiscount + 0.5))
end

--- Tedavinin suresi (daha iyi masa yukseltmesi kisaltiyor).
function Treatment.seconds(treatmentId: string, treatSpeed: number): number
	local treatment = byId[treatmentId]
	if treatment == nil then
		return 0
	end
	return math.max(0.2, treatment.seconds * treatSpeed)
end

export type Outcome = {
	ok: boolean,
	reasonKey: string,
	correct: boolean,
	healthDelta: number,
	stressDelta: number,
}

--- Tedaviyi hesaplar. Hastanin sagligini/stresini DEGISTIRMEZ; sonucu
--- doner, uygulamak PatientFlow'un isi (tek yazici, tek yer).
function Treatment.evaluate(
	conditionId: string,
	treatmentId: string,
	currentStress: number,
	effects: { [string]: number }
): Outcome
	local treatment = byId[treatmentId]
	if treatment == nil then
		return { ok = false, reasonKey = &quot;treat.unknown&quot;, correct = false, healthDelta = 0, stressDelta = 0 }
	end

	local config = Economy.table()

	if currentStress &gt;= config.patient.resistStress then
		-- Hayvan direniyor: islem bosa gitti, stres biraz daha artti.
		return {
			ok = false,
			reasonKey = &quot;treat.resisted&quot;,
			correct = false,
			healthDelta = 0,
			stressDelta = 4,
		}
	end

	local correct = Treatment.isRequired(conditionId, treatmentId)
	if not correct then
		return {
			ok = true,
			reasonKey = &quot;treat.wrong&quot;,
			correct = false,
			healthDelta = config.wrongTreatmentHealth,
			stressDelta = config.wrongTreatmentStress,
		}
	end

	local healthDelta = treatment.healthDelta
	-- Yikama istasyonu yukseltmesi yikamayi guclendiriyor.
	if treatment.kind == &quot;wash&quot; then
		healthDelta += effects.washBonus or 0
	end

	return {
		ok = true,
		reasonKey = &quot;treat.done&quot;,
		correct = true,
		healthDelta = healthDelta,
		stressDelta = treatment.stressDelta,
	}
end

return Treatment
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX31">
					<Properties>
						<string name="Name">Upgrades</string>
						<ProtectedString name="Source">--!strict
-- Upgrades.luau
-- =============
-- Alet ve klinik yukseltmesi satin alma + etkilerin toplanmasi.
-- SUNUCU OTORITER: fiyat, seviye ve &quot;zaten var mi&quot; denetimleri burada.
--
-- Kisisel ve klinik etkileri
-- --------------------------
-- Bazi etkiler oyuncunun kendisine isliyor (ucret bonusu, sarf
-- indirimi, tedavi hizi); bazilari BINAYA isliyor ve tek bir kuyruk
-- paylasildigi icin cok oyunculu oturumda ONLINE OYUNCULARIN EN
-- IYISINI aliyor (bekleme yeri, reklam). Ikisini karistirmak, bir
-- oyuncunun aldigi yukseltmeyi digerinin kaybetmesi demek olurdu.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Data = ReplicatedStorage:WaitForChild(&quot;VetData&quot;)

local Economy = require(script.Parent.Economy)
local Profile = require(script.Parent.Profile)

local toolData = require(Data.tools)
local upgradeData = require(Data.upgrades)

local Upgrades = {}

-- Etkiler nasil birlestirilecek? Veri dosyasindaki effectKeys ile
-- burasi ayni kumeyi tanimlamak zorunda; verify_data.py karsilastiriyor.
local ADDITIVE = { queueSlots = true, surgeryTolerance = true, washBonus = true }
local MULTIPLICATIVE = { arrivalScale = true, treatSpeed = true, supplyDiscount = true, feeBonus = true, repGain = true }

-- Binaya isleyen etkiler: cok oyunculuda en iyi deger kazanir.
local CLINIC_WIDE = { queueSlots = true, arrivalScale = true }

local toolById: { [string]: any } = {}
for _, tool in toolData.tools do
	toolById[tool.id] = tool
end

local upgradeById: { [string]: any } = {}
for _, upgrade in upgradeData.upgrades do
	upgradeById[upgrade.id] = upgrade
end

function Upgrades.tool(id: string): any?
	return toolById[id]
end

function Upgrades.upgrade(id: string): any?
	return upgradeById[id]
end

function Upgrades.allTools(): { any }
	return toolData.tools
end

function Upgrades.allUpgrades(): { any }
	return upgradeData.upgrades
end

--- Etki anahtari taniniyor mu? verify_data.py ve SelfTest icin.
function Upgrades.knownEffect(key: string): boolean
	return ADDITIVE[key] == true or MULTIPLICATIVE[key] == true
end

--- Tek oyuncunun KISISEL etkileri.
function Upgrades.effectsOf(data: Profile.Data): { [string]: number }
	local effects: { [string]: number } = {
		queueSlots = 0,
		surgeryTolerance = 0,
		washBonus = 0,
		arrivalScale = 1,
		treatSpeed = 1,
		supplyDiscount = 1,
		feeBonus = 1,
		repGain = 1,
	}

	for id, owned in data.upgrades do
		if owned ~= true then
			continue
		end
		local upgrade = upgradeById[id]
		if upgrade == nil then
			-- Veri dosyasindan silinmis bir yukseltme: sessizce yutmuyoruz.
			warn((&quot;[Upgrades] profilde bilinmeyen yukseltme: '%s'&quot;):format(id))
			continue
		end
		for key, value in upgrade.effect do
			if ADDITIVE[key] then
				effects[key] += value
			elseif MULTIPLICATIVE[key] then
				effects[key] *= value
			else
				warn((&quot;[Upgrades] '%s' bilinmeyen etki anahtari kullaniyor: '%s'&quot;):format(id, key))
			end
		end
	end

	return effects
end

--- Klinige isleyen etkiler: online oyunculardan EN IYISI.
--- queueSlots'ta en buyuk, arrivalScale'de en kucuk iyi olan.
function Upgrades.clinicEffects(players: { Player }): { [string]: number }
	local best = { queueSlots = 0, arrivalScale = 1 }
	for _, player in players do
		local entry = Profile.get(player)
		if entry == nil then
			continue
		end
		local effects = Upgrades.effectsOf(entry.data)
		for key in CLINIC_WIDE do
			if key == &quot;arrivalScale&quot; then
				best[key] = math.min(best[key], effects[key])
			else
				best[key] = math.max(best[key], effects[key])
			end
		end
	end
	return best
end

-- `args` bildirimdeki {1}, {2} ... yer tutucularini doldurur; ceviriyi
-- istemci yapiyor, sunucu yalnizca anahtar ve sayilari yolluyor.
export type BuyResult = { ok: boolean, reasonKey: string, args: { any } }

local function purchase(data: Profile.Data, bag: { [string]: boolean }, item: any?, id: string): BuyResult
	if item == nil then
		return { ok = false, reasonKey = &quot;shop.unknown&quot;, args = {} }
	end
	if bag[id] == true then
		return { ok = false, reasonKey = &quot;shop.alreadyOwned&quot;, args = {} }
	end
	if data.level &lt; item.unlockLevel then
		return { ok = false, reasonKey = &quot;shop.levelTooLow&quot;, args = { item.unlockLevel } }
	end
	if data.money &lt; item.cost then
		return { ok = false, reasonKey = &quot;shop.notEnoughMoney&quot;, args = {} }
	end

	-- Kasa rezervi: butun parasini alete yatiran oyuncu sarf malzemesi
	-- alamaz, tedavi edemez, para kazanamaz - oyun kilitlenir. Bu
	-- kilitlenmeyi tools/simulate_economy.py yakaladi; kural o yuzden var.
	local economy = Economy.table()
	if data.money - item.cost &lt; economy.minimumReserve then
		return { ok = false, reasonKey = &quot;shop.keepReserve&quot;, args = { economy.minimumReserve } }
	end

	data.money -= item.cost
	bag[id] = true
	return { ok = true, reasonKey = &quot;shop.bought&quot;, args = {} }
end

--- Alet satin alir. Aletin `price` alani var, `cost` degil; ortak
--- satin alma yoluna sokmak icin normalize ediliyor.
function Upgrades.buyTool(data: Profile.Data, id: string): BuyResult
	local tool = toolById[id]
	if tool == nil then
		return { ok = false, reasonKey = &quot;shop.unknown&quot;, args = {} }
	end
	return purchase(data, data.tools, { cost = tool.price, unlockLevel = tool.unlockLevel }, id)
end

function Upgrades.buyUpgrade(data: Profile.Data, id: string): BuyResult
	return purchase(data, data.upgrades, upgradeById[id], id)
end

--- Seviye atlayinca fiyati 0 olan aletler kendiliginden aciliyor:
--- oyuncuyu bedava bir seyi &quot;satin al&quot; diye magazaya yollamak anlamsiz.
function Upgrades.grantFreeTools(data: Profile.Data): { string }
	local granted = {}
	for _, tool in toolData.tools do
		if tool.price == 0 and data.level &gt;= tool.unlockLevel and data.tools[tool.id] ~= true then
			data.tools[tool.id] = true
			table.insert(granted, tool.id)
		end
	end
	return granted
end

--- Oyuncu bu aleti kullanabilir mi?
function Upgrades.hasTool(data: Profile.Data, id: string): boolean
	return data.tools[id] == true and data.level &gt;= (toolById[id] and toolById[id].unlockLevel or math.huge)
end

--- Magaza listesi (istemciye yollanan bicim).
function Upgrades.shopSnapshot(data: Profile.Data): any
	local tools = {}
	for _, tool in toolData.tools do
		table.insert(tools, {
			id = tool.id,
			nameKey = tool.nameKey,
			price = tool.price,
			unlockLevel = tool.unlockLevel,
			owned = data.tools[tool.id] == true,
			locked = data.level &lt; tool.unlockLevel,
		})
	end

	local upgrades = {}
	for _, upgrade in upgradeData.upgrades do
		table.insert(upgrades, {
			id = upgrade.id,
			nameKey = upgrade.nameKey,
			descKey = upgrade.descKey,
			price = upgrade.cost,
			unlockLevel = upgrade.unlockLevel,
			owned = data.upgrades[upgrade.id] == true,
			locked = data.level &lt; upgrade.unlockLevel,
		})
	end

	return { tools = tools, upgrades = upgrades, maxLevel = Economy.MAX_LEVEL }
end

return Upgrades
</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Folder" referent="RBX32">
				<Properties>
					<string name="Name">world</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX33">
					<Properties>
						<string name="Name">AnimalAnimator</string>
						<ProtectedString name="Source">--!strict
-- AnimalAnimator.luau
-- ===================
-- Hayvanlarin prosedurel animasyonu ve yurumesi.
--
-- Neden prosedurel?
-- -----------------
-- Roblox animasyonlari Creator Store'a yuklenmis asset'lerdir; bu depo
-- Roblox'a ag erisimi olmayan bir ortamda uretildi ve hicbir animasyon
-- ID'si dogrulanamazdi. Bunun yerine eklem Transform'lari her karede
-- sinuslerle suruluyor: nefes, kuyruk sallama, kafa oynatma, yuruyus
-- ve HASTA HAYVANDA TOPALLAMA. Hicbir dis asset gerekmiyor.
--
-- Topallama bilincli bir oynanis isareti: oyuncu daha aleti eline
-- almadan &quot;bu hayvanin bacaginda bir sey var&quot; diyebilmeli.

local RunService = game:GetService(&quot;RunService&quot;)

local AnimalFactory = require(script.Parent.AnimalFactory)

local Animator = {}

export type State = &quot;idle&quot; | &quot;walk&quot; | &quot;rest&quot; | &quot;distress&quot;

type Entry = {
	rig: AnimalFactory.Rig,
	state: State,
	phase: number,
	speed: number,
	limpLeg: number,
	limpStrength: number,
	stressLevel: number,
	waypoints: { Vector3 },
	onArrive: (() -&gt; ())?,
	facing: Vector3,
}

local entries: { [Model]: Entry } = {}
local running = false

local ARRIVE_DISTANCE = 1.2
local TURN_RATE = 7

--- Rigi animasyon dongusune alir.
function Animator.register(rig: AnimalFactory.Rig)
	entries[rig.model] = {
		rig = rig,
		state = &quot;idle&quot;,
		phase = math.random() * math.pi * 2,
		speed = rig.spec.walkSpeed,
		limpLeg = 0,
		limpStrength = 0,
		stressLevel = 0,
		waypoints = {},
		onArrive = nil,
		facing = rig.root.CFrame.LookVector,
	}
end

function Animator.unregister(rig: AnimalFactory.Rig)
	entries[rig.model] = nil
end

local function entryOf(rig: AnimalFactory.Rig): Entry?
	return entries[rig.model]
end

function Animator.setState(rig: AnimalFactory.Rig, state: State)
	local entry = entryOf(rig)
	if entry ~= nil then
		entry.state = state
	end
end

--- Stres 0..100. Yuksek stres nefesi hizlandirir, kulaklari yatirir.
function Animator.setStress(rig: AnimalFactory.Rig, stress: number)
	local entry = entryOf(rig)
	if entry ~= nil then
		entry.stressLevel = math.clamp(stress, 0, 100)
	end
end

--- Topallama. `leg` 0 ise topallama yok; 1..4 bacak numarasi.
function Animator.setLimp(rig: AnimalFactory.Rig, leg: number, strength: number)
	local entry = entryOf(rig)
	if entry ~= nil then
		entry.limpLeg = leg
		entry.limpStrength = math.clamp(strength, 0, 1)
	end
end

--- Hayvani bir noktaya yurutur. Varinca `onArrive` cagrilir.
function Animator.walkTo(rig: AnimalFactory.Rig, target: Vector3, onArrive: (() -&gt; ())?)
	local entry = entryOf(rig)
	if entry == nil then
		return
	end
	entry.waypoints = { target }
	entry.onArrive = onArrive
	entry.state = &quot;walk&quot;
end

--- Birden fazla ara nokta (kapidan gecip odaya girmek gibi).
function Animator.walkPath(rig: AnimalFactory.Rig, points: { Vector3 }, onArrive: (() -&gt; ())?)
	local entry = entryOf(rig)
	if entry == nil then
		return
	end
	entry.waypoints = table.clone(points)
	entry.onArrive = onArrive
	entry.state = if #entry.waypoints &gt; 0 then &quot;walk&quot; else &quot;idle&quot;
end

--- Aninda konumlandirir (masaya koymak gibi). Yuruyusu iptal eder.
function Animator.placeAt(rig: AnimalFactory.Rig, cframe: CFrame)
	local entry = entryOf(rig)
	local torsoY = rig.spec.legs.length + rig.spec.body.height * 0.5
	rig.root.CFrame = cframe * CFrame.new(0, torsoY, 0)
	if entry ~= nil then
		entry.waypoints = {}
		entry.onArrive = nil
		entry.state = &quot;idle&quot;
		entry.facing = rig.root.CFrame.LookVector
	end
end

--- Hareket: kok parcayi hedefe dogru tasir ve yonunu yumusatir.
local function stepMovement(entry: Entry, dt: number): number
	local rig = entry.rig
	if #entry.waypoints == 0 then
		return 0
	end

	local root = rig.root
	local target = entry.waypoints[1]
	local here = root.Position
	local flatTarget = Vector3.new(target.X, here.Y, target.Z)
	local delta = flatTarget - here
	local distance = delta.Magnitude

	if distance &lt;= ARRIVE_DISTANCE then
		table.remove(entry.waypoints, 1)
		if #entry.waypoints == 0 then
			entry.state = &quot;idle&quot;
			local callback = entry.onArrive
			entry.onArrive = nil
			if callback ~= nil then
				task.spawn(callback)
			end
		end
		return 0
	end

	local direction = delta.Unit
	-- Hasta hayvan yavas yurur; topallama ne kadar guclüyse o kadar yavas.
	local speed = entry.speed * (1 - entry.limpStrength * 0.35)
	local move = math.min(speed * dt, distance)

	entry.facing = entry.facing:Lerp(direction, math.clamp(TURN_RATE * dt, 0, 1))
	if entry.facing.Magnitude &lt; 1e-3 then
		entry.facing = direction
	end

	local newPosition = here + direction * move
	root.CFrame = CFrame.lookAt(newPosition, newPosition + entry.facing.Unit)
	return speed
end

--- Animasyon: eklem Transform'larini surer.
local function stepPose(entry: Entry, dt: number, movingSpeed: number)
	local rig = entry.rig
	local joints = rig.joints
	local walking = entry.state == &quot;walk&quot; and movingSpeed &gt; 0

	local stress = entry.stressLevel / 100
	local breathRate = 1.4 + stress * 2.2 + (if entry.state == &quot;distress&quot; then 1.6 else 0)
	local strideRate = if walking then math.max(movingSpeed, 1) * 1.15 else 0

	entry.phase += dt * (if walking then strideRate else breathRate)
	local phase = entry.phase

	-- Govde: nefes alip verme + yururken hafif salinim.
	if joints.rootJoint ~= nil then
		local breath = math.sin(phase * (if walking then 0.5 else 1)) * (0.035 + stress * 0.03)
		local sway = if walking then math.sin(phase * 2) * 0.03 else 0
		local tilt = entry.limpStrength * math.sin(phase) * 0.05
		joints.rootJoint.Transform = CFrame.new(0, breath, 0) * CFrame.Angles(sway, 0, tilt)
	end

	-- Bacaklar: capraz yuruyus. Topallayan bacagin genligi dusuk ve
	-- fazi kaymis - gozle &quot;aksiyor&quot; diye okunuyor.
	local amplitude = if walking then 0.55 else 0.0
	for index = 1, 4 do
		local joint = joints[&quot;leg&quot; .. index]
		if joint ~= nil then
			local offset = if index % 2 == 0 then math.pi else 0
			if index &gt; 2 then
				offset += math.pi
			end
			local legAmplitude = amplitude
			local extra = 0
			if index == entry.limpLeg then
				legAmplitude *= (1 - entry.limpStrength * 0.75)
				extra = entry.limpStrength * 0.22
			end
			local swing = math.sin(phase + offset) * legAmplitude + extra
			joint.Transform = CFrame.Angles(swing, 0, 0)
		end
	end

	-- Kafa: yururken hafif asagi/yukari, dururken merakli saga-sola.
	if joints.neck ~= nil then
		local nod = if walking then math.sin(phase * 2) * 0.08 else math.sin(phase * 0.55) * 0.05
		local turn = if walking then 0 else math.sin(phase * 0.32) * 0.22
		local droop = (if entry.state == &quot;distress&quot; then 0.2 else 0) + stress * 0.12
		joints.neck.Transform = CFrame.Angles(nod - droop, turn, 0)
	end

	-- Kuyruk: rahatken genis sallanir, stresliyken kisilir ve asagi duser.
	if joints.tail ~= nil then
		local wagAmplitude = (0.45 - stress * 0.35) * (if walking then 1.3 else 1)
		local wag = math.sin(phase * 2.4) * math.max(wagAmplitude, 0.05)
		joints.tail.Transform = CFrame.Angles(-stress * 0.5, wag, 0)
	end

	-- Kulaklar: stres arttikca geriye yatiyor, arada bir seyiriyor.
	for index = 1, 2 do
		local joint = joints[&quot;ear&quot; .. index]
		if joint ~= nil then
			local side = if index == 1 then -1 else 1
			local twitch = math.sin(phase * 3.1 + index) * 0.05
			joint.Transform = CFrame.Angles(-stress * 0.55, 0, side * (twitch + stress * 0.25))
		end
	end

	-- Kanatlar: yururken cirpinir, dururken govdeye yapisir.
	for index = 1, 2 do
		local joint = joints[&quot;wing&quot; .. index]
		if joint ~= nil then
			local side = if index == 1 then -1 else 1
			local flap = if walking then math.abs(math.sin(phase * 3)) * 0.6 else math.sin(phase) * 0.06
			joint.Transform = CFrame.Angles(0, 0, side * -flap)
		end
	end
end

--- Heartbeat dongusunu baslatir. init.server.luau bir kez cagirir.
function Animator.start()
	if running then
		return
	end
	running = true

	RunService.Heartbeat:Connect(function(dt: number)
		-- dt tavanlanıyor: Studio duraklatilip devam ettirildiginde tek
		-- karede 10 saniyelik dt gelebiliyor ve hayvanlar duvarlardan
		-- gecip gidiyor.
		local step = math.min(dt, 0.1)
		for model, entry in entries do
			if model.Parent == nil then
				entries[model] = nil
				continue
			end
			local speed = stepMovement(entry, step)
			stepPose(entry, step, speed)
		end
	end)
end

--- Kac rig canli? SelfTest ve tanilama icin.
function Animator.count(): number
	local total = 0
	for _ in entries do
		total += 1
	end
	return total
end

return Animator
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX34">
					<Properties>
						<string name="Name">AnimalFactory</string>
						<ProtectedString name="Source">--!strict
-- AnimalFactory.luau
-- ==================
-- Hasta hayvanlarin rigini kurar. Butun oranlar data/animals.json'dan
-- geliyor; yeni bir tur eklemek icin KOD DEGISTIRMEK GEREKMIYOR, veri
-- tablosuna bir satir yetiyor (rig alani bilinen bir iskelet adi olmak
-- kaydiyla: quadruped, bird, shelled).
--
-- Neden Humanoid yok?
-- -------------------
-- Humanoid saglik cubugu, isim etiketi ve kendi fizigini getiriyor;
-- hastanin sagligi bizim oyun kuralimiz, Humanoid'in degil. Bunun
-- yerine: capasi atilmis gorunmez bir Root parcasi, ustune Motor6D
-- zinciri. Hareket Root'un CFrame'i ile, animasyon eklem Transform'lari
-- ile yapiliyor (AnimalAnimator).
--
-- Motor6D pivot matematigi
-- ------------------------
-- Parcalar once son konumlarina kuruluyor, sonra eklem SU ANKI duruma
-- gore hesaplaniyor: C0 ve C1, ortak bir dunya pivotunun iki parcanin
-- yerel uzayindaki karsiligi. Boylece Transform = identity iken model
-- kuruldugu gibi duruyor, Transform dondurulunce parca PIVOT ETRAFINDA
-- donuyor (kendi merkezi etrafinda degil) - bacak kalcadan, kulak
-- kokunden.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Shared = ReplicatedStorage:WaitForChild(&quot;VetShared&quot;)
local Data = ReplicatedStorage:WaitForChild(&quot;VetData&quot;)

local Assets = require(Shared.Assets)
local Build = require(Shared.Build)
local Loc = require(Shared.Loc)

local animalData = require(Data.animals)

local AnimalFactory = {}

export type Rig = {
	model: Model,
	root: Part,
	parts: { [string]: BasePart },
	joints: { [string]: Motor6D },
	spec: any,
	nameplate: BillboardGui,
}

local byId: { [string]: any } = {}
for _, animal in animalData.animals do
	byId[animal.id] = animal
end

--- Tur tanimini getirir.
function AnimalFactory.spec(id: string): any?
	return byId[id]
end

--- Butun tur kimlikleri (SelfTest ve PatientFlow icin).
function AnimalFactory.allIds(): { string }
	local ids = {}
	for _, animal in animalData.animals do
		table.insert(ids, animal.id)
	end
	return ids
end

local KNOWN_RIGS = { quadruped = true, bird = true, shelled = true }

--- Iskelet adi taniniyor mu? verify_data.py ve SelfTest bunu soruyor.
function AnimalFactory.knownRig(rig: string): boolean
	return KNOWN_RIGS[rig] == true
end

local function rigJoint(name: string, part0: BasePart, part1: BasePart, pivot: Vector3): Motor6D
	local pivotCF = CFrame.new(pivot)
	local motor = Instance.new(&quot;Motor6D&quot;)
	motor.Name = name
	motor.Part0 = part0
	motor.Part1 = part1
	motor.C0 = part0.CFrame:ToObjectSpace(pivotCF)
	motor.C1 = part1.CFrame:ToObjectSpace(pivotCF)
	motor.Parent = part0
	return motor
end

local function rigidWeld(part0: BasePart, part1: BasePart)
	local weld = Instance.new(&quot;WeldConstraint&quot;)
	weld.Part0 = part0
	weld.Part1 = part1
	weld.Parent = part0
end

--- Hayvanin ustundeki isim + saglik/stres cubugu.
local function buildNameplate(root: BasePart, nameKey: string): BillboardGui
	local billboard = Instance.new(&quot;BillboardGui&quot;)
	billboard.Name = &quot;Etiket&quot;
	billboard.Size = UDim2.fromOffset(190, 62)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.6, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 90
	billboard.Parent = root

	local frame = Instance.new(&quot;Frame&quot;)
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(24, 28, 36)
	frame.BackgroundTransparency = 0.25
	frame.BorderSizePixel = 0
	frame.Parent = billboard
	local corner = Instance.new(&quot;UICorner&quot;)
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	local title = Instance.new(&quot;TextLabel&quot;)
	title.Name = &quot;Baslik&quot;
	title.Size = UDim2.new(1, -12, 0, 22)
	title.Position = UDim2.fromOffset(6, 4)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextSize = 15
	title.TextColor3 = Color3.fromRGB(242, 246, 250)
	title.Text = Loc.get(nameKey)
	title.Parent = frame

	local function bar(name: string, y: number, color: Color3): Frame
		local track = Instance.new(&quot;Frame&quot;)
		track.Name = name
		track.Size = UDim2.new(1, -12, 0, 10)
		track.Position = UDim2.fromOffset(6, y)
		track.BackgroundColor3 = Color3.fromRGB(52, 58, 70)
		track.BorderSizePixel = 0
		track.Parent = frame
		local trackCorner = Instance.new(&quot;UICorner&quot;)
		trackCorner.CornerRadius = UDim.new(0, 5)
		trackCorner.Parent = track

		local fill = Instance.new(&quot;Frame&quot;)
		fill.Name = &quot;Dolgu&quot;
		fill.Size = UDim2.fromScale(1, 1)
		fill.BackgroundColor3 = color
		fill.BorderSizePixel = 0
		fill.Parent = track
		local fillCorner = Instance.new(&quot;UICorner&quot;)
		fillCorner.CornerRadius = UDim.new(0, 5)
		fillCorner.Parent = fill
		return track
	end

	bar(&quot;Saglik&quot;, 28, Color3.fromRGB(96, 196, 120))
	bar(&quot;Stres&quot;, 42, Color3.fromRGB(226, 148, 76))

	return billboard
end

--- Kafa: kafatasi + burun + gozler + kulaklar.
local function buildHead(
	model: Model,
	torso: BasePart,
	spec: any,
	palette: { [string]: Color3 },
	joints: { [string]: Motor6D },
	parts: { [string]: BasePart }
): BasePart
	local head = spec.head
	local headPos = torso.Position + Vector3.new(0, head.offsetY, head.offsetZ)

	local skull = Build.part({
		name = &quot;Kafa&quot;,
		size = Vector3.new(head.size, head.size, head.size),
		cf = CFrame.new(headPos),
		color = palette.body,
		material = Enum.Material.SmoothPlastic,
		shape = Enum.PartType.Ball,
		canCollide = false,
		anchored = false,
		parent = model,
	})
	parts.head = skull

	-- Boyun/kafa eklemi torso ile kafa arasindaki orta noktada.
	joints.neck = rigJoint(&quot;Neck&quot;, torso, skull, headPos - Vector3.new(0, head.size * 0.35, head.size * 0.3))

	if head.snoutLength &gt; 0 then
		local snout = Build.part({
			name = &quot;Burun&quot;,
			size = Vector3.new(head.size * 0.55, head.snoutHeight, head.snoutLength),
			cf = CFrame.new(headPos + Vector3.new(0, -head.size * 0.14, head.size * 0.42 + head.snoutLength * 0.5)),
			color = palette.belly,
			canCollide = false,
			anchored = false,
			parent = model,
		})
		rigidWeld(skull, snout)
		parts.snout = snout

		local nose = Build.ball({
			name = &quot;BurunUcu&quot;,
			size = Vector3.new(head.snoutHeight * 0.55, head.snoutHeight * 0.55, head.snoutHeight * 0.55),
			cf = CFrame.new(headPos + Vector3.new(0, -head.size * 0.1, head.size * 0.42 + head.snoutLength)),
			color = palette.nose,
			canCollide = false,
			anchored = false,
			parent = model,
		})
		rigidWeld(skull, nose)
	end

	for _, side in { -1, 1 } do
		local eye = Build.ball({
			name = &quot;Goz&quot;,
			size = Vector3.new(head.size * 0.2, head.size * 0.2, head.size * 0.2),
			cf = CFrame.new(headPos + Vector3.new(side * head.size * 0.26, head.size * 0.14, head.size * 0.4)),
			color = palette.eye,
			material = Enum.Material.Glass,
			canCollide = false,
			anchored = false,
			parent = model,
		})
		rigidWeld(skull, eye)
	end

	local ears = spec.ears
	if ears.type ~= &quot;none&quot; and ears.length &gt; 0 then
		for index, side in { -1, 1 } do
			local rootPos = headPos + Vector3.new(side * head.size * 0.32, head.size * 0.4, -head.size * 0.05)
			local ear: BasePart
			if ears.type == &quot;pointy&quot; then
				ear = Build.wedge({
					name = &quot;Kulak&quot;,
					size = Vector3.new(ears.width, ears.length, ears.width * 0.5),
					cf = CFrame.new(rootPos + Vector3.new(0, ears.length * 0.5, 0)),
					color = palette.ear,
					canCollide = false,
					anchored = false,
					parent = model,
				})
			elseif ears.type == &quot;floppy&quot; then
				ear = Build.part({
					name = &quot;Kulak&quot;,
					size = Vector3.new(ears.width * 0.4, ears.length, ears.width),
					cf = CFrame.new(rootPos + Vector3.new(side * 0.1, -ears.length * 0.3, 0))
						* CFrame.Angles(0, 0, math.rad(side * -14)),
					color = palette.ear,
					canCollide = false,
					anchored = false,
					parent = model,
				})
			elseif ears.type == &quot;round&quot; then
				ear = Build.ball({
					name = &quot;Kulak&quot;,
					size = Vector3.new(ears.length, ears.length, ears.width * 0.4),
					cf = CFrame.new(rootPos),
					color = palette.ear,
					canCollide = false,
					anchored = false,
					parent = model,
				})
			else -- &quot;long&quot; (tavsan)
				ear = Build.part({
					name = &quot;Kulak&quot;,
					size = Vector3.new(ears.width, ears.length, ears.width * 0.55),
					cf = CFrame.new(rootPos + Vector3.new(0, ears.length * 0.5, 0))
						* CFrame.Angles(math.rad(-8), 0, math.rad(side * 7)),
					color = palette.ear,
					canCollide = false,
					anchored = false,
					parent = model,
				})
			end
			joints[&quot;ear&quot; .. index] = rigJoint(&quot;Ear&quot; .. index, skull, ear, rootPos)
			parts[&quot;ear&quot; .. index] = ear
		end
	end

	return skull
end

local function buildLegs(
	model: Model,
	torso: BasePart,
	spec: any,
	palette: { [string]: Color3 },
	joints: { [string]: Motor6D },
	parts: { [string]: BasePart }
)
	local legs = spec.legs
	if legs.count &lt;= 0 or legs.length &lt;= 0 then
		return
	end

	local zOffsets = if legs.count == 2 then { 0 } else { legs.spreadZ, -legs.spreadZ }
	local index = 0
	for _, z in zOffsets do
		for _, side in { -1, 1 } do
			index += 1
			local hip = torso.Position + Vector3.new(side * legs.spreadX, -spec.body.height * 0.4, z)
			local leg = Build.part({
				name = &quot;Bacak&quot; .. index,
				size = Vector3.new(legs.thickness, legs.length, legs.thickness),
				cf = CFrame.new(hip - Vector3.new(0, legs.length * 0.5, 0)),
				color = palette.accent,
				canCollide = false,
				anchored = false,
				parent = model,
			})
			-- Patiler: bacagin ucundaki kucuk kure, gozle fark ediliyor.
			local paw = Build.ball({
				name = &quot;Pati&quot; .. index,
				size = Vector3.new(legs.thickness * 1.25, legs.thickness * 0.9, legs.thickness * 1.35),
				cf = CFrame.new(hip - Vector3.new(0, legs.length - legs.thickness * 0.3, 0)),
				color = palette.belly,
				canCollide = false,
				anchored = false,
				parent = model,
			})
			rigidWeld(leg, paw)

			joints[&quot;leg&quot; .. index] = rigJoint(&quot;Leg&quot; .. index, torso, leg, hip)
			parts[&quot;leg&quot; .. index] = leg
		end
	end
end

local function buildTail(
	model: Model,
	torso: BasePart,
	spec: any,
	palette: { [string]: Color3 },
	joints: { [string]: Motor6D },
	parts: { [string]: BasePart }
)
	local tail = spec.tail
	if tail.type == &quot;none&quot; or tail.length &lt;= 0 then
		return
	end

	local rootPos = torso.Position + Vector3.new(0, spec.body.height * 0.25, -spec.body.length * 0.5)
	local part: BasePart

	if tail.type == &quot;puff&quot; then
		part = Build.ball({
			name = &quot;Kuyruk&quot;,
			size = Vector3.new(tail.thickness * 2, tail.thickness * 2, tail.thickness * 2),
			cf = CFrame.new(rootPos - Vector3.new(0, 0, tail.length)),
			color = palette.belly,
			canCollide = false,
			anchored = false,
			parent = model,
		})
	elseif tail.type == &quot;feather&quot; then
		part = Build.part({
			name = &quot;Kuyruk&quot;,
			size = Vector3.new(tail.thickness, 0.2, tail.length),
			cf = CFrame.new(rootPos - Vector3.new(0, tail.length * 0.25, tail.length * 0.5))
				* CFrame.Angles(math.rad(-20), 0, 0),
			color = palette.accent,
			canCollide = false,
			anchored = false,
			parent = model,
		})
	else -- &quot;wag&quot;
		part = Build.part({
			name = &quot;Kuyruk&quot;,
			size = Vector3.new(tail.thickness, tail.thickness, tail.length),
			cf = CFrame.new(rootPos - Vector3.new(0, -tail.length * 0.2, tail.length * 0.5))
				* CFrame.Angles(math.rad(22), 0, 0),
			color = palette.body,
			canCollide = false,
			anchored = false,
			parent = model,
		})
	end

	joints.tail = rigJoint(&quot;Tail&quot;, torso, part, rootPos)
	parts.tail = part
end

--- Tam rigi kurar. `cframe` hayvanin ayaklarinin basacagi yer.
function AnimalFactory.create(animalId: string, cframe: CFrame, parent: Instance): Rig?
	local spec = byId[animalId]
	if spec == nil then
		warn((&quot;[AnimalFactory] bilinmeyen tur: '%s'&quot;):format(animalId))
		return nil
	end
	if not AnimalFactory.knownRig(spec.rig) then
		warn((&quot;[AnimalFactory] '%s' bilinmeyen iskelet istiyor: '%s'&quot;):format(animalId, spec.rig))
		return nil
	end

	local palette = {}
	for key, value in spec.palette do
		palette[key] = Build.color(value)
	end

	local model = Build.model(animalId, parent)
	local parts: { [string]: BasePart } = {}
	local joints: { [string]: Motor6D } = {}

	local body = spec.body
	local groundClearance = spec.legs.length
	local torsoY = groundClearance + body.height * 0.5

	-- Model ONCE dunya merkezinde kuruluyor; hesaplar boylece duz kaliyor.
	-- Sonunda Root'un CFrame'i istenen yere tasiniyor ve zincir onu izliyor.
	local root = Build.part({
		name = &quot;Root&quot;,
		size = Vector3.new(body.width, 0.4, body.length),
		cf = CFrame.new(0, torsoY, 0),
		transparency = 1,
		canCollide = false,
		canQuery = false,
		castShadow = false,
		anchored = true,
		parent = model,
	})
	parts.root = root

	local torso = Build.part({
		name = &quot;Govde&quot;,
		size = Vector3.new(body.width, body.height, body.length),
		cf = CFrame.new(0, torsoY, 0),
		color = palette.body,
		canCollide = false,
		anchored = false,
		parent = model,
	})
	parts.torso = torso
	joints.rootJoint = rigJoint(&quot;RootJoint&quot;, root, torso, Vector3.new(0, torsoY, 0))

	-- Karin: govdenin altinda acik renk serit. Tek renkli bir kutu yerine
	-- iki tonlu govde hayvani gozle ayirt edilir kiliyor.
	local belly = Build.part({
		name = &quot;Karin&quot;,
		size = Vector3.new(body.width * 0.72, body.height * 0.45, body.length * 0.82),
		cf = CFrame.new(0, torsoY - body.height * 0.32, body.length * 0.04),
		color = palette.belly,
		canCollide = false,
		anchored = false,
		parent = model,
	})
	rigidWeld(torso, belly)

	buildHead(model, torso, spec, palette, joints, parts)
	buildLegs(model, torso, spec, palette, joints, parts)
	buildTail(model, torso, spec, palette, joints, parts)

	if spec.rig == &quot;bird&quot; and spec.wings ~= nil then
		for index, side in { -1, 1 } do
			local pivot = torso.Position + Vector3.new(side * body.width * 0.45, body.height * 0.15, 0)
			local wing = Build.part({
				name = &quot;Kanat&quot; .. index,
				size = Vector3.new(spec.wings.thickness, spec.wings.height, spec.wings.length),
				cf = CFrame.new(pivot + Vector3.new(side * 0.15, -spec.wings.height * 0.2, 0)),
				color = palette.accent,
				canCollide = false,
				anchored = false,
				parent = model,
			})
			joints[&quot;wing&quot; .. index] = rigJoint(&quot;Wing&quot; .. index, torso, wing, pivot)
			parts[&quot;wing&quot; .. index] = wing
		end
	end

	if spec.rig == &quot;shelled&quot; and spec.shell ~= nil then
		local shell = Build.ball({
			name = &quot;Kabuk&quot;,
			size = Vector3.new(
				body.width + spec.shell.overhang * 2,
				spec.shell.height * 2,
				body.length + spec.shell.overhang * 2
			),
			cf = CFrame.new(0, torsoY + body.height * 0.1, 0),
			color = palette.accent,
			material = Enum.Material.Slate,
			canCollide = false,
			anchored = false,
			parent = model,
		})
		rigidWeld(torso, shell)
		parts.shell = shell
	end

	local nameplate = buildNameplate(root, spec.nameKey)

	model.PrimaryPart = root
	root.CFrame = cframe * CFrame.new(0, torsoY, 0)

	-- Kullanici bir mesh ID yazdiysa prosedurel govdeyi gizleyip mesh'i
	-- koyuyoruz; tablo bos oldugunda (varsayilan) hicbir sey degismez.
	local meshId = Assets.mesh(animalId)
	if meshId ~= nil then
		local swap = Instance.new(&quot;MeshPart&quot;)
		swap.Name = &quot;CreatorStoreMesh&quot;
		swap.Anchored = false
		swap.CanCollide = false
		swap.CFrame = root.CFrame
		swap.Parent = model
		local ok = pcall(function()
			(swap :: any).MeshId = meshId
		end)
		if ok then
			rigidWeld(root, swap)
			for key, part in parts do
				if key ~= &quot;root&quot; then
					part.Transparency = 1
				end
			end
		else
			warn((&quot;[AnimalFactory] '%s' icin mesh yuklenemedi, prosedurel modele donuldu&quot;):format(animalId))
			swap:Destroy()
		end
	end

	return {
		model = model,
		root = root,
		parts = parts,
		joints = joints,
		spec = spec,
		nameplate = nameplate,
	}
end

return AnimalFactory
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX35">
					<Properties>
						<string name="Name">Clinic</string>
						<ProtectedString name="Source">--!strict
-- Clinic.luau
-- ===========
-- Klinik binasini kurar: zemin, duvarlar (kapi bosluklariyla), tavan,
-- cati, bahce ve yol. Butun olculer data/clinic.json'dan geliyor.
--
-- Kapi bosluklari
-- ---------------
-- Bir duvar tek bir kutu degil; kapilarin iki yanindaki parcalara ve
-- kapinin ustundeki kirise (lento) bolunuyor. Boylece plan dosyasina
-- kapi eklemek/tasimak icin kod degistirmek gerekmiyor.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Shared = ReplicatedStorage:WaitForChild(&quot;VetShared&quot;)
local Data = ReplicatedStorage:WaitForChild(&quot;VetData&quot;)

local Build = require(Shared.Build)
local Loc = require(Shared.Loc)
local Props = require(script.Parent.Props)

local plan = require(Data.clinic)

local Clinic = {}

export type Stations = { [string]: { cframe: CFrame, model: Model } }

export type Built = {
	model: Model,
	stations: Stations,
	queuePoints: { CFrame },
	restPoints: { CFrame },
	entranceOutside: Vector3,
	entranceInside: Vector3,
	roomOf: { [string]: { min: { number }, max: { number } } },
}

local EPSILON = 1e-3

local function colorOf(name: string): Color3
	return Build.color(plan.colors[name])
end

--- Malzeme adini Enum'a cevirir. Veri dosyasinda metin tutuluyor ki
--- plan dosyasi kod bilmeden duzenlenebilsin; bilinmeyen ad sessizce
--- yutulmaz, SmoothPlastic'e duser ve uyari basar.
local function materialOf(name: string?): Enum.Material
	if name == nil then
		return Enum.Material.SmoothPlastic
	end
	local material = (Enum.Material :: any)[name]
	if material == nil then
		warn((&quot;[Clinic] bilinmeyen malzeme '%s' - SmoothPlastic kullanildi&quot;):format(name))
		return Enum.Material.SmoothPlastic
	end
	return material
end

--- Tek bir duvar parcasi. `horizontal` ise eksen X, degilse Z.
local function wallSegment(
	parent: Instance,
	horizontal: boolean,
	fixed: number,
	axisFrom: number,
	axisTo: number,
	yFrom: number,
	yTo: number,
	color: Color3
)
	local length = axisTo - axisFrom
	if length &lt;= EPSILON then
		return
	end
	local height = yTo - yFrom
	if height &lt;= EPSILON then
		return
	end

	local center = (axisFrom + axisTo) * 0.5
	local y = (yFrom + yTo) * 0.5
	local thickness = plan.wallThickness

	local size, position
	if horizontal then
		size = Vector3.new(length, height, thickness)
		position = Vector3.new(center, y, fixed)
	else
		size = Vector3.new(thickness, height, length)
		position = Vector3.new(fixed, y, center)
	end

	Build.part({
		name = &quot;Duvar&quot;,
		size = size,
		cf = CFrame.new(position),
		color = color,
		material = Enum.Material.SmoothPlastic,
		parent = parent,
	})
end

--- Kapi cercevesi: iki dikme + ust kiris. Bos bir delik yerine cerceve
--- koymak binayi bitmis gosteriyor.
local function doorFrame(
	parent: Instance,
	horizontal: boolean,
	fixed: number,
	at: number,
	width: number,
	color: Color3
)
	local thickness = plan.wallThickness + 0.15
	local postWidth = 0.5
	local top = plan.doorHeight

	local function piece(axisCenter: number, axisSize: number, y: number, ySize: number)
		local size, position
		if horizontal then
			size = Vector3.new(axisSize, ySize, thickness)
			position = Vector3.new(axisCenter, y, fixed)
		else
			size = Vector3.new(thickness, ySize, axisSize)
			position = Vector3.new(fixed, y, axisCenter)
		end
		Build.part({
			name = &quot;KapiCercevesi&quot;,
			size = size,
			cf = CFrame.new(position),
			color = color,
			material = Enum.Material.SmoothPlastic,
			canCollide = false,
			parent = parent,
		})
	end

	piece(at - width * 0.5 - postWidth * 0.5, postWidth, top * 0.5, top)
	piece(at + width * 0.5 + postWidth * 0.5, postWidth, top * 0.5, top)
	piece(at, width + postWidth * 2, top + 0.25, 0.5)
end

local function buildWall(parent: Instance, wall: any, color: Color3, trim: Color3)
	local from, to = wall.from, wall.to
	local horizontal = math.abs(to[2] - from[2]) &lt; EPSILON

	local axisFrom, axisTo, fixed
	if horizontal then
		axisFrom = math.min(from[1], to[1])
		axisTo = math.max(from[1], to[1])
		fixed = from[2]
	else
		axisFrom = math.min(from[2], to[2])
		axisTo = math.max(from[2], to[2])
		fixed = from[1]
	end

	local doors = table.clone(wall.doors or {})
	table.sort(doors, function(a, b)
		return a.at &lt; b.at
	end)

	local cursor = axisFrom
	for _, door in doors do
		local left = door.at - door.width * 0.5
		local right = door.at + door.width * 0.5
		wallSegment(parent, horizontal, fixed, cursor, left, 0, plan.wallHeight, color)
		-- Kapinin ustundeki kiris
		wallSegment(parent, horizontal, fixed, left, right, plan.doorHeight, plan.wallHeight, color)
		doorFrame(parent, horizontal, fixed, door.at, door.width, trim)
		cursor = right
	end
	wallSegment(parent, horizontal, fixed, cursor, axisTo, 0, plan.wallHeight, color)

	-- Supurgelik: duvarin dibinde ince bir serit. Tek renkli duvarlari
	-- kirar, mekan daha bitmis gorunur.
	wallSegment(parent, horizontal, fixed, axisFrom, axisTo, 0, 0.6, trim)
end

--- Bahce, yol ve disarisi.
local function buildGrounds(parent: Instance)
	local half = plan.groundSize * 0.5
	Build.slab(
		{ -half, -half },
		{ half, half },
		plan.floorY - 0.5,
		1,
		colorOf(&quot;ground&quot;),
		Enum.Material.Grass,
		parent,
		&quot;Zemin&quot;
	)

	local path = plan.outdoor.path
	local halfWidth = path.width * 0.5
	local zMin = math.min(path.from[2], path.to[2])
	local zMax = math.max(path.from[2], path.to[2])
	Build.slab(
		{ path.from[1] - halfWidth, zMin },
		{ path.from[1] + halfWidth, zMax },
		plan.floorY + 0.02,
		0.3,
		colorOf(&quot;path&quot;),
		Enum.Material.Concrete,
		parent,
		&quot;Yol&quot;
	)
end

--- Duz cati + korkuluk. Bina disaridan bitmis gorunsun diye.
local function buildRoof(parent: Instance)
	local min, max = plan.bounds.min, plan.bounds.max
	local overhang = 1.5
	Build.slab(
		{ min[1] - overhang, min[2] - overhang },
		{ max[1] + overhang, max[2] + overhang },
		plan.wallHeight + 0.5,
		1,
		colorOf(&quot;roof&quot;),
		Enum.Material.Slate,
		parent,
		&quot;Cati&quot;
	)

	-- Korkuluk: catinin dort kenarinda alcak duvar.
	local parapet = 1.6
	local y = plan.wallHeight + 1 + parapet * 0.5
	local sides = {
		{ Vector3.new(max[1] - min[1] + overhang * 2, parapet, 0.8), Vector3.new((min[1] + max[1]) * 0.5, y, min[2] - overhang) },
		{ Vector3.new(max[1] - min[1] + overhang * 2, parapet, 0.8), Vector3.new((min[1] + max[1]) * 0.5, y, max[2] + overhang) },
		{ Vector3.new(0.8, parapet, max[2] - min[2] + overhang * 2), Vector3.new(min[1] - overhang, y, (min[2] + max[2]) * 0.5) },
		{ Vector3.new(0.8, parapet, max[2] - min[2] + overhang * 2), Vector3.new(max[1] + overhang, y, (min[2] + max[2]) * 0.5) },
	}
	for _, side in sides do
		Build.part({
			name = &quot;Korkuluk&quot;,
			size = side[1],
			cf = CFrame.new(side[2]),
			color = colorOf(&quot;wallTrim&quot;),
			material = Enum.Material.SmoothPlastic,
			parent = parent,
		})
	end
end

--- Oyuncunun dogacagi yer. Dunya kurulmadan kimse dogmuyor
--- (Players.CharacterAutoLoads yer dosyasinda false; init.server.luau
--- kurulum bitince true yapiyor).
local function buildSpawn(parent: Instance)
	local spawnPoint = Instance.new(&quot;SpawnLocation&quot;)
	spawnPoint.Name = &quot;VeterinerSpawn&quot;
	spawnPoint.Size = Vector3.new(12, 1, 12)
	spawnPoint.CFrame = CFrame.new(plan.spawn.at[1], plan.floorY + 0.5, plan.spawn.at[2])
	spawnPoint.Anchored = true
	spawnPoint.Color = Build.color(plan.colors.path)
	spawnPoint.Material = Enum.Material.Concrete
	spawnPoint.TopSurface = Enum.SurfaceType.Smooth
	spawnPoint.BottomSurface = Enum.SurfaceType.Smooth
	spawnPoint.Neutral = true
	spawnPoint.Duration = 0
	spawnPoint.Parent = parent
	return spawnPoint
end

--- Tam klinigi kurar ve oyun modullerinin ihtiyac duydugu noktalari doner.
function Clinic.build(parent: Instance): Built
	local root = Build.model(&quot;Klinik&quot;, parent)

	local structure = Build.model(&quot;Yapi&quot;, root)
	local furniture = Build.model(&quot;Esyalar&quot;, root)

	buildGrounds(structure)

	local wallColor = colorOf(&quot;wall&quot;)
	local trimColor = colorOf(&quot;wallTrim&quot;)

	local stations: Stations = {}
	local queuePoints: { CFrame } = {}
	local restPoints: { CFrame } = {}
	local roomOf = {}

	for _, room in plan.rooms do
		roomOf[room.id] = { min = room.min, max = room.max }

		Build.slab(
			room.min,
			room.max,
			plan.floorY - 0.25,
			0.5,
			Build.color(room.floorColor),
			materialOf(room.floorMaterial),
			structure,
			&quot;Doseme_&quot; .. room.id
		)

		if plan.ceiling then
			Build.slab(
				room.min,
				room.max,
				plan.wallHeight - 0.25,
				0.5,
				colorOf(&quot;ceiling&quot;),
				Enum.Material.SmoothPlastic,
				structure,
				&quot;Tavan_&quot; .. room.id
			)
		end

		for _, position in room.lights or {} do
			Build.ceilingLight(
				Vector3.new(position[1], plan.wallHeight - 0.8, position[2]),
				structure
			)
		end

		-- Oda adi tabelasi: odanin orta noktasinin ustunde asili.
		local centerX = (room.min[1] + room.max[1]) * 0.5
		local centerZ = (room.min[2] + room.max[2]) * 0.5
		local plate = Build.part({
			name = &quot;OdaTabelasi_&quot; .. room.id,
			size = Vector3.new(9, 1.8, 0.25),
			cf = CFrame.new(centerX, plan.wallHeight - 2.6, centerZ),
			color = trimColor,
			material = Enum.Material.SmoothPlastic,
			canCollide = false,
			parent = structure,
		})
		Build.surfaceText(plate, Enum.NormalId.Front, Loc.get(room.nameKey), Color3.fromRGB(48, 54, 64))
		Build.surfaceText(plate, Enum.NormalId.Back, Loc.get(room.nameKey), Color3.fromRGB(48, 54, 64))

		for _, point in room.queuePoints or {} do
			table.insert(queuePoints, CFrame.new(point[1], plan.floorY, point[2]))
		end
		for _, point in room.restPoints or {} do
			table.insert(restPoints, CFrame.new(point[1], plan.floorY, point[2]))
		end

		for _, spec in room.props do
			local origin = CFrame.new(spec.at[1], plan.floorY, spec.at[2])
				* CFrame.Angles(0, math.rad(spec.rot or 0), 0)
			local model = Props.build(spec.id, origin, furniture)
			if model ~= nil and spec.tag ~= nil then
				local stationId = string.match(spec.tag, &quot;^station:(.+)$&quot;)
				if stationId ~= nil then
					stations[stationId] = { cframe = origin, model = model }
				else
					model:AddTag(spec.tag)
				end
			end
		end
	end

	for _, wall in plan.walls do
		buildWall(structure, wall, wallColor, trimColor)
	end

	buildRoof(structure)

	for _, spec in plan.outdoor.props do
		local origin = CFrame.new(spec.at[1], plan.floorY, spec.at[2])
			* CFrame.Angles(0, math.rad(spec.rot or 0), 0)
		Props.build(spec.id, origin, furniture)
	end

	buildSpawn(root)

	return {
		model = root,
		stations = stations,
		queuePoints = queuePoints,
		restPoints = restPoints,
		entranceOutside = Vector3.new(plan.entrance.outside[1], plan.floorY, plan.entrance.outside[2]),
		entranceInside = Vector3.new(plan.entrance.inside[1], plan.floorY, plan.entrance.inside[2]),
		roomOf = roomOf,
	}
end

return Clinic
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX36">
					<Properties>
						<string name="Name">Lighting</string>
						<ProtectedString name="Source">--!strict
-- Lighting.luau
-- =============
-- Isiklandirma ve son-islem efektleri.
--
-- Lighting.Technology neden burada yok?
-- -------------------------------------
-- Technology betikten yazilamiyor (scriptable degil); yer dosyasinin
-- XML'inde ayarlaniyor (tools/rbxlx/tree.py). Orasi Studio olmadan
-- dogrulayamadigimiz TEK deger; yanlis cikarsa isiklandirma baska bir
-- moda duser ve oyun calismaya devam eder. README kullaniciya tek
-- tiklik duzeltmeyi (Lighting -&gt; Technology -&gt; Future) soyluyor.
--
-- Buradaki her sey calisma aninda kurulabilen seyler: renkler, saat,
-- atmosfer ve efektler.

local Lighting = game:GetService(&quot;Lighting&quot;)

local Sky = {}

--- Ayni efekti iki kez eklemeyi onler (Play'e ikinci kez basildiginda
--- Studio Lighting'i sifirlamayabiliyor).
local function replace(className: string, name: string): Instance
	local existing = Lighting:FindFirstChild(name)
	if existing ~= nil then
		existing:Destroy()
	end
	local instance = Instance.new(className)
	instance.Name = name
	instance.Parent = Lighting
	return instance
end

function Sky.apply()
	Lighting.Ambient = Color3.fromRGB(96, 100, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 136, 150)
	Lighting.Brightness = 2.4
	Lighting.ClockTime = 14.2
	Lighting.GeographicLatitude = 38
	Lighting.ExposureCompensation = 0.12
	Lighting.EnvironmentDiffuseScale = 0.45
	Lighting.EnvironmentSpecularScale = 0.35
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.35
	Lighting.FogEnd = 1400
	Lighting.FogStart = 320
	Lighting.FogColor = Color3.fromRGB(196, 212, 226)

	local atmosphere = replace(&quot;Atmosphere&quot;, &quot;Atmosfer&quot;) :: Atmosphere
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(202, 214, 228)
	atmosphere.Decay = Color3.fromRGB(122, 140, 162)
	atmosphere.Glare = 0.18
	atmosphere.Haze = 1.1

	local bloom = replace(&quot;BloomEffect&quot;, &quot;Parlama&quot;) :: BloomEffect
	bloom.Intensity = 0.55
	bloom.Size = 22
	bloom.Threshold = 1.05

	local color = replace(&quot;ColorCorrectionEffect&quot;, &quot;RenkDuzeltme&quot;) :: ColorCorrectionEffect
	color.Brightness = 0.015
	color.Contrast = 0.09
	color.Saturation = 0.1
	color.TintColor = Color3.fromRGB(255, 252, 248)

	local sun = replace(&quot;SunRaysEffect&quot;, &quot;GunesIsinlari&quot;) :: SunRaysEffect
	sun.Intensity = 0.06
	sun.Spread = 0.55

	-- Alan derinligi bilincli olarak ZAYIF: klinikte oyuncu surekli
	-- yakin nesnelere bakiyor, guclu bir bulaniklik arayuzu okunmaz
	-- hale getirirdi.
	local depth = replace(&quot;DepthOfFieldEffect&quot;, &quot;AlanDerinligi&quot;) :: DepthOfFieldEffect
	depth.FarIntensity = 0.08
	depth.NearIntensity = 0
	depth.FocusDistance = 26
	depth.InFocusRadius = 42

	local sky = replace(&quot;Sky&quot;, &quot;Gokyuzu&quot;) :: Sky
	sky.StarCount = 0
	sky.SunAngularSize = 16
end

return Sky
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX37">
					<Properties>
						<string name="Name">Props</string>
						<ProtectedString name="Source">--!strict
-- Props.luau
-- ==========
-- Klinik esyalarinin kod ile uretimi. Her esya temel parcalardan
-- (Part / WedgePart / silindir / kure) kuruluyor; hicbir dis asset'e
-- bagimli degil, bu yuzden oyun ilk acilista eksiksiz gorunuyor.
--
-- Renkler neden burada, olculer neden veride?
-- -------------------------------------------
-- Oyunun DENGESINI etkileyen her sey veride (data/*.json): oda planı,
-- esyanin nerede duracagi, ucretler, sureler. Saf dekorasyon rengi
-- oynanisi degistirmiyor; onu veriye tasimak 26 esya x 5 renk = 130
-- satirlik bir tabloya mal olur ve kimse duzenlemez. Sinir burada
-- cizildi.
--
-- AssetIds kacamagi
-- -----------------
-- Kullanici data/assetIds.json'a bir mesh ID'si yazarsa Assets.mesh()
-- onu dondurur ve prosedurel govdenin yerine o mesh kullanilir. Tablo
-- bos oldugunda (varsayilan) hicbir sey degismez.

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Shared = ReplicatedStorage:WaitForChild(&quot;VetShared&quot;)

local Assets = require(Shared.Assets)
local Build = require(Shared.Build)
local Loc = require(Shared.Loc)

local Props = {}

local C = {
	steel = Color3.fromRGB(186, 192, 198),
	darkSteel = Color3.fromRGB(126, 132, 140),
	white = Color3.fromRGB(244, 247, 250),
	offWhite = Color3.fromRGB(226, 230, 234),
	wood = Color3.fromRGB(176, 132, 86),
	darkWood = Color3.fromRGB(126, 92, 58),
	teal = Color3.fromRGB(72, 166, 168),
	deepTeal = Color3.fromRGB(44, 120, 126),
	navy = Color3.fromRGB(48, 62, 84),
	screen = Color3.fromRGB(142, 218, 236),
	pad = Color3.fromRGB(96, 148, 186),
	leaf = Color3.fromRGB(84, 148, 76),
	darkLeaf = Color3.fromRGB(60, 116, 56),
	bark = Color3.fromRGB(104, 78, 54),
	soil = Color3.fromRGB(96, 74, 58),
	glass = Color3.fromRGB(200, 226, 236),
	accent = Color3.fromRGB(232, 106, 96),
	water = Color3.fromRGB(120, 186, 222),
	towel = Color3.fromRGB(238, 226, 206),
	black = Color3.fromRGB(42, 46, 52),
}

type Builder = (model: Model, origin: CFrame) -&gt; ()

-- Her builder'in icinde tekrar eden kalibi kisaltan yardimci uretir.
local function maker(model: Model, origin: CFrame)
	return function(
		name: string,
		size: Vector3,
		offset: Vector3,
		color: Color3,
		material: Enum.Material?,
		rotation: CFrame?
	): Part
		local cf = origin * CFrame.new(offset)
		if rotation ~= nil then
			cf = cf * rotation
		end
		return Build.part({
			name = name,
			size = size,
			cf = cf,
			color = color,
			material = material or Enum.Material.SmoothPlastic,
			parent = model,
		})
	end
end

local builders: { [string]: Builder } = {}

-- ── Resepsiyon ve bekleme ─────────────────────────────────────────────

builders.receptionDesk = function(model, origin)
	local p = maker(model, origin)
	p(&quot;Govde&quot;, Vector3.new(10, 3.2, 2.4), Vector3.new(0, 1.6, 0), C.wood, Enum.Material.Wood)
	p(&quot;Tezgah&quot;, Vector3.new(11, 0.4, 3.4), Vector3.new(0, 3.4, 0.3), C.offWhite)
	p(&quot;On&quot;, Vector3.new(11, 1.2, 0.3), Vector3.new(0, 2.9, -1.35), C.teal)
	p(&quot;Monitor&quot;, Vector3.new(2.6, 1.6, 0.15), Vector3.new(-3, 4.5, 0.6), C.black,
		nil, CFrame.Angles(math.rad(-12), 0, 0))
	p(&quot;Ekran&quot;, Vector3.new(2.3, 1.3, 0.08), Vector3.new(-3, 4.5, 0.68), C.screen,
		Enum.Material.Neon, CFrame.Angles(math.rad(-12), 0, 0))
	p(&quot;Kagitlar&quot;, Vector3.new(1.6, 0.1, 1.1), Vector3.new(2.4, 3.65, 0.4), C.white)
end

builders.waitingBench = function(model, origin)
	local p = maker(model, origin)
	p(&quot;Oturak&quot;, Vector3.new(7, 0.4, 2.2), Vector3.new(0, 1.7, 0), C.teal)
	p(&quot;Sirtlik&quot;, Vector3.new(7, 2, 0.35), Vector3.new(0, 2.8, -1), C.deepTeal)
	p(&quot;Ayak&quot;, Vector3.new(0.35, 1.7, 1.8), Vector3.new(-3, 0.85, 0), C.darkSteel, Enum.Material.Metal)
	p(&quot;Ayak&quot;, Vector3.new(0.35, 1.7, 1.8), Vector3.new(3, 0.85, 0), C.darkSteel, Enum.Material.Metal)
end

builders.outdoorBench = function(model, origin)
	local p = maker(model, origin)
	p(&quot;Oturak&quot;, Vector3.new(6, 0.35, 2), Vector3.new(0, 1.6, 0), C.wood, Enum.Material.WoodPlanks)
	p(&quot;Sirtlik&quot;, Vector3.new(6, 1.6, 0.3), Vector3.new(0, 2.5, -0.9), C.wood, Enum.Material.WoodPlanks)
	p(&quot;Ayak&quot;, Vector3.new(0.4, 1.6, 1.8), Vector3.new(-2.5, 0.8, 0), C.darkWood, Enum.Material.Wood)
	p(&quot;Ayak&quot;, Vector3.new(0.4, 1.6, 1.8), Vector3.new(2.5, 0.8, 0), C.darkWood, Enum.Material.Wood)
end

builders.waterCooler = function(model, origin)
	local p = maker(model, origin)
	p(&quot;Govde&quot;, Vector3.new(1.6, 3.4, 1.6), Vector3.new(0, 1.7, 0), C.white)
	p(&quot;Musluk&quot;, Vector3.new(0.4, 0.5, 0.5), Vector3.new(0, 2.6, 0.9), C.darkSteel, Enum.Material.Metal)
	Build.pillar({
		name = &quot;Damacana&quot;,
		size = Vector3.new(1.5, 2.2, 1.5),
		cf = origin * CFrame.new(0, 4.5, 0),
		color = C.water,
		material = Enum.Material.Glass,
		transparency = 0.35,
		parent = model,
	})
end

builders.trashBin = function(model, origin)
	Build.pillar({
		name = &quot;Kova&quot;,
		size = Vector3.new(1.5, 2.2, 1.5),
		cf = origin * CFrame.new(0, 1.1, 0),
		color = C.darkSteel,
		material = Enum.Material.Metal,
		parent = model,
	})
	Build.pillar({
		name = &quot;Kapak&quot;,
		size = Vector3.new(1.65, 0.25, 1.65),
		cf = origin * CFrame.new(0, 2.3, 0),
		color = C.steel,
		material = Enum.Material.Metal,
		parent = model,
	})
end

builders.poster = function(model, origin)
	local p = maker(model, origin)
	local board = p(&quot;Afis&quot;, Vector3.new(5, 3.4, 0.15), Vector3.new(0, 7, 0), C.white)
	p(&quot;Cerceve&quot;, Vector3.new(5.3, 3.7, 0.1), Vector3.new(0, 7, -0.08), C.teal)
	Build.surfaceText(board, Enum.NormalId.Front, Loc.get(&quot;prop.poster&quot;), C.navy)
end

-- ── Eczane ve depolama ────────────────────────────────────────────────

builders.medicineShelf = function(model, origin)
	local p = maker(model, origin)
	p(&quot;Kasa&quot;, Vector3.new(6.5, 8, 1.6), Vector3.new(0, 4, 0), C.offWhite)
	local bottleColors = { C.accent, C.teal, C.water, C.leaf, C.navy }
	for shelf = 1, 4 do
		local y = 1.2 + (shelf - 1) * 1.9
		p(&quot;Raf&quot;, Vector3.new(6.2, 0.2, 1.5), Vector3.new(0, y, 0.05), C.white)
		for slot = 1, 6 do
			local x = -2.6 + (slot - 1) * 1.05
			Build.pillar({
				name = &quot;Sise&quot;,
				size = Vector3.new(0.55, 1.1, 0.55),
				cf = origin * CFrame.new(x, y + 0.65, 0.1),
				color = bottleColors[((shelf + slot) % #bottleColors) + 1],
				material = Enum.Material.Glass,
				transparency = 0.2,
				canCollide = false,
				parent = model,
			})
		end
	end
end

builders.cabinet = function(model, origin)
	local p = maker(model, origin)
	p(&quot;Govde&quot;, Vector3.new(4.5, 6, 1.8), Vector3.new(0, 3, 0), C.white)
	p(&quot;KapakSol&quot;, Vector3.new(2.1, 5.4, 0.15), Vector3.new(-1.1, 3, 0.95), C.offWhite)
	p(&quot;KapakSag&quot;, Vector3.new(2.1, 5.4, 0.15), Vector3.new(1.1, 3, 0.95), C.offWhite)
	p(&quot;Kol&quot;, Vector3.new(0.15, 1, 0.15), Vector3.new(-0.2, 3, 1.05), C.darkSteel, Enum.Material.Metal)
	p(&quot;Kol&quot;, Vector3.new(0.15, 1, 0.15), Vector3.new(0.2, 3, 1.05), C.darkSteel, Enum.Material.Metal)
	p(&quot;Serit&quot;, Vector3.new(4.5, 0.25, 1.85), Vector3.new(0, 5.9, 0), C.teal)
end

builders.towelShelf = function(model, origin)
	local p = maker(model, origin)
	p(&quot;Kasa&quot;, Vector3.new(4, 5, 1.4), Vector3.new(0, 2.5, 0), C.offWhite)
	for shelf = 1, 3 do
		local y = 1 + (shelf - 1) * 1.6
		p(&quot;Raf&quot;, Vector3.new(3.8, 0.16, 1.3), Vector3.new(0, y, 0), C.white)
		p(&quot;Havlu&quot;, Vector3.new(1.5, 0.7, 1.1), Vector3.new(-0.9, y + 0.45, 0), C.towel, Enum.Material.Fabric)
		p(&quot;Havlu&quot;, Vector3.new(1.5, 0.7, 1.1), Vector3.new(0.9, y + 0.45, 0), C.glass, Enum.Material.Fabric)
	end
end

builders.dryerRack = function(model, origin)
	local p = maker(model, origin)
	p(&quot;Dikme&quot;, Vector3.new(0.3, 5, 0.3), Vector3.new(-2.5, 2.5, 0), C.darkSteel, Enum.Material.Metal)
	p(&quot;Dikme&quot;, Vector3.new(0.3, 5, 0.3), Vector3.new(2.5, 2.5, 0), C.darkSteel, Enum.Material.Metal)
	p(&quot;Ray&quot;, Vector3.new(5.3, 0.22, 0.22), Vector3.new(0, 4.8, 0), C.steel, Enum.Material.Metal)
	p(&quot;Ray&quot;, Vector3.new(5.3, 0.22, 0.22), Vector3.new(0, 3.4, 0), C.steel, Enum.Material.Metal)
	p(&quot;AsiliHavlu&quot;, Vector3.new(1.6, 2.2, 0.12), Vector3.new(-1.2, 3.7, 0), C.towel, Enum.Material.Fabric)
	p(&quot;AsiliHavlu&quot;, Vector3.new(1.6, 2.6, 0.12), Vector3.new(1.2, 3.5, 0), C.water, Enum.Material.Fabric)
end

-- ── Muayene ───────────────────────────────────────────────────────────

builders.examTable = function(model, origin)
	local p = maker(model, origin)
	p(&quot;Ayak&quot;, Vector3.new(1.4, 2.6, 1.4), Vector3.new(0, 1.3, 0), C.darkSteel, Enum.Material.Metal)
	p(&quot;Taban&quot;, Vector3.new(3.4, 0.35, 2.6), Vector3.new(0, 0.18, 0), C.darkSteel, Enum.Material.Metal)
	p(&quot;Tabla&quot;, Vector3.new(7.5, 0.5, 4.2), Vector3.new(0, 2.85, 0), C.steel, Enum.Material.Metal)
	p(&quot;Minder&quot;, Vector3.new(7.2, 0.5, 4), Vector3.new(0, 3.3, 0), C.pad, Enum.Material.Fabric)
	p(&quot;Kenarlik&quot;, Vector3.new(7.5, 0.3, 0.25), Vector3.new(0, 3.6, 2.1), C.steel, Enum.Material.Metal)
	p(&quot;Kenarlik&quot;, Vector3.new(7.5, 0.3, 0.25), Vector3.new(0, 3.6, -2.1), C.steel, Enum.Material.Metal)
	p(&quot;Tepsi&quot;, Vector3.new(2.4, 0.2, 1.6), Vector3.new(4.8, 3, 0), C.steel, Enum.Material.Metal)
