{
  "name": "starfall-isle",
  "productName": "Starfall Isle",
  "version": "0.1.0",
  "description": "Yildiz Adasi - rahat bir 3D ada macerasi",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Starfall Isle",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "electron": "electron .",
    "electron:dev": "vite build && electron .",
    "verify": "node tools/verify.mjs",
    "playtest": "vite build && node tools/playtest.mjs",
    "capture": "vite build && node tools/capture.mjs",
    "icons": "node tools/gen-icons.mjs",
    "store-art": "vite build && node tools/store-art.mjs",
    "smoke": "vite build && node tools/electron-smoke.mjs",
    "dist:win": "vite build && electron-builder --win --x64",
    "dist:linux": "vite build && electron-builder --linux --x64",
    "test": "npm run verify && npm run playtest && npm run smoke"
  },
  "build": {
    "appId": "com.starfallisle.game",
    "productName": "Starfall Isle",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "steam/steam_appid.txt",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "publish": null
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "steamworks.js": "^0.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "playwright": "^1.56.1",
    "vite": "^8.3.2"
  }
}
