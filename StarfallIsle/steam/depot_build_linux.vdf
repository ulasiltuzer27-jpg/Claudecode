// Linux / Steam Deck (yerel) deposu: `npm run dist:linux` ciktisi.
// Steam Deck, Windows deposunu Proton ile de calistirabilir; bu depo
// istege bagli.
"DepotBuild"
{
	"DepotID"	"482"
	"ContentRoot"	"../release/linux-unpacked/"
	"FileMapping"
	{
		"LocalPath"	"*"
		"DepotPath"	"."
		"Recursive"	"1"
	}
}
