// SteamPipe uygulama derlemesi. Kullanim (Steamworks SDK'daki steamcmd ile):
//   steamcmd +login <kullanici> +run_app_build "<tam yol>/steam/app_build.vdf" +quit
// 480/481 Valve'in test uygulamasidir; KENDI App ID ve Depot ID'nizi yazin.
"AppBuild"
{
	"AppID"		"480"
	"Desc"		"Starfall Isle"
	"BuildOutput"	"../release/steam-output/"
	"ContentRoot"	"../release/"
	"SetLive"	""
	"Depots"
	{
		"481"	"depot_build_win.vdf"
		"482"	"depot_build_linux.vdf"
	}
}
